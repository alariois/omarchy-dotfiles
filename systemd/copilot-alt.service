# The Copilot key as an Alt. bin/copilot-alt explains why this takes a process
# at all: the key emits a held LEFTMETA+LEFTSHIFT+F23 chord rather than a
# keycode, and xkb -- where every other remapping in this repo lives -- cannot
# cancel two real modifiers.
#
# A system service, installed with the script it runs as root-owned copies by
# the SYSTEM lane of setup/targets.sh. It was a user service, which could open
# the keyboard only because the user was in the `input` group -- and that same
# membership lets anything the user runs read every key typed. Omarchy's
# migration 1787865477 took users out of the group for exactly that reason, and
# from then on the user service failed to start, every five seconds, 165,000
# times before anyone looked.
#
# Root, then, because root owns both device nodes it needs. But root with
# nothing else: no capabilities, no network, a read-only filesystem, and only
# two kinds of device -- input devices to read, /dev/uinput to write.
#
# No [Install] section, and nothing to enable. udev starts it, through
# udev/70-copilot-alt.rules, when the internal keyboard appears: at every
# boot, and whenever the kernel re-creates the device. A machine without that
# keyboard never starts it at all.

[Unit]
Description=Copilot key as Alt (evdev chord remap)

# A VM has no Copilot key, whatever its emulated PS/2 keyboard advertises. A
# condition that does not hold is a quiet skip, not a failure.
ConditionVirtualization=no

# A crash is restarted, but five within five minutes leave it down and failed,
# where doctor.sh and `systemctl --failed` show it, instead of looping.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
# Ready once the keyboard is grabbed and its clone exists. So a `systemctl
# restart` that returns has left a working key, and one that cannot get that
# far fails where it can be seen.
Type=notify
ExecStart=/usr/local/bin/copilot-alt

# A hung remapper is worse than a dead one: it keeps the grab, so the keyboard
# types nothing at all. It pings every five seconds; ten without one and
# systemd kills it, which gives the keyboard back. With SIGKILL, not systemd's
# SIGABRT: that one is for the core dump, which LimitCORE below rules out, and
# a stopped process sits on it for TimeoutAbortSec -- 90 seconds without a
# keyboard -- where SIGKILL ends it at once.
WatchdogSec=10
WatchdogSignal=SIGKILL

# 0 is "nothing to do" and 78 is "cannot work as set up" -- the script's
# docstring has both, and neither is worth a restart. Anything else is a crash.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=78

# A core dump of this process would be a file of recent keystrokes. A crash is
# still logged, with its stack, just not written to disk.
LimitCORE=0

# Root with nothing. Owning the two device nodes is all root is for here --
# uid 0 opens a 0660 root-owned node by its owner bits, without any capability
# -- and DevicePolicy keeps every other device closed to it.
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
# AF_UNIX for systemd's notify socket, which READY=1 and the watchdog go to.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
