# Build artifacts and editor scratch
*.bak
*.bak.*
*.swp

# Compiled by setup/install.sh from hypr-nav/hypr-nav.c. The binary is a build
# artifact, not config -- the repo tracks the source and the installed copy
# lives at ~/.local/bin/hypr-nav.
hypr-nav/hypr-nav
hypr-nav/test_hypr_nav

# Claude Code's per-checkout scratch: agent worktrees and session state. Local
# to this machine and never part of the config.
.claude/

# Secrets never belong in this repo
*.key
*.pem
*.secret

# This machine's accounts and their secrets: encrypted, but still never
# committed. env.example.yaml is the tracked twin; git-hooks/pre-commit
# refuses a commit that stages this file anyway.
/env.yaml
# env_update's encrypted copy, between writing it and moving it into place.
/env.yaml.*
