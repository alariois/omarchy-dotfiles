#!/usr/bin/env bash
#
# bw-vault -- the Bitwarden vault behind `bwu get`, `put`, `add` and `update`:
# an encrypted cache of it, and an fzf picker over that cache.
#
#   bwu get                # pick; print the username and password
#   bwu get github         # the same, the search started with "github"
#   bwu get -u | -p        # the username alone, or the password alone
#   bwu get -c             # copy instead of print: the password, or with -u
#                          # the username -- the username is printed alongside
#   bwu get -f [name [new]]  # an item's attached file, saved -- see --help
#   bwu put -f file [name] # an item's attached file, replaced by this one
#   bwu add -f file...     # files attached to an item
#   bwu update             # sync with the server, and cache the vault anew
#   bwu --update get       # the same, then pick
#
# Run through bwu, the shell function in shell/bashrc, which unlocks the vault
# first and hands this the session key and the cache key for its run alone;
# not by hand.
#
# The cache holds every item, secrets included, encrypted with age to a key
# made new with every unlock (bin/bw-session). The key is kept as the session
# key is: in root's store, and unexported in the terminals unlocked with it.
# So a cache from an earlier unlock cannot be read, and `bw lock` deletes it.
# `bwu get` reads the cache and never runs bw; only when there is none it can
# read does it sync with the server and write one. Changes made elsewhere --
# the browser, the phone -- show up after `bwu update`.
#
# The list shows every item: a login with its username and website, anything
# else by its name. The search covers the name, username and website, so a
# note is found by its title, and its text is never searched.
#
# What an item yields: a login its username and password; a note its text; a
# card its number, expiry and code (-p: the number); an SSH key its private
# key. -u is a login's username, or a card's holder.
#
# A copy goes to the clipboard marked sensitive, which clipboard managers
# that honour the hint keep out of their history, and is cleared after 45
# seconds unless something else has been copied over it.
#
# -f is for attached files. The cache knows which items have files and what
# they are called, so the picking is as quick as ever; the file itself comes
# from the server, decrypted by bw. It is written readable by you alone --
# attachments tend to be keys -- and over a file that is there only with
# --force. Several files can be picked at once; they are saved all, or none.
#
# put and add write files the other way. Bitwarden cannot change a file in
# place, only add one and delete one, so a file is replaced by uploading the
# new one first and deleting the old one after: a failure in between leaves
# both, never neither. put replaces one file, which keeps its name in the
# vault -- the one of the same name is taken at once, any other is picked,
# never guessed, since it is the one deleted. add attaches files, and asks
# before it overwrites one the item has by that name already. Both write
# against the item as the server has it, after a sync, not as the cache
# remembers it, and cache the vault anew after.

set -euo pipefail

# What `bwu --help` shows -- for using bwu, where the comment above is for
# reading this file. Headings in bold on a terminal.
usage() {
  local b="" r=""
  [[ -t 1 ]] && b=$'\e[1m' r=$'\e[0m'
  cat <<EOF
${b}bwu${r} -- Bitwarden in the terminal: unlock once, then find, copy and store secrets.

${b}Usage${r}
  bwu                       unlock the vault in this terminal
  bwu get [options] [text]  pick an item with fzf, print its secret
  bwu put [text] -f file [name]
                            replace one of an item's files with file
  bwu add [text] -f file... attach files to an item
  bwu update                sync with the server, cache the vault anew
  bwu --update get ...      the same, then pick
  bwu lock                  lock the vault everywhere, delete the cache
  bwu --help                this

${b}Options for get${r}
  -u, --username   the username alone
  -p, --password   the password alone (a note's text, a card's number)
  -c, --copy       copy instead of print, cleared after ${CLEAR_AFTER} s; with
                   neither -u nor -p, prints the username, copies the password
      --update     sync and cache the vault anew first
  text             start the search with it; one match is picked at once
  Short options combine: -cp, -cu.

${b}Attached files${r}
  -f, --file [name [new-name]]
                   an attached file instead: only items with files are listed,
                   then the item's files, if it has more than one. name narrows
                   both to files matching it; one match is taken at once. The
                   file is saved under its own name here, or as new-name -- a
                   directory, or - for stdout. Tab marks several files, ctrl-a
                   all; several go here, or into the directory given.
                   Everything after -f is its own: options go before it, and
                   -- before a name that starts with -.
      --force      let a saved file replace one that is there; without it,
                   nothing is saved when any of the files is there already

${b}Putting files in the vault${r}
  put [text] -f file [name]
                   only items with files are listed; file replaces the item's
                   file of its own name, or of name, at once -- any other is
                   picked. It keeps the old file's name in the vault, and the
                   old one is deleted only once the new one is up.
  add [text] -f file...
                   any item is listed, and the files are attached to it. A
                   file the item has by that name already: asked whether to
                   overwrite it, and left out if not.
      --force      with add: overwrite without asking
      --update     sync and cache the vault anew before the list
  Everything after -f is its own, as for get.

${b}Examples${r}
  bwu get github            username and password for GitHub
  bwu get -cp aws           copy the AWS password
  bwu get -u gitlab         just the GitLab username
  bwu get "home wifi"       a note's text
  bwu get -f                pick an item, then one of its files
  bwu get github -f key ~/.ssh/github
                            GitHub's file matching "key", saved as ~/.ssh/github
  bwu get -f cert - | openssl x509 -noout -dates
  bwu get --force -f "" ~/.ssh/
                            pick files with Tab, replace them in ~/.ssh
  bwu put superspot -f envs/prod/env.yaml
                            Superspot's env.yaml, replaced by this one
  bwu put superspot -f prod.yaml env.yaml
                            the same, from a file of another name
  bwu add github -f ~/.ssh/github ~/.ssh/github.pub
                            both attached to GitHub

${b}How it works${r}
  The first bwu asks for your master password; each terminal after that
  needs only your fingerprint, or your password, for sudo. bwu get picks
  from an encrypted cache of the vault, so the list opens at once -- changes
  made elsewhere, in the browser or on the phone, arrive with bwu update.
  The search covers names, usernames and websites; a note is found by its
  title alone. bw lock, or bwu lock, locks the vault for every terminal.
  First time on a machine: bw login.
EOF
  exit "${1:-0}"
}
die() { echo "bwu: $*" >&2; exit 1; }

# BW_CLEAR_AFTER is for tests.
CLEAR_AFTER=${BW_CLEAR_AFTER:-45}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-dotfiles/bw-vault.age

sub=${1-}
(( $# )) && shift
case $sub in
  get|put|add|update|forget) ;;
  -h|--help|"")              usage 0 ;;
  *)                         die "unknown command: $sub  (try --help)" ;;
esac

if [[ $sub == forget ]]; then
  rm -f -- "$CACHE"
  exit 0
fi

want=both copy=false query="" update=false
file_mode=false file_name="" file_out="" force=false paths=()
while (( $# )); do
  case $1 in
    -f|--file)
      # Everything after -f is its own: [--] and then, for get, [name
      # [new-name]]; for put, file [name]; for add, file...
      file_mode=true
      shift
      ended=false
      rest=()
      while (( $# )); do
        if ! $ended && [[ $1 == -- ]]; then
          ended=true
          shift
          continue
        fi
        if ! $ended && [[ $1 == -?* ]]; then
          [[ $sub != get ]] ||
            die "after -f come only a file's name and a new name -- options go before -f, and -- before a name that starts with -"
          die "after -f come only files -- options go before -f, and -- before a file whose name starts with -"
        fi
        rest+=("$1")
        shift
      done
      case $sub in
        get)
          (( ${#rest[@]} <= 2 )) || die "-f takes a file's name and a new name, and nothing more"
          file_name=${rest[0]-}
          file_out=${rest[1]-} ;;
        put)
          (( ${#rest[@]} >= 1 )) || die "-f takes the file to put in the vault"
          (( ${#rest[@]} <= 2 )) || die "-f takes a file and the name of the one it replaces, and nothing more -- bwu add takes several"
          paths=("${rest[0]}")
          file_name=${rest[1]-} ;;
        add)
          (( ${#rest[@]} >= 1 )) || die "-f takes the files to attach"
          paths=("${rest[@]}") ;;
        *)
          die "bwu $sub takes no options" ;;
      esac ;;
    -u|--username) want=user; shift ;;
    -p|--password) want=secret; shift ;;
    -c|--copy)     copy=true; shift ;;
    --update)      update=true; shift ;;
    --force)       force=true; shift ;;
    -[upc][upc]*)
      # -cp and the like: short options together.
      for (( i = 1; i < ${#1}; i++ )); do
        case ${1:i:1} in
          u) want=user ;;
          p) want=secret ;;
          c) copy=true ;;
        esac
      done
      shift ;;
    -h|--help)     usage 0 ;;
    -*)            die "unknown option: $1  (try --help)" ;;
    *)             query+="${query:+ }$1"; shift ;;
  esac
done
[[ $sub != update || ( $want == both && $copy == false && -z $query && $file_mode == false && $force == false ) ]] ||
  die "bwu update takes no options"
if [[ $sub == put || $sub == add ]]; then
  $file_mode || die "bwu $sub takes files: bwu $sub [text] -f file  (try --help)"
  [[ $want == both && $copy == false ]] || die "-u, -p and -c are for get -- bwu $sub puts files in the vault"
  [[ $sub == add ]] || ! $force ||
    die "--force is for add and for get -f -- bwu put replaces the file without it"

  # The files, checked before anything is picked.
  for path in "${paths[@]}"; do
    [[ -f $path ]] || die "$path is not a file"
    [[ -r $path ]] || die "$path cannot be read"
  done
  dup=$(for path in "${paths[@]}"; do printf '%s\n' "${path##*/}"; done | sort | uniq -d | head -n 1)
  [[ -z $dup ]] || die "two of the files are called $dup -- the item would hold two files of one name"
fi
! $file_mode || [[ $want == both && $copy == false ]] ||
  die "-f cannot go with -u, -p or -c: a file is saved, not printed or copied"
! $force || $file_mode || die "--force goes with -f: it lets a saved file replace one that is there"

for tool in bw jq age age-keygen; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done
[[ $sub == update ]] || command -v fzf >/dev/null || die "fzf is not installed"
! $copy || command -v wl-copy >/dev/null || die "wl-copy is not installed, so -c cannot copy"
[[ -n ${BW_SESSION-} && -n ${BW_CACHE_KEY-} ]] ||
  die "the vault is not unlocked -- run this as 'bwu get' or 'bwu update', which unlock it first"

# The cache, decrypted -- or nothing, when there is none, or it was written
# under another unlock.
read_cache() {
  [[ -f $CACHE ]] || return 1
  age --decrypt -i <(printf '%s\n' "$BW_CACHE_KEY") "$CACHE" 2>/dev/null
}

# Sync with the server, cache everything bw then holds, and print it. Exits 3
# when the session key no longer works -- locked, or unlocked elsewhere since
# -- which tells bwu to unlock and run this again.
refresh() {
  local items folders recipient tmp now
  if ! bw sync >/dev/null 2>&1; then
    bw unlock --check >/dev/null 2>&1 || exit 3
    echo "bwu: could not reach the server -- caching what bw already has" >&2
  fi
  if ! items=$(bw list items 2>/dev/null); then
    bw unlock --check >/dev/null 2>&1 || exit 3
    die "bw could not list the vault"
  fi
  folders=$(bw list folders 2>/dev/null) || folders='[]'
  now=$(date +%s)
  recipient=$(printf '%s\n' "$BW_CACHE_KEY" | age-keygen -y) || die "the cache key is not an age key"
  mkdir -p "$(dirname "$CACHE")"
  chmod 700 "$(dirname "$CACHE")"
  tmp=$(mktemp "$CACHE.XXXXXX") || die "cannot write the cache in $(dirname "$CACHE")"
  # printf is a builtin, so the vault goes to age through a pipe and never
  # onto a command line, where ps would show it.
  if printf '{"cached":%s,"items":%s,"folders":%s}\n' "$now" "$items" "$folders" |
       age --encrypt -r "$recipient" > "$tmp"; then
    chmod 600 "$tmp"
    mv -f -- "$tmp" "$CACHE"
  else
    rm -f -- "$tmp"
    die "could not write the cache"
  fi
  printf '{"cached":%s,"items":%s,"folders":%s}\n' "$now" "$items" "$folders"
}

if [[ $sub == update ]]; then
  data=$(refresh) || exit $?
  echo "Bitwarden: synced; $(jq '.items | length' <<<"$data") items cached" >&2
  exit 0
fi

if $update || ! data=$(read_cache); then
  data=$(refresh) || exit $?
fi

ago() {
  local s=$(( $(date +%s) - $1 ))
  if (( s < 60 )); then echo "just now"
  elif (( s < 3600 )); then echo "$(( s / 60 )) min ago"
  elif (( s < 86400 )); then echo "$(( s / 3600 )) h ago"
  else echo "$(( s / 86400 )) days ago"; fi
}
cached=$(ago "$(jq '.cached' <<<"$data")")

# Files: every attachment the cache knows of, one line each -- the item's id,
# the file's id, its name and size. With a name after -f, only the files that
# match it, as fzf would match them, and so only the items that have one. add
# lists every item: any of them can have a file attached.
only=null
if $file_mode; then
  # Files come from the server and go to it, with the session key: a stale
  # key is better found now, before the picking, than after it.
  bw unlock --check >/dev/null 2>&1 || exit 3
fi
if $file_mode && [[ $sub != add ]]; then
  atts=$(jq -r '.items[] | .id as $i | (.attachments // [])[]
                | [$i, .id, (.fileName // "file"), (.sizeName // "")] | @tsv' <<<"$data")
  [[ -n $atts ]] || die "no item has a file attached$([[ $sub == put ]] && echo " -- bwu add attaches one")"
  if [[ -n $file_name ]]; then
    atts=$(fzf --filter="$file_name" --delimiter=$'\t' --nth=3 <<<"$atts") ||
      die "no attached file matches '$file_name'"
  fi
  only=$(cut -f1 <<<"$atts" | jq -R . | jq -sc 'unique')
fi

# One line per item: its id, hidden, then the name, username and website,
# padded into columns, and the kind and folder, dimmed and not searched.
# fzf shows a tab as one space here (--tabstop=1), so the padding lines up.
list=$(jq -r --argjson only "$only" '
  (INDEX((.folders // [])[]; .id // "") | map_values(.name)) as $f
  | def kind: {"1": "login", "2": "note", "3": "card", "4": "identity", "5": "ssh key"}[.type | tostring] // "item";
    def site: (.login.uris // [])[0].uri // "" | sub("^[a-z]+://"; "") | sub("/.*$"; "");
    def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
    def pad($n): . + (" " * ([$n - length, 0] | max));
    .items
  | map(select($only == null or (.id as $i | any($only[]; . == $i))))
  | map({id, name: (.name // "" | cut(40)),
         user: (if .type == 1 then .login.username // "" else "" end | cut(32)),
         site: (if $only != null then (.attachments // []) | map(.fileName) | join(", ")
                elif .type == 1 then site else "" end | cut(40)),
         tag: (kind + (($f[.folderId // ""] // "") | if . != "" then " · " + . else "" end))})
  | sort_by(.name | ascii_downcase)
  | (map(.name | length) + [4] | max) as $wn
  | (map(.user | length) + [8] | max) as $wu
  | (map(.site | length) + [4] | max) as $ws
  | (["", ("NAME" | pad($wn)), ("USERNAME" | pad($wu)),
     ((if $only != null then "FILES" else "SITE" end) | pad($ws)), "TYPE"] | join("\t")),
    (.[] | [.id, (.name | pad($wn)), (.user | pad($wu)), (.site | pad($ws)), "\u001b[2m\(.tag)\u001b[0m"] | join("\t"))
' <<<"$data")
(( $(wc -l <<<"$list") > 1 )) || die "the vault is empty"

# --select-1: a search that already names one item needs no picking.
rc=0
line=$(fzf --ansi --delimiter=$'\t' --with-nth=2.. --nth=1,2,3 --tabstop=1 \
         --header-lines=1 --header="cached $cached -- bwu update for changes made elsewhere" \
         --layout=reverse --height=60% --prompt='bw> ' \
         --query="$query" --select-1 --exit-0 <<<"$list") || rc=$?
case $rc in
  0)   ;;
  1)   die "nothing matches '$query'" ;;
  130) exit 130 ;;
  *)   die "fzf failed" ;;
esac
id=${line%%$'\t'*}
item=$(jq -c --arg id "$id" '.items[] | select(.id == $id)' <<<"$data")
unset data list
[[ -n $item ]] || die "the item picked is no longer in the list"

name=$(jq -r '.name' <<<"$item")

if [[ $sub == put || $sub == add ]]; then
  # The item as the server has it now, not as the cache remembers it: a file
  # added or deleted elsewhere since counts, and bw writes against its own
  # copy, which only a sync brings up to date.
  if ! bw sync >/dev/null 2>&1; then
    bw unlock --check >/dev/null 2>&1 || exit 3
    die "could not reach the server -- nothing was changed"
  fi
  current=$(bw get item "$id" 2>/dev/null) || die "$name is no longer in the vault -- nothing was changed"
  # Its files, one line each: the file's id, its name and size.
  have=$(jq -r '(.attachments // [])[] | [.id, (.fileName // "file"), (.sizeName // "")] | @tsv' <<<"$current")
  known=$(jq -c '[(.attachments // [])[].id]' <<<"$current")
  unset current
  named() { [[ -z $have ]] || awk -F'\t' -v n="$1" '$2 == n' <<<"$have"; }

  # What goes up: each file, the name it is to have in the vault, and the
  # files of the item it replaces -- their ids, and their size.
  srcs=() as=() olds=() was=()
  if [[ $sub == put ]]; then
    [[ -n $have ]] || die "$name has no file attached any more -- bwu add attaches one"
    pick=$(named "${file_name:-${paths[0]##*/}}")
    if [[ -z $pick || $(wc -l <<<"$pick") -gt 1 ]]; then
      # No file of that very name, or several: picked, never guessed, since
      # the one picked is deleted -- so not even a lone file is taken at once.
      width=$(cut -f2 <<<"$have" | awk '{ if (length > m) m = length } END { print (m > 4 ? m : 4) }')
      rc=0
      pick=$( { printf '\t%-*s\t%s\n' "$width" FILE SIZE
                awk -F'\t' -v w="$width" '{ printf "%s\t%-" w "s\t%s\n", $1, $2, $3 }' <<<"$have"; } |
              fzf --delimiter=$'\t' --with-nth=2.. --nth=1 --tabstop=1 --header-lines=1 \
                  --header="files of $name -- the one ${paths[0]} replaces" \
                  --layout=reverse --height=40% --prompt='replace> ' \
                  --query="$file_name" ) || rc=$?
      case $rc in
        0)   ;;
        1)   die "no file of $name picked -- nothing was changed" ;;
        130) exit 130 ;;
        *)   die "fzf failed" ;;
      esac
      pick=$(awk -F'\t' -v a="${pick%%$'\t'*}" '$1 == a' <<<"$have")
    fi
    srcs=("${paths[0]}")
    as=("$(cut -f2 <<<"$pick")")
    olds=("$(cut -f1 <<<"$pick")")
    was=("$(cut -f3 <<<"$pick")")
  else
    # Every question before the first upload, so that no answer comes too
    # late to change anything.
    for path in "${paths[@]}"; do
      file=${path##*/}
      clash=$(named "$file")
      if [[ -n $clash ]] && ! $force; then
        [[ -t 0 ]] || die "$name has $file already -- --force overwrites it; nothing was changed"
        n=$(wc -l <<<"$clash")
        if (( n == 1 )); then
          size=$(cut -f3 <<<"$clash")
          read -r -p "$name has $file already${size:+ ($size)} -- overwrite it? [y/N] " reply || reply=""
        else
          read -r -p "$name has $n files called $file already -- overwrite them? [y/N] " reply || reply=""
        fi
        if [[ ${reply,,} != y && ${reply,,} != yes ]]; then
          echo "$file left out" >&2
          continue
        fi
      fi
      srcs+=("$path")
      as+=("$file")
      olds+=("$(cut -f1 <<<"$clash" | paste -sd' ')")
      was+=("$(cut -f3 <<<"$clash" | paste -sd'+')")
    done
    (( ${#srcs[@]} )) || { echo "$name: nothing added" >&2; exit 0; }
  fi

  # bw names a file in the vault after the file it is given, so one that is
  # to have another name goes up as a copy by that name, made in a directory
  # only you can read: attachments tend to be keys.
  tmp=$(umask 077 && mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bwu-put.XXXXXX") ||
    die "cannot make a private directory to upload from -- nothing was changed"
  trap 'rm -rf -- "$tmp"' EXIT
  rc=0 wrote=false
  for i in "${!srcs[@]}"; do
    src=${srcs[i]}
    if [[ ${src##*/} != "${as[i]}" ]]; then
      if ! { mkdir -- "$tmp/$i" && cp -- "$src" "$tmp/$i/${as[i]}"; }; then
        echo "bwu: could not copy $src to upload it as ${as[i]} -- nothing was changed" >&2
        rc=1
        break
      fi
      src=$tmp/$i/${as[i]}
    fi

    # The new file up first, the old one deleted after: a failure in between
    # leaves both, never neither. bw answers with the whole item, secrets
    # included -- kept here for the new file's size, and never shown.
    if ! out=$(bw create attachment --file "$src" --itemid "$id" --nointeraction 2>"$tmp/err"); then
      err=$(<"$tmp/err")
      echo "bwu: could not upload ${srcs[i]}: ${err:-bw gave no reason}" >&2
      (( i + 1 == ${#srcs[@]} )) || echo "bwu: not uploaded either: ${srcs[*]:i+1}" >&2
      rc=1
      break
    fi
    wrote=true
    size=$(jq -r --argjson known "$known" --arg n "${as[i]}" '
      [(.attachments // [])[] | select(.fileName == $n and (.id as $i | any($known[]; . == $i) | not))]
      | last | .sizeName // ""' <<<"$out")
    known=$(jq -c '[(.attachments // [])[].id]' <<<"$out")
    unset out

    err=""
    for old in ${olds[i]}; do
      bw delete attachment "$old" --itemid "$id" --nointeraction >/dev/null 2>"$tmp/err" ||
        err=$(<"$tmp/err")
    done
    if [[ -n $err ]]; then
      echo "bwu: ${as[i]} is up, but the old one could not be deleted: $err -- $name has both now" >&2
      rc=1
    elif [[ -n ${olds[i]} ]]; then
      by=""
      [[ ${srcs[i]##*/} == "${as[i]}" ]] || by=" by ${srcs[i]}"
      echo "$name: ${as[i]} replaced$by${was[i]:+ (${was[i]} -> ${size:-?})}" >&2
    else
      echo "$name: ${as[i]} added${size:+ ($size)}" >&2
    fi
  done

  # The cache anew, so that the next get shows the change. Its failure is
  # not passed on as one: a 3 would have bwu unlock and run all of this
  # again, and upload the files twice.
  if $wrote; then
    ( refresh >/dev/null ) || echo "bwu: the cache is behind the vault -- bwu update brings it up to date" >&2
  fi
  exit "$rc"
fi

if $file_mode; then
  # This item's files -- those matching the name, when there is one -- to
  # pick from, unless there is just the one. Tab marks several, ctrl-a all.
  mine=$(awk -F'\t' -v id="$id" '$1 == id' <<<"$atts")
  width=$(cut -f3 <<<"$mine" | awk '{ if (length > m) m = length } END { print (m > 4 ? m : 4) }')
  rc=0
  picked=$( { printf '\t%-*s\t%s\n' "$width" FILE SIZE
              awk -F'\t' -v w="$width" '{ printf "%s\t%-" w "s\t%s\n", $2, $3, $4 }' <<<"$mine"; } |
            fzf --multi --bind=ctrl-a:select-all,ctrl-d:deselect-all \
                --delimiter=$'\t' --with-nth=2.. --nth=1 --tabstop=1 --header-lines=1 \
                --header="files of $name -- Tab marks several, ctrl-a all" \
                --layout=reverse --height=40% --prompt='file> ' \
                --query="$file_name" --select-1 --exit-0 ) || rc=$?
  case $rc in
    0)   ;;
    1)   die "no file of $name matches '$file_name'" ;;
    130) exit 130 ;;
    *)   die "fzf failed" ;;
  esac
  mapfile -t att_ids < <(cut -f1 <<<"$picked")
  n=${#att_ids[@]}
  field() { awk -F'\t' -v a="$1" -v f="$2" '$2 == a { print $f }' <<<"$mine"; }

  if [[ $file_out == - ]]; then
    (( n == 1 )) || die "$n files cannot all go to stdout -- pick one, or give a directory"
    bw get attachment "${att_ids[0]}" --itemid "$id" --raw || die "could not download $(field "${att_ids[0]}" 3)"
    exit 0
  fi
  if (( n > 1 )) && [[ -n $file_out && ! -d $file_out ]]; then
    die "$n files go into a directory -- give one, or no name for this one"
  fi

  # Where each goes: under its own name -- without any directory a name could
  # smuggle in -- here or in the directory given, or as the one name given.
  files=() sizes=() targets=()
  for att in "${att_ids[@]}"; do
    file=$(field "$att" 3)
    own=${file##*/}
    [[ -n $own && $own != . && $own != .. ]] || own=attachment
    if [[ -z $file_out ]]; then
      target=$own
    elif [[ -d $file_out ]]; then
      target=${file_out%/}/$own
    else
      target=$file_out
    fi
    files+=("$file")
    sizes+=("$(field "$att" 4)")
    targets+=("$target")
  done

  # Every target checked before anything is fetched: the set is saved whole,
  # or not at all.
  dup=$(printf '%s\n' "${targets[@]}" | sort | uniq -d | head -n 1)
  [[ -z $dup ]] || die "two of the files would both be saved as $dup -- fetch them one at a time, with a name each"
  for target in "${targets[@]}"; do
    dir=$(dirname -- "$target")
    [[ -d $dir ]] || die "there is no directory $dir"
    [[ ! -d $target ]] || die "$target is a directory"
    if ! $force && [[ -e $target || -L $target ]]; then
      die "$target is there already -- --force replaces it, or give another name"
    fi
  done

  # Each fetched beside its target, readable by you alone, and all of them
  # before any is moved into place: a download that fails leaves nothing.
  tmps=()
  trap '(( ${#tmps[@]} == 0 )) || rm -f -- "${tmps[@]}"' EXIT
  for i in "${!att_ids[@]}"; do
    dir=$(dirname -- "${targets[i]}")
    tmp=$(umask 077 && mktemp "$dir/.bwu-get.XXXXXX") || die "cannot write in $dir"
    tmps+=("$tmp")
    bw get attachment "${att_ids[i]}" --itemid "$id" --raw > "$tmp" 2>/dev/null ||
      die "could not download ${files[i]} -- is the server reachable? Nothing was saved"
  done
  for i in "${!att_ids[@]}"; do
    if $force; then
      mv -f -- "${tmps[i]}" "${targets[i]}" || die "could not replace ${targets[i]}"
    elif ! mv -n -- "${tmps[i]}" "${targets[i]}" || [[ -e ${tmps[i]} ]]; then
      die "${targets[i]} appeared meanwhile -- left as it was"
    fi
    echo "$name: ${files[i]} saved as ${targets[i]}${sizes[i]:+ (${sizes[i]})}" >&2
  done
  tmps=()
  exit 0
fi
type=$(jq -r '.type' <<<"$item")
user=$(jq -r '(if .type == 1 then .login.username elif .type == 3 then .card.cardholderName else null end) // ""' <<<"$item")
secret=$(jq -r '(if .type == 1 then .login.password elif .type == 2 then .notes
                 elif .type == 3 then .card.number elif .type == 5 then .sshKey.privateKey
                 else null end) // ""' <<<"$item")

site=$(jq -r 'if .type == 1 then (.login.uris // [])[0].uri // "" | sub("^[a-z]+://"; "") | sub("/.*$"; "") else "" end' <<<"$item")

# Into the clipboard, out again after a while -- but only if it is still
# there: anything copied since is left alone.
copy_out() {
  local value=$1
  printf '%s' "$value" | wl-copy --sensitive
  ( sleep "$CLEAR_AFTER"
    [[ $(wl-paste --no-newline 2>/dev/null) == "$value" ]] && wl-copy --clear
  ) >/dev/null 2>&1 &
  disown
}
copied="copied, cleared in ${CLEAR_AFTER}s"

# The summary: one labelled row each, the labels dimmed on a terminal.
dim="" off=""
[[ -t 1 ]] && dim=$'\e[2m' off=$'\e[0m'
row() { printf '%s%-9s%s %s\n' "$dim" "$1" "$off" "$2"; }

# With -u or -p, stdout is the value alone, for pipes and $(...); which item
# it came from goes to the terminal, when there is one.
about() {
  [[ -t 2 ]] || return 0
  echo "$name${site:+ · $site}${1:+: $1}" >&2
}

case $want in
  user)
    [[ -n $user ]] || die "$name has no username"
    if $copy; then
      copy_out "$user"
      about "username $copied"
    else
      about
      printf '%s\n' "$user"
    fi ;;
  secret)
    [[ -n $secret ]] || die "$name has nothing to show for -p"
    if $copy; then
      copy_out "$secret"
      about "$( [[ $type == 2 ]] && echo note || echo password ) $copied"
    else
      about
      printf '%s\n' "$secret"
    fi ;;
  both)
    row item "$name"
    [[ -z $site ]] || row site "$site"
    case $type in
      1)
        [[ -z $user ]] || row username "$user"
        if [[ -z $secret ]]; then
          row password "(none)"
        elif $copy; then
          copy_out "$secret"
          row password "$copied"
        else
          row password "$secret"
        fi ;;
      3)
        [[ -z $user ]] || row holder "$user"
        if $copy; then
          copy_out "$secret"
          row number "$copied"
        else
          [[ -z $secret ]] || row number "$secret"
          expires=$(jq -r '.card | if .expMonth then "\(.expMonth)/\(.expYear)" else "" end' <<<"$item")
          code=$(jq -r '.card.code // ""' <<<"$item")
          [[ -z $expires ]] || row expires "$expires"
          [[ -z $code ]] || row code "$code"
        fi ;;
      *)
        # A note's text, or a key, as it is -- below the summary, unlabelled,
        # so that it copies out whole.
        [[ -n $secret ]] || die "$name has nothing to show"
        if $copy; then
          copy_out "$secret"
          row "$( [[ $type == 2 ]] && echo note || echo key )" "$copied"
        else
          echo
          printf '%s\n' "$secret"
        fi ;;
    esac ;;
esac
