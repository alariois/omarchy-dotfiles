#!/usr/bin/env bash
#
# bw-vault -- the Bitwarden vaults behind `bwu get`, `put`, `add` and
# `update`: an encrypted cache of every account's vault, and an fzf picker
# over that cache.
#
#   bwu get                # pick; print the username and password
#   bwu get github         # the same, the search started with "github"
#   bwu get -a alari       # pick from one account's items alone
#   bwu get -u | -p        # the username alone, or the password alone
#   bwu get -c             # copy instead of print: the password, or with -u
#                          # the username -- the username is printed alongside
#   bwu get -f [name [new]]  # an item's attached file, saved -- see --help
#   bwu put -f file [name] # an item's attached file, replaced by this one
#   bwu add -f file...     # files attached to an item
#   bwu update             # sync with the server, and cache the vaults anew
#   bwu --update get       # the same, then pick
#   bwu login NAME EMAIL   # add an account, and log in to it
#   bwu lock               # lock every account, and delete the cache
#
# Run through bwu, the shell function in shell/bashrc, which unlocks the
# accounts first and hands this their session keys and the cache key, in
# BW_KEYS, for its run alone; not by hand.
#
# The accounts are lib/bw.sh's: each its own bw data directory, so bw is run
# as one account at a time, with that account's key. Every account unlocked
# is in the cache and the list, and what is done to an item -- a file
# fetched, put or added -- is done as the account the item is in.
#
# The cache holds every item, secrets included, encrypted with age to a key
# made new with every unlock (bin/bw-session). The key is kept as the session
# keys are: in root's store, and unexported in the terminals unlocked with it.
# So a cache from an earlier unlock cannot be read, and `bw lock` deletes it.
# `bwu get` reads the cache and never runs bw; only when there is none it can
# read, or it lacks an account unlocked since, does it sync with the server
# and write one. Changes made elsewhere -- the browser, the phone -- show up
# after `bwu update`.
#
# The list shows every item: a login with its username and website, anything
# else by its name. The search covers the name, username and website, so a
# note is found by its title, and its text is never searched. Beside each, the
# account it is in, when there is more than one, the vault -- personal, or an
# organisation's, by name -- and its folder, or for an organisation's item its
# collections.
#
# What an item yields: a login its username and password; a note its text; a
# card its number, expiry and code (-p: the number); an SSH key its private
# key. -u is a login's username, or a card's holder.
#
# A copy goes to the clipboard marked sensitive, which clipboard managers
# that honour the hint keep out of their history, and is cleared after 45
# seconds unless something else has been copied over it.
#
# -f is for attached files. The cache knows which items have files and what
# they are called, so the picking is as quick as ever; the file itself comes
# from the server, decrypted by bw. It is written readable by you alone --
# attachments tend to be keys -- and over a file that is there only with
# --force. Several files can be picked at once; they are saved all, or none.
#
# put and add write files the other way. Bitwarden cannot change a file in
# place, only add one and delete one, so a file is replaced by uploading the
# new one first and deleting the old one after: a failure in between leaves
# both, never neither. put replaces one file, which keeps its name in the
# vault -- the one of the same name is taken at once, any other is picked,
# never guessed, since it is the one deleted. add attaches files, and asks
# before it overwrites one the item has by that name already. Both write
# against the item as the server has it, after a sync, not as the cache
# remembers it, and cache the vault anew after.

set -euo pipefail

# What `bwu --help` shows -- for using bwu, where the comment above is for
# reading this file. Headings in bold on a terminal.
usage() {
  local b="" r=""
  [[ -t 1 ]] && b=$'\e[1m' r=$'\e[0m'
  cat <<EOF
${b}bwu${r} -- Bitwarden in the terminal: unlock once, then find, copy and store secrets.

${b}Usage${r}
  bwu                       unlock every account in this terminal
  bwu get [options] [text]  pick an item with fzf, print its secret
  bwu put [text] -f file [name]
                            replace one of an item's files with file
  bwu add [text] -f file... attach files to an item
  bwu move --to NAME [options] [text]
                            move an item, or a whole collection, to another
                            account -- bwu move --help
  bwu update                sync with the server, cache the vaults anew
  bwu --update get ...      the same, then pick
  bwu login NAME EMAIL      add an account by that name, and log in to it
  bwu lock                  lock every account everywhere, delete the cache
  bwu --help                this

${b}Options for get${r}
  -a, --account NAME
                   only that account's items; also for put and add
  -u, --username   the username alone
  -p, --password   the password alone (a note's text, a card's number)
  -c, --copy       copy instead of print, cleared after ${CLEAR_AFTER} s; with
                   neither -u nor -p, prints the username, copies the password
      --update     sync and cache the vaults anew first
  text             start the search with it; one match is picked at once
  Short options combine: -cp, -cu.

${b}Attached files${r}
  -f, --file [name [new-name]]
                   an attached file instead: only items with files are listed,
                   then the item's files, if it has more than one. name narrows
                   both to files matching it; one match is taken at once. The
                   file is saved under its own name here, or as new-name -- a
                   directory, or - for stdout. Tab marks several files, ctrl-a
                   all; several go here, or into the directory given.
                   Everything after -f is its own: options go before it, and
                   -- before a name that starts with -.
      --force      let a saved file replace one that is there; without it,
                   nothing is saved when any of the files is there already

${b}Putting files in the vault${r}
  put [text] -f file [name]
                   only items with files are listed; file replaces the item's
                   file of its own name, or of name, at once -- any other is
                   picked. It keeps the old file's name in the vault, and the
                   old one is deleted only once the new one is up.
  add [text] -f file...
                   any item is listed, and the files are attached to it. A
                   file the item has by that name already: asked whether to
                   overwrite it, and left out if not.
      --force      with add: overwrite without asking
      --update     sync and cache the vault anew before the list
  Everything after -f is its own, as for get.

${b}Examples${r}
  bwu get github            username and password for GitHub
  bwu get -cp aws           copy the AWS password
  bwu get -u gitlab         just the GitLab username
  bwu get "home wifi"       a note's text
  bwu get -f                pick an item, then one of its files
  bwu get github -f key ~/.ssh/github
                            GitHub's file matching "key", saved as ~/.ssh/github
  bwu get -f cert - | openssl x509 -noout -dates
  bwu get --force -f "" ~/.ssh/
                            pick files with Tab, replace them in ~/.ssh
  bwu put superspot -f envs/prod/env.yaml
                            Superspot's env.yaml, replaced by this one
  bwu put superspot -f prod.yaml env.yaml
                            the same, from a file of another name
  bwu add github -f ~/.ssh/github ~/.ssh/github.pub
                            both attached to GitHub

${b}Accounts${r}
  bwu login superhands alari@superhands.ee
                   adds an account, named superhands, and logs in to it, on the
                   server bw itself uses. bw's own login, when it is that one,
                   is taken as it is, with no logging in.

${b}How it works${r}
  The first bwu asks for each account's master password; each terminal after
  that needs only your fingerprint, or your password, for sudo. bwu get picks
  from an encrypted cache of every account, so the list opens at once --
  changes made elsewhere, in the browser or on the phone, arrive with bwu
  update. The search covers names, usernames and websites; a note is found by
  its title alone. bwu lock locks every account for every terminal; bw lock
  the one in bw's own directory.
EOF
  exit "${1:-0}"
}
die() { echo "bwu: $*" >&2; exit 1; }

DOTFILES=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/bw.sh
source "$DOTFILES/lib/bw.sh"

# BW_CLEAR_AFTER is for tests.
CLEAR_AFTER=${BW_CLEAR_AFTER:-45}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-dotfiles/bw-vault.age

sub=${1-}
(( $# )) && shift
case $sub in
  get|put|add|update|pick|forget|files|accounts|check|login|lock) ;;
  -h|--help|"") usage 0 ;;
  *)            die "unknown command: $sub  (try --help)" ;;
esac

if [[ $sub == forget ]]; then
  rm -f -- "$CACHE"
  exit 0
fi

# For bwu's tab completion: the accounts' names.
if [[ $sub == accounts ]]; then
  bw_accounts
  exit 0
fi

bw_read_keys

# For bwu's tab completion: the names of the files attached anywhere in the
# vaults, one per line, from the cache alone -- nothing when there is none
# this terminal's key can read. It never runs bw, so Tab never asks or waits.
if [[ $sub == files ]]; then
  [[ -n $BW_CACHE_KEY && -f $CACHE ]] || exit 0
  age --decrypt -i <(printf '%s\n' "$BW_CACHE_KEY") "$CACHE" 2>/dev/null |
    jq -r '[.items[] | (.attachments // [])[] | .fileName // empty] | unique[]' 2>/dev/null || true
  exit 0
fi

# For bwu: is every account unlocked in this terminal? 3 when one is not --
# locked since, never unlocked, or added since -- which tells bwu to unlock.
# One logged out does not count: unlocking cannot help it.
if [[ $sub == check ]]; then
  while IFS= read -r name; do
    bw_unlocks "$name" && continue
    [[ $(BITWARDENCLI_APPDATA_DIR=$BW_ACCOUNTS/$name bw status 2>/dev/null | jq -r '.status // empty' 2>/dev/null) == unauthenticated ]] ||
      exit 3
  done < <(bw_accounts)
  exit 0
fi

if [[ $sub == lock ]]; then
  locked=()
  while IFS= read -r name; do
    BITWARDENCLI_APPDATA_DIR=$BW_ACCOUNTS/$name bw lock >/dev/null 2>&1 &&
      locked+=("$name")
  done < <(bw_accounts)
  rm -f -- "$CACHE"
  if (( ${#locked[@]} )); then
    echo "Bitwarden: ${locked[*]} locked"
  else
    echo "Bitwarden: no account to lock"
  fi
  exit 0
fi

# An account added: a bw data directory of its own, logged in. The server is
# bw's own one -- the one setup/install.sh sets -- so every account is on it.
# bw's own login, when it is this very account, is taken as it is: linked,
# not logged in to again. An account there already, logged out since, is
# logged in to again where it is.
if [[ $sub == login ]]; then
  (( $# == 2 )) || die "bwu login takes a name and an email: bwu login superhands alari@superhands.ee"
  name=$1 email=${2,,}
  bw_valid_name "$name" || die "'$name' cannot be an account's name -- lowercase letters, digits, - and _"
  [[ $email == ?*@?* ]] || die "'$email' is not an email address"
  command -v bw >/dev/null || die "bw is not installed"
  dir=$BW_ACCOUNTS/$name
  # An email, as bw status of a data directory gives it: logged in, or not.
  logged_in_as() {
    BITWARDENCLI_APPDATA_DIR=$1 bw status 2>/dev/null |
      jq -r 'select(.status != "unauthenticated") | .userEmail // empty | ascii_downcase' 2>/dev/null || true
  }
  if [[ -e $dir || -L $dir ]]; then
    was=$(logged_in_as "$dir")
    [[ $was != "$email" ]] || { echo "Bitwarden: $name is $email already"; exit 0; }
    [[ -z $was ]] || die "there is an account $name already, logged in as $was"
    BITWARDENCLI_APPDATA_DIR=$dir bw login "$email" --raw >/dev/null || die "not logged in to $email"
    echo "Bitwarden: $name logged in again as $email -- bwu unlocks it"
    exit 0
  fi
  while IFS= read -r other; do
    [[ $(logged_in_as "$BW_ACCOUNTS/$other") != "$email" ]] || die "$other is $email already"
  done < <(bw_accounts)

  mkdir -p -- "$BW_ACCOUNTS"
  chmod 700 -- "$BW_ACCOUNTS"
  if [[ -d $BW_OWN_DIR ]] && [[ $(logged_in_as "$BW_OWN_DIR") == "$email" ]]; then
    ln -s -- "$BW_OWN_DIR" "$dir" || die "could not link $dir"
    echo "Bitwarden: $name is bw's own login, $email -- bwu unlocks it"
    exit 0
  fi

  server=$(BITWARDENCLI_APPDATA_DIR=$BW_OWN_DIR bw status 2>/dev/null | jq -r '.serverUrl // empty' 2>/dev/null || true)
  [[ $server == https://* ]] || die "bw has no server set -- setup/install.sh sets it"
  mkdir -m 700 -- "$dir" || die "could not make $dir"
  # Gone again, should the login fail: a directory with no login in it would
  # be an account bwu cannot unlock. Only this one, made just now.
  forget_dir() {
    [[ -n $name && $dir == "$BW_ACCOUNTS/$name" && -d $dir && ! -L $dir ]] || return 0
    rm -rf -- "${dir:?}"
  }
  if ! BITWARDENCLI_APPDATA_DIR=$dir bw config server "$server" >/dev/null 2>&1; then
    forget_dir
    die "bw could not be pointed at $server"
  fi
  # bw prompts on stderr -- the password, and a second step -- and prints the
  # session key, which is not kept: bwu unlocks the account the usual way.
  if ! BITWARDENCLI_APPDATA_DIR=$dir bw login "$email" --raw >/dev/null; then
    forget_dir
    die "not logged in to $email"
  fi
  echo "Bitwarden: $name logged in as $email on $server -- bwu unlocks it"
  exit 0
fi

want=both copy=false query="" update=false account="" except="" header=""
file_mode=false file_name="" file_out="" force=false paths=()
while (( $# )); do
  case $1 in
    -f|--file)
      # Everything after -f is its own: [--] and then, for get, [name
      # [new-name]]; for put, file [name]; for add, file...
      file_mode=true
      shift
      ended=false
      rest=()
      while (( $# )); do
        if ! $ended && [[ $1 == -- ]]; then
          ended=true
          shift
          continue
        fi
        if ! $ended && [[ $1 == -?* ]]; then
          [[ $sub != get ]] ||
            die "after -f come only a file's name and a new name -- options go before -f, and -- before a name that starts with -"
          die "after -f come only files -- options go before -f, and -- before a file whose name starts with -"
        fi
        rest+=("$1")
        shift
      done
      case $sub in
        get)
          (( ${#rest[@]} <= 2 )) || die "-f takes a file's name and a new name, and nothing more"
          file_name=${rest[0]-}
          file_out=${rest[1]-} ;;
        put)
          (( ${#rest[@]} >= 1 )) || die "-f takes the file to put in the vault"
          (( ${#rest[@]} <= 2 )) || die "-f takes a file and the name of the one it replaces, and nothing more -- bwu add takes several"
          paths=("${rest[0]}")
          file_name=${rest[1]-} ;;
        add)
          (( ${#rest[@]} >= 1 )) || die "-f takes the files to attach"
          paths=("${rest[@]}") ;;
        *)
          die "bwu $sub takes no options" ;;
      esac ;;
    -a|--account)
      (( $# >= 2 )) || die "$1 takes an account's name"
      account=$2; shift 2 ;;
    --account=*)   account=${1#*=}; shift ;;
    # For bw-move: an account whose items are not listed, and the list's
    # heading.
    --except)
      [[ $sub == pick && $# -ge 2 ]] || die "unknown option: $1  (try --help)"
      except=$2; shift 2 ;;
    --header)
      [[ $sub == pick && $# -ge 2 ]] || die "unknown option: $1  (try --help)"
      header=$2; shift 2 ;;
    -u|--username) want=user; shift ;;
    -p|--password) want=secret; shift ;;
    -c|--copy)     copy=true; shift ;;
    --update)      update=true; shift ;;
    --force)       force=true; shift ;;
    -[upc][upc]*)
      # -cp and the like: short options together.
      for (( i = 1; i < ${#1}; i++ )); do
        case ${1:i:1} in
          u) want=user ;;
          p) want=secret ;;
          c) copy=true ;;
        esac
      done
      shift ;;
    -h|--help)     usage 0 ;;
    -*)            die "unknown option: $1  (try --help)" ;;
    *)             query+="${query:+ }$1"; shift ;;
  esac
done
[[ $sub != update || ( $want == both && $copy == false && -z $query && $file_mode == false && $force == false && -z $account ) ]] ||
  die "bwu update takes no options"
[[ $sub != pick || ( $want == both && $copy == false && $file_mode == false && $force == false ) ]] ||
  die "bw-vault pick takes no options but -a, --except, --header and --update"
if [[ $sub == put || $sub == add ]]; then
  $file_mode || die "bwu $sub takes files: bwu $sub [text] -f file  (try --help)"
  [[ $want == both && $copy == false ]] || die "-u, -p and -c are for get -- bwu $sub puts files in the vault"
  [[ $sub == add ]] || ! $force ||
    die "--force is for add and for get -f -- bwu put replaces the file without it"

  # The files, checked before anything is picked.
  for path in "${paths[@]}"; do
    [[ -f $path ]] || die "$path is not a file"
    [[ -r $path ]] || die "$path cannot be read"
  done
  dup=$(for path in "${paths[@]}"; do printf '%s\n' "${path##*/}"; done | sort | uniq -d | head -n 1)
  [[ -z $dup ]] || die "two of the files are called $dup -- the item would hold two files of one name"
fi
! $file_mode || [[ $want == both && $copy == false ]] ||
  die "-f cannot go with -u, -p or -c: a file is saved, not printed or copied"
! $force || $file_mode || die "--force goes with -f: it lets a saved file replace one that is there"

for tool in bw jq age age-keygen; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done
[[ $sub == update ]] || command -v fzf >/dev/null || die "fzf is not installed"
! $copy || command -v wl-copy >/dev/null || die "wl-copy is not installed, so -c cannot copy"
[[ -n $BW_CACHE_KEY ]] && (( ${#BW_KEY[@]} )) ||
  die "no account is unlocked -- run this as 'bwu get' or 'bwu update', which unlock them first"

# The accounts unlocked, as JSON, and those that are not -- locked, or not
# logged in -- whose items are missing from the list.
unlocked=$(bw_unlocked | jq -R . | jq -sc .)
mapfile -t missing < <(bw_accounts | grep -vxF -f <(bw_unlocked) || true)
if [[ -n $account ]]; then
  bw_accounts | grep -qxF -- "$account" || die "there is no account $account -- $(bw_accounts | paste -sd' ')"
  [[ -n ${BW_KEY[$account]-} ]] || die "$account is locked -- bwu unlocks it"
fi

# The cache, decrypted -- or nothing, when there is none, or it was written
# under another unlock.
read_cache() {
  [[ -f $CACHE ]] || return 1
  age --decrypt -i <(printf '%s\n' "$BW_CACHE_KEY") "$CACHE" 2>/dev/null
}

# Sync every account unlocked with the server, cache everything bw then holds
# -- each item, folder, collection and organisation marked with the account
# it came from -- and print it. Exits 3 when an account's key no longer works
# -- locked, or unlocked elsewhere since -- which tells bwu to unlock and run
# this again.
refresh() {
  local name items folders collections organizations all="" recipient tmp now
  while IFS= read -r name; do
    if ! bw_as "$name" sync >/dev/null 2>&1; then
      bw_unlocks "$name" || exit 3
      echo "bwu: could not reach the server -- caching what bw already has of $name" >&2
    fi
    if ! items=$(bw_as "$name" list items 2>/dev/null); then
      bw_unlocks "$name" || exit 3
      die "bw could not list $name's vault"
    fi
    folders=$(bw_as "$name" list folders 2>/dev/null) || folders='[]'
    collections=$(bw_as "$name" list collections 2>/dev/null) || collections='[]'
    organizations=$(bw_as "$name" list organizations 2>/dev/null) || organizations='[]'
    # printf is a builtin, so the vault goes to jq, and on to age, through a
    # pipe and never onto a command line, where ps would show it.
    all+=$(printf '{"items":%s,"folders":%s,"collections":%s,"organizations":%s}\n' \
             "$items" "$folders" "$collections" "$organizations" |
           jq -c --arg a "$name" 'map_values(map(. + {account: $a}))')$'\n' ||
      die "bw gave $name's vault in a form bwu does not know"
  done < <(bw_unlocked)
  unset items
  now=$(date +%s)
  all=$(printf '%s' "$all" | jq -c -s --argjson now "$now" --argjson accounts "$unlocked" '
    {cached: $now, accounts: $accounts,
     items: (map(.items) | add // []), folders: (map(.folders) | add // []),
     collections: (map(.collections) | add // []), organizations: (map(.organizations) | add // [])}')
  recipient=$(printf '%s\n' "$BW_CACHE_KEY" | age-keygen -y) || die "the cache key is not an age key"
  mkdir -p "$(dirname "$CACHE")"
  chmod 700 "$(dirname "$CACHE")"
  tmp=$(mktemp "$CACHE.XXXXXX") || die "cannot write the cache in $(dirname "$CACHE")"
  if printf '%s\n' "$all" | age --encrypt -r "$recipient" > "$tmp"; then
    chmod 600 "$tmp"
    mv -f -- "$tmp" "$CACHE"
  else
    rm -f -- "$tmp"
    die "could not write the cache"
  fi
  printf '%s\n' "$all"
}

if [[ $sub == update ]]; then
  data=$(refresh) || exit $?
  echo "Bitwarden: synced $(bw_unlocked | paste -sd' '); $(jq '.items | length' <<<"$data") items cached" >&2
  (( ${#missing[@]} == 0 )) || echo "Bitwarden: ${missing[*]} locked, and not in the cache" >&2
  exit 0
fi

# A cache from another set of accounts -- one unlocked since, or locked -- is
# made anew, as is one from before there were accounts.
if $update || ! data=$(read_cache) ||
   ! jq -e --argjson want "$unlocked" '.accounts == $want' >/dev/null <<<"$data"; then
  data=$(refresh) || exit $?
fi

ago() {
  local s=$(( $(date +%s) - $1 ))
  if (( s < 60 )); then echo "just now"
  elif (( s < 3600 )); then echo "$(( s / 60 )) min ago"
  elif (( s < 86400 )); then echo "$(( s / 3600 )) h ago"
  else echo "$(( s / 86400 )) days ago"; fi
}
cached=$(ago "$(jq '.cached' <<<"$data")")

# Files: every attachment the cache knows of, one line each -- the item's
# account and id, the file's id, its name and size. With a name after -f, only
# the files that match it, as fzf would match them, and so only the items that
# have one. add lists every item: any of them can have a file attached.
only=null
if $file_mode; then
  # Files come from the server and go to it, with the session keys: a stale
  # key is better found now, before the picking, than after it.
  while IFS= read -r name; do
    [[ -n $account && $name != "$account" ]] || bw_unlocks "$name" || exit 3
  done < <(bw_unlocked)
fi
if $file_mode && [[ $sub != add ]]; then
  atts=$(jq -r --arg acct "$account" '.items[] | select($acct == "" or .account == $acct)
                | .account as $a | .id as $i | (.attachments // [])[]
                | [$a, $i, .id, (.fileName // "file"), (.sizeName // "")] | @tsv' <<<"$data")
  [[ -n $atts ]] || die "no item${account:+ of $account} has a file attached$([[ $sub == put ]] && echo " -- bwu add attaches one")"
  if [[ -n $file_name ]]; then
    atts=$(fzf --filter="$file_name" --delimiter=$'\t' --nth=4 <<<"$atts") ||
      die "no attached file matches '$file_name'"
  fi
  only=$(cut -f1,2 <<<"$atts" | jq -R 'sub("\t"; " ")' | jq -sc 'unique')
fi

# One line per item: its account and id, hidden, then the name, username and
# website, padded into columns, the account it is in -- when there is more
# than one -- and the vault, and the kind and folder -- an organisation's
# collections -- dimmed. Only the first three are searched. fzf shows a tab as
# one space here (--tabstop=1), so the padding lines up.
list=$(jq -r --argjson only "$only" --arg acct "$account" --arg except "$except" '
  (INDEX((.folders // [])[]; .id // "") | map_values(.name)) as $f
  | (INDEX((.collections // [])[]; .id) | map_values(.name)) as $c
  | (INDEX((.organizations // [])[]; .id) | map_values(.name)) as $o
  | ((.accounts // []) | length > 1) as $many
  | def kind: {"1": "login", "2": "note", "3": "card", "4": "identity", "5": "ssh key"}[.type | tostring] // "item";
    def site: (.login.uris // [])[0].uri // "" | sub("^[a-z]+://"; "") | sub("/.*$"; "");
    def place: if .organizationId then [(.collectionIds // [])[] | $c[.] // empty] | join(", ")
               else $f[.folderId // ""] // "" end;
    def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
    def pad($n): . + (" " * ([$n - length, 0] | max));
    .items
  | map(select(($acct == "" or .account == $acct) and .account != $except))
  | map(select($only == null or ("\(.account) \(.id)" as $k | any($only[]; . == $k))))
  | map({account, id, name: (.name // "" | cut(40)),
         user: (if .type == 1 then .login.username // "" else "" end | cut(32)),
         site: (if $only != null then (.attachments // []) | map(.fileName) | join(", ")
                elif .type == 1 then site else "" end | cut(40)),
         vault: ((if $many then .account + " · " else "" end)
                 + (if .organizationId then $o[.organizationId] // "organisation" else "personal" end) | cut(36)),
         tag: (kind + (place | if . != "" then " · " + . else "" end))})
  | sort_by(.name | ascii_downcase)
  | (map(.name | length) + [4] | max) as $wn
  | (map(.user | length) + [8] | max) as $wu
  | (map(.site | length) + [4] | max) as $ws
  | (map(.vault | length) + [5] | max) as $wv
  | (["", "", ("NAME" | pad($wn)), ("USERNAME" | pad($wu)),
     ((if $only != null then "FILES" else "SITE" end) | pad($ws)), ("VAULT" | pad($wv)), "TYPE"] | join("\t")),
    (.[] | [.account, .id, (.name | pad($wn)), (.user | pad($wu)), (.site | pad($ws)), (.vault | pad($wv)),
            "\u001b[2m\(.tag)\u001b[0m"] | join("\t"))
' <<<"$data")
(( $(wc -l <<<"$list") > 1 )) || die "${account:-the vault} has no items${except:+ but in $except}"

# The heading: how old the cache is, and which accounts are not in it.
note="cached $cached"
(( ${#missing[@]} == 0 )) || note+=" -- ${missing[*]} locked, bwu unlocks"
note+=" -- bwu update for changes made elsewhere"
[[ -z $header ]] || note="$header -- $note"

# --select-1: a search that already names one item needs no picking.
rc=0
line=$(fzf --ansi --delimiter=$'\t' --with-nth=3.. --nth=1,2,3 --tabstop=1 \
         --header-lines=1 --header="$note" \
         --layout=reverse --height=60% --prompt='bw> ' \
         --query="$query" --select-1 --exit-0 <<<"$list") || rc=$?
case $rc in
  0)   ;;
  1)   die "nothing matches '$query'" ;;
  130) exit 130 ;;
  *)   die "fzf failed" ;;
esac
IFS=$'\t' read -r account id _ <<<"$line"

# bw-move takes it from here: the item, as its account and id.
if [[ $sub == pick ]]; then
  printf '%s\t%s\n' "$account" "$id"
  exit 0
fi

item=$(jq -c --arg a "$account" --arg id "$id" '.items[] | select(.account == $a and .id == $id)' <<<"$data")
# For the summary: the account, when there are several; an organisation's
# name, and the item's collections in it.
vault=$(jq -r --arg a "$account" --arg id "$id" '
  (INDEX((.collections // [])[]; .id) | map_values(.name)) as $c
  | (INDEX((.organizations // [])[]; .id) | map_values(.name)) as $o
  | (if (.accounts // []) | length > 1 then $a + " · " else "" end) as $prefix
  | .items[] | select(.account == $a and .id == $id)
  | $prefix + if .organizationId
    then "\($o[.organizationId] // "an organisation"), an organisation"
         + ([(.collectionIds // [])[] | $c[.] // empty] | if length > 0 then " · " + join(", ") else "" end)
    else "personal" end' <<<"$data")
unset data list
[[ -n $item ]] || die "the item picked is no longer in the list"

name=$(jq -r '.name' <<<"$item")

if [[ $sub == put || $sub == add ]]; then
  # The item as the server has it now, not as the cache remembers it: a file
  # added or deleted elsewhere since counts, and bw writes against its own
  # copy, which only a sync brings up to date.
  if ! bw_as "$account" sync >/dev/null 2>&1; then
    bw_unlocks "$account" || exit 3
    die "could not reach the server -- nothing was changed"
  fi
  current=$(bw_as "$account" get item "$id" 2>/dev/null) || die "$name is no longer in the vault -- nothing was changed"
  # Its files, one line each: the file's id, its name and size.
  have=$(jq -r '(.attachments // [])[] | [.id, (.fileName // "file"), (.sizeName // "")] | @tsv' <<<"$current")
  known=$(jq -c '[(.attachments // [])[].id]' <<<"$current")
  unset current
  named() { [[ -z $have ]] || awk -F'\t' -v n="$1" '$2 == n' <<<"$have"; }

  # What goes up: each file, the name it is to have in the vault, and the
  # files of the item it replaces -- their ids, and their size.
  srcs=() as=() olds=() was=()
  if [[ $sub == put ]]; then
    [[ -n $have ]] || die "$name has no file attached any more -- bwu add attaches one"
    pick=$(named "${file_name:-${paths[0]##*/}}")
    if [[ -z $pick || $(wc -l <<<"$pick") -gt 1 ]]; then
      # No file of that very name, or several: picked, never guessed, since
      # the one picked is deleted -- so not even a lone file is taken at once.
      width=$(cut -f2 <<<"$have" | awk '{ if (length > m) m = length } END { print (m > 4 ? m : 4) }')
      rc=0
      pick=$( { printf '\t%-*s\t%s\n' "$width" FILE SIZE
                awk -F'\t' -v w="$width" '{ printf "%s\t%-" w "s\t%s\n", $1, $2, $3 }' <<<"$have"; } |
              fzf --delimiter=$'\t' --with-nth=2.. --nth=1 --tabstop=1 --header-lines=1 \
                  --header="files of $name -- the one ${paths[0]} replaces" \
                  --layout=reverse --height=40% --prompt='replace> ' \
                  --query="$file_name" ) || rc=$?
      case $rc in
        0)   ;;
        1)   die "no file of $name picked -- nothing was changed" ;;
        130) exit 130 ;;
        *)   die "fzf failed" ;;
      esac
      pick=$(awk -F'\t' -v a="${pick%%$'\t'*}" '$1 == a' <<<"$have")
    fi
    srcs=("${paths[0]}")
    as=("$(cut -f2 <<<"$pick")")
    olds=("$(cut -f1 <<<"$pick")")
    was=("$(cut -f3 <<<"$pick")")
  else
    # Every question before the first upload, so that no answer comes too
    # late to change anything.
    for path in "${paths[@]}"; do
      file=${path##*/}
      clash=$(named "$file")
      if [[ -n $clash ]] && ! $force; then
        [[ -t 0 ]] || die "$name has $file already -- --force overwrites it; nothing was changed"
        n=$(wc -l <<<"$clash")
        if (( n == 1 )); then
          size=$(cut -f3 <<<"$clash")
          read -r -p "$name has $file already${size:+ ($size)} -- overwrite it? [y/N] " reply || reply=""
        else
          read -r -p "$name has $n files called $file already -- overwrite them? [y/N] " reply || reply=""
        fi
        if [[ ${reply,,} != y && ${reply,,} != yes ]]; then
          echo "$file left out" >&2
          continue
        fi
      fi
      srcs+=("$path")
      as+=("$file")
      olds+=("$(cut -f1 <<<"$clash" | paste -sd' ')")
      was+=("$(cut -f3 <<<"$clash" | paste -sd'+')")
    done
    (( ${#srcs[@]} )) || { echo "$name: nothing added" >&2; exit 0; }
  fi

  # bw names a file in the vault after the file it is given, so one that is
  # to have another name goes up as a copy by that name, made in a directory
  # only you can read: attachments tend to be keys.
  tmp=$(umask 077 && mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bwu-put.XXXXXX") ||
    die "cannot make a private directory to upload from -- nothing was changed"
  # Only the directory made above: by its own name, and never through a link.
  cleanup() {
    [[ -n ${tmp-} && ${tmp##*/} == bwu-put.?????? && -d $tmp && ! -L $tmp ]] || return 0
    rm -rf -- "${tmp:?}"
  }
  trap cleanup EXIT
  rc=0 wrote=false
  for i in "${!srcs[@]}"; do
    src=${srcs[i]}
    if [[ ${src##*/} != "${as[i]}" ]]; then
      if ! { mkdir -- "$tmp/$i" && cp -- "$src" "$tmp/$i/${as[i]}"; }; then
        echo "bwu: could not copy $src to upload it as ${as[i]} -- nothing was changed" >&2
        rc=1
        break
      fi
      src=$tmp/$i/${as[i]}
    fi

    # The new file up first, the old one deleted after: a failure in between
    # leaves both, never neither. bw answers with the whole item, secrets
    # included -- kept here for the new file's size, and never shown.
    if ! out=$(bw_as "$account" create attachment --file "$src" --itemid "$id" --nointeraction 2>"$tmp/err"); then
      err=$(<"$tmp/err")
      echo "bwu: could not upload ${srcs[i]}: ${err:-bw gave no reason}" >&2
      (( i + 1 == ${#srcs[@]} )) || echo "bwu: not uploaded either: ${srcs[*]:i+1}" >&2
      rc=1
      break
    fi
    wrote=true
    size=$(jq -r --argjson known "$known" --arg n "${as[i]}" '
      [(.attachments // [])[] | select(.fileName == $n and (.id as $i | any($known[]; . == $i) | not))]
      | last | .sizeName // ""' <<<"$out")
    known=$(jq -c '[(.attachments // [])[].id]' <<<"$out")
    unset out

    err=""
    for old in ${olds[i]}; do
      bw_as "$account" delete attachment "$old" --itemid "$id" --nointeraction >/dev/null 2>"$tmp/err" ||
        err=$(<"$tmp/err")
    done
    if [[ -n $err ]]; then
      echo "bwu: ${as[i]} is up, but the old one could not be deleted: $err -- $name has both now" >&2
      rc=1
    elif [[ -n ${olds[i]} ]]; then
      by=""
      [[ ${srcs[i]##*/} == "${as[i]}" ]] || by=" by ${srcs[i]}"
      echo "$name: ${as[i]} replaced$by${was[i]:+ (${was[i]} -> ${size:-?})}" >&2
    else
      echo "$name: ${as[i]} added${size:+ ($size)}" >&2
    fi
  done

  # The cache anew, so that the next get shows the change. Its failure is
  # not passed on as one: a 3 would have bwu unlock and run all of this
  # again, and upload the files twice.
  if $wrote; then
    ( refresh >/dev/null ) || echo "bwu: the cache is behind the vault -- bwu update brings it up to date" >&2
  fi
  exit "$rc"
fi

if $file_mode; then
  # This item's files -- those matching the name, when there is one -- to
  # pick from, unless there is just the one. Tab marks several, ctrl-a all.
  mine=$(awk -F'\t' -v a="$account" -v id="$id" '$1 == a && $2 == id' <<<"$atts")
  width=$(cut -f4 <<<"$mine" | awk '{ if (length > m) m = length } END { print (m > 4 ? m : 4) }')
  rc=0
  picked=$( { printf '\t%-*s\t%s\n' "$width" FILE SIZE
              awk -F'\t' -v w="$width" '{ printf "%s\t%-" w "s\t%s\n", $3, $4, $5 }' <<<"$mine"; } |
            fzf --multi --bind=ctrl-a:select-all,ctrl-d:deselect-all \
                --delimiter=$'\t' --with-nth=2.. --nth=1 --tabstop=1 --header-lines=1 \
                --header="files of $name -- Tab marks several, ctrl-a all" \
                --layout=reverse --height=40% --prompt='file> ' \
                --query="$file_name" --select-1 --exit-0 ) || rc=$?
  case $rc in
    0)   ;;
    1)   die "no file of $name matches '$file_name'" ;;
    130) exit 130 ;;
    *)   die "fzf failed" ;;
  esac
  mapfile -t att_ids < <(cut -f1 <<<"$picked")
  n=${#att_ids[@]}
  field() { awk -F'\t' -v a="$1" -v f="$2" '$3 == a { print $f }' <<<"$mine"; }

  if [[ $file_out == - ]]; then
    (( n == 1 )) || die "$n files cannot all go to stdout -- pick one, or give a directory"
    bw_as "$account" get attachment "${att_ids[0]}" --itemid "$id" --raw || die "could not download $(field "${att_ids[0]}" 4)"
    exit 0
  fi
  if (( n > 1 )) && [[ -n $file_out && ! -d $file_out ]]; then
    die "$n files go into a directory -- give one, or no name for this one"
  fi

  # Where each goes: under its own name -- without any directory a name could
  # smuggle in -- here or in the directory given, or as the one name given.
  files=() sizes=() targets=()
  for att in "${att_ids[@]}"; do
    file=$(field "$att" 4)
    own=${file##*/}
    [[ -n $own && $own != . && $own != .. ]] || own=attachment
    if [[ -z $file_out ]]; then
      target=$own
    elif [[ -d $file_out ]]; then
      target=${file_out%/}/$own
    else
      target=$file_out
    fi
    files+=("$file")
    sizes+=("$(field "$att" 5)")
    targets+=("$target")
  done

  # Every target checked before anything is fetched: the set is saved whole,
  # or not at all.
  dup=$(printf '%s\n' "${targets[@]}" | sort | uniq -d | head -n 1)
  [[ -z $dup ]] || die "two of the files would both be saved as $dup -- fetch them one at a time, with a name each"
  for target in "${targets[@]}"; do
    dir=$(dirname -- "$target")
    [[ -d $dir ]] || die "there is no directory $dir"
    [[ ! -d $target ]] || die "$target is a directory"
    if ! $force && [[ -e $target || -L $target ]]; then
      die "$target is there already -- --force replaces it, or give another name"
    fi
  done

  # Each fetched beside its target, readable by you alone, and all of them
  # before any is moved into place: a download that fails leaves nothing.
  tmps=()
  trap '(( ${#tmps[@]} == 0 )) || rm -f -- "${tmps[@]}"' EXIT
  for i in "${!att_ids[@]}"; do
    dir=$(dirname -- "${targets[i]}")
    tmp=$(umask 077 && mktemp "$dir/.bwu-get.XXXXXX") || die "cannot write in $dir"
    tmps+=("$tmp")
    bw_as "$account" get attachment "${att_ids[i]}" --itemid "$id" --raw > "$tmp" 2>/dev/null ||
      die "could not download ${files[i]} -- is the server reachable? Nothing was saved"
  done
  for i in "${!att_ids[@]}"; do
    if $force; then
      mv -f -- "${tmps[i]}" "${targets[i]}" || die "could not replace ${targets[i]}"
    elif ! mv -n -- "${tmps[i]}" "${targets[i]}" || [[ -e ${tmps[i]} ]]; then
      die "${targets[i]} appeared meanwhile -- left as it was"
    fi
    echo "$name: ${files[i]} saved as ${targets[i]}${sizes[i]:+ (${sizes[i]})}" >&2
  done
  tmps=()
  exit 0
fi
type=$(jq -r '.type' <<<"$item")
user=$(jq -r '(if .type == 1 then .login.username elif .type == 3 then .card.cardholderName else null end) // ""' <<<"$item")
secret=$(jq -r '(if .type == 1 then .login.password elif .type == 2 then .notes
                 elif .type == 3 then .card.number elif .type == 5 then .sshKey.privateKey
                 else null end) // ""' <<<"$item")

site=$(jq -r 'if .type == 1 then (.login.uris // [])[0].uri // "" | sub("^[a-z]+://"; "") | sub("/.*$"; "") else "" end' <<<"$item")

# Into the clipboard, out again after a while -- but only if it is still
# there: anything copied since is left alone.
copy_out() {
  local value=$1
  printf '%s' "$value" | wl-copy --sensitive
  ( sleep "$CLEAR_AFTER"
    [[ $(wl-paste --no-newline 2>/dev/null) == "$value" ]] && wl-copy --clear
  ) >/dev/null 2>&1 &
  disown
}
copied="copied, cleared in ${CLEAR_AFTER}s"

# The summary: one labelled row each, the labels dimmed on a terminal.
dim="" off=""
[[ -t 1 ]] && dim=$'\e[2m' off=$'\e[0m'
row() { printf '%s%-9s%s %s\n' "$dim" "$1" "$off" "$2"; }

# With -u or -p, stdout is the value alone, for pipes and $(...); which item
# it came from goes to the terminal, when there is one.
about() {
  [[ -t 2 ]] || return 0
  echo "$name${site:+ · $site}${1:+: $1}" >&2
}

case $want in
  user)
    [[ -n $user ]] || die "$name has no username"
    if $copy; then
      copy_out "$user"
      about "username $copied"
    else
      about
      printf '%s\n' "$user"
    fi ;;
  secret)
    [[ -n $secret ]] || die "$name has nothing to show for -p"
    if $copy; then
      copy_out "$secret"
      about "$( [[ $type == 2 ]] && echo note || echo password ) $copied"
    else
      about
      printf '%s\n' "$secret"
    fi ;;
  both)
    row item "$name"
    [[ -z $site ]] || row site "$site"
    row vault "$vault"
    case $type in
      1)
        [[ -z $user ]] || row username "$user"
        if [[ -z $secret ]]; then
          row password "(none)"
        elif $copy; then
          copy_out "$secret"
          row password "$copied"
        else
          row password "$secret"
        fi ;;
      3)
        [[ -z $user ]] || row holder "$user"
        if $copy; then
          copy_out "$secret"
          row number "$copied"
        else
          [[ -z $secret ]] || row number "$secret"
          expires=$(jq -r '.card | if .expMonth then "\(.expMonth)/\(.expYear)" else "" end' <<<"$item")
          code=$(jq -r '.card.code // ""' <<<"$item")
          [[ -z $expires ]] || row expires "$expires"
          [[ -z $code ]] || row code "$code"
        fi ;;
      *)
        # A note's text, or a key, as it is -- below the summary, unlabelled,
        # so that it copies out whole.
        [[ -n $secret ]] || die "$name has nothing to show"
        if $copy; then
          copy_out "$secret"
          row "$( [[ $type == 2 ]] && echo note || echo key )" "$copied"
        else
          echo
          printf '%s\n' "$secret"
        fi ;;
    esac ;;
esac
