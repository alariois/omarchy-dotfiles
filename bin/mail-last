#!/usr/bin/env bash
#
# mail-last -- the newest message(s) as JSON on stdout, for piping into
# whatever wants to process them.
#
# Linked to ~/.local/bin/mail-last by setup/install.sh; the accounts it uses
# are in himalaya/config.toml in the same repo.
#
#   mail-last                 # newest across every configured account
#   mail-last -n 5            # five newest, still merged across accounts
#   mail-last -a superhands   # one account only (see `himalaya account list`)
#   mail-last -m Junk         # a named mailbox instead of the inbox
#   mail-last --raw           # bodies as raw RFC822 instead of parsed
#
# Output is always a JSON array, newest first, one object per message:
#
#   [ { "account":  "gmail",
#       "accounts": ["superhands", "gmail"],
#       "envelope": { id, date, from, to, subject, flags, ... },
#       "message":  <whatever `himalaya message read --json` emits> } ]
#
# With no -a it queries every account and merges by date, so "the last mail I
# got" means what it says regardless of which mailbox it landed in. -n is the
# count *after* merging: `-n 5` is the five newest overall, not five per
# account.
#
# One message can legitimately sit in two accounts at once -- mail to
# alari@superhands.ee lands on Zone and Gmail POP-fetches a copy, leaving the
# original -- so merged output is de-duplicated by Message-ID. The surviving
# entry names every account holding it in `accounts`, and `account` is the one
# it was actually read from. Messages with no Message-ID are never folded
# together, since there is nothing to match them on. -a skips all of this:
# with a single account there is nothing to merge.
#
# Without -m no --mailbox is passed at all, so each account resolves its own
# `mailbox.alias.inbox`. That matters because the accounts disagree about the
# name -- Gmail calls it INBOX, Zone calls it Inbox -- and hardcoding either
# breaks the other. With -m the name is passed through verbatim and is the
# caller's problem across accounts.
#
# An account that fails to list is reported on stderr and skipped rather than
# killing the run, so one unreachable server does not cost you the mail you
# can still reach. Exit is non-zero only if nothing was collected at all.
#
# The message half is passed through verbatim rather than reshaped. himalaya
# documents it only as "a minimal header block followed by a per-part walk",
# with no fixed schema, so anything this script asserted about its innards
# would be a guess that breaks on the next release. The envelope half *is*
# schema'd (`himalaya json-schema`), so filter on that and reach into
# .message only for content.
#
# What .message looks like in 2.1, observed rather than promised: text_body
# and html_body are arrays of *indices into* parts, and a part's text lives at
# .body.Text -- so the plain-text body of the newest message is
#
#   mail-last | jq -r '.[0].message as $m | $m.parts[$m.text_body[0]].body.Text'
#
# Treat that path as a convention, not a contract: pin himalaya, or check the
# shape, if a script depends on it.
#
# Reading does not mark anything as seen: `himalaya message read` only sets
# the flag when passed --seen, which this never does. Running it is safe to
# repeat and safe to pipe into something half-written.

set -euo pipefail

count=1
mailbox=()
raw=()
only_account=

die()  { echo "mail-last: $*" >&2; exit 1; }
warn() { echo "mail-last: $*" >&2; }

# Help is the header block above, found by "lines 3..N starting with #" rather
# than a hardcoded range, so editing that header cannot silently truncate it.
usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
  exit "${1:-0}"
}

while (($#)); do
  case $1 in
    -n|--count)   count=${2:-}       ; shift 2 || die "-n needs a number" ;;
    -m|--mailbox) mailbox=(--mailbox "${2:-}"); shift 2 || die "-m needs a mailbox" ;;
    -a|--account) only_account=${2:-}; shift 2 || die "-a needs an account" ;;
    --raw)        raw=(--raw)        ; shift ;;
    -h|--help)    usage 0 ;;
    *)            die "unknown argument: $1  (try --help)" ;;
  esac
done

[[ $count =~ ^[1-9][0-9]*$ ]] || die "count must be a positive integer, got '$count'"

for tool in himalaya jq; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"
done

if [[ -n $only_account ]]; then
  accounts=("$only_account")
else
  mapfile -t accounts < <(himalaya --json account list 2>/dev/null \
                            | jq -r '.accounts[].name') \
    || die "could not read the account list from himalaya"
  ((${#accounts[@]})) || die "no accounts configured"
fi

# Collect envelopes from every account, tagging each with where it came from.
# Fetch `count` from each: the newest overall could all be in one account, so
# fetching fewer risks missing them.
collected='[]'
reachable=0
for acct in "${accounts[@]}"; do
  if ! out=$(himalaya --account "$acct" envelope list \
               "${mailbox[@]}" --page-size "$count" --json 2>/dev/null); then
    warn "skipping '$acct': could not list (try: himalaya -a $acct account check)"
    continue
  fi
  reachable=$((reachable + 1))
  collected=$(jq -c --argjson acc "$collected" --arg a "$acct" \
                '$acc + [(.envelopes // [])[] | {account: $a, envelope: .}]' <<<"$out")
done

((reachable)) || die "no account could be listed"

# Newest first, then fold copies of one message together, then trim to n --
# in that order. Trimming before folding would let a message displace its own
# duplicate out of the window and return fewer distinct messages than asked
# for.
#
# `// ""` keeps a null date from sorting above real ones once reversed, rather
# than jq's default of sorting null to the very front. Null Message-IDs get a
# unique key so they are never folded into each other.
top=$(jq -c --argjson n "$count" '
        sort_by(.envelope.date // "") | reverse
        | group_by(.envelope["message-id"] // "\u0000none-\(.envelope.id)")
        | map(sort_by(.envelope.date // "") | reverse
              | .[0] + {accounts: map(.account)})
        | sort_by(.envelope.date // "") | reverse
        | .[0:$n]' <<<"$collected")

(( $(jq 'length' <<<"$top") )) || die "no messages found"

# Build the output with jq rather than string concatenation, so a subject
# holding a quote or a newline cannot corrupt it.
out='[]'
while IFS=$'\t' read -r acct id; do
  message=$(himalaya --account "$acct" message read "${raw[@]}" \
              "${mailbox[@]}" --json "$id") \
    || die "could not read message $id from '$acct'"
  out=$(jq -c --argjson o "$out" --arg a "$acct" --argjson m "$message" \
          --argjson t "$top" --arg id "$id" \
          '$o + [($t[] | select(.account == $a and .envelope.id == $id)
                  | {account: $a, accounts: .accounts,
                     envelope: .envelope, message: $m})]' <<<'null')
done < <(jq -r '.[] | "\(.account)\t\(.envelope.id)"' <<<"$top")

jq . <<<"$out"
