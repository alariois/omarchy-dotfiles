#!/usr/bin/env bash
#
# bw-session -- the Bitwarden session keys behind bwu: one for each account,
# for every terminal, kept where only root can read them, so each master
# password is typed once and sudo -- a fingerprint -- hands the keys to each
# terminal after that.
#
#   bw-session            # print the key to bw-vault's cache, then a line for
#                         # each account unlocked: its name and session key
#
# Not for running by hand. bwu, the shell function in shell/bashrc, runs it and
# keeps what it prints in that one shell, unexported; the functions there pass
# it to bw-vault and bw-move alone.
#
# The accounts are the ones lib/bw.sh knows, each in a bw data directory of
# its own. For each, first the stored key: sudo reads it, and bw checks it
# still unlocks the account. A key stops working when the account is locked
# (`bw lock`) or logged out, and when it is unlocked again some other way,
# since every unlock makes the previous key worthless. Only then does bw ask
# for that account's master password, and the key that unlock returns is
# stored for the next terminal. An account not logged in is passed over, and
# so is one whose unlock fails: bwu goes on with the others.
#
# The store is a root-only file rather than the keyring: anything running as
# you can read the keyring while you are logged in, and this takes sudo. No
# master password is ever stored. A key opens only this machine's copy of its
# account, and `bw lock` makes it worthless.
#
# Beside the session keys the store keeps an age identity, made new whenever
# an account is unlocked with its password: the key to bw-vault's encrypted
# cache of the vaults. A cache written under one unlock is therefore
# unreadable under the next.

set -euo pipefail

DOTFILES=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/bw.sh
source "$DOTFILES/lib/bw.sh"

# BW_SESSION_STORE is for tests; the real one is root's alone.
STORE=${BW_SESSION_STORE:-/var/lib/omarchy-dotfiles/bw-session-$USER}

die() { echo "bw-session: $*" >&2; exit 1; }

command -v bw >/dev/null || die "bw is not installed -- setup/install.sh installs it"
for tool in jq age-keygen; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done

mapfile -t accounts < <(bw_accounts)
(( ${#accounts[@]} )) || die "no Bitwarden account yet -- bwu login NAME EMAIL adds one"

new_cache_key() { age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-'; }

# Written by root, readable by root alone, in a directory only root can enter.
store() {
  printf '%s\n' "$1" |
    sudo sh -c 'umask 077 && mkdir -p -- "$(dirname -- "$1")" && cat > "$1"' sh "$STORE"
}

# Once up front, so a refused sudo ends this before any password is asked for.
sudo -v || die "sudo refused -- the stored keys are root's to read"

# What is stored: as this prints it. A store from before accounts holds one
# key on its first line, and no names; nothing in it is used.
stored=""
declare -A was=()
cache_key=""
if stored=$(sudo cat -- "$STORE" 2>/dev/null); then
  BW_KEYS=$stored bw_read_keys
  [[ $BW_CACHE_KEY != AGE-SECRET-KEY-* ]] || cache_key=$BW_CACHE_KEY
  for name in "${!BW_KEY[@]}"; do
    was[$name]=${BW_KEY[$name]}
  done
fi

fresh=false
BW_KEY=()
for name in "${accounts[@]}"; do
  if [[ -n ${was[$name]-} ]]; then
    BW_KEY[$name]=${was[$name]}
    bw_unlocks "$name" && continue
    unset 'BW_KEY[$name]'
  fi

  # `bw unlock --check` says "locked" when nobody is logged in at all, so ask
  # bw status which it is.
  status=$(BITWARDENCLI_APPDATA_DIR=$BW_ACCOUNTS/$name bw status 2>/dev/null) || status=""
  case $(jq -r '.status // empty' 2>/dev/null <<<"$status" || true) in
    unauthenticated)
      echo "bw-session: $name is not logged in -- bwu login $name EMAIL" >&2
      continue ;;
    locked|unlocked) ;;
    *)
      echo "bw-session: $name: bw status did not answer -- left locked" >&2
      continue ;;
  esac

  # bw prompts on stderr, so its output here is the key alone. Which account
  # it asks for goes first: bw's prompt does not say.
  email=$(jq -r '.userEmail // empty' <<<"$status")
  echo "Bitwarden: $name${email:+ ($email)}" >&2
  if key=$(BITWARDENCLI_APPDATA_DIR=$BW_ACCOUNTS/$name bw unlock --raw) && [[ -n $key ]]; then
    BW_KEY[$name]=$key
    fresh=true
  else
    echo "bw-session: $name stays locked" >&2
  fi
done
(( ${#BW_KEY[@]} )) || die "no account is unlocked"

if $fresh || [[ -z $cache_key ]]; then
  cache_key=$(new_cache_key) || die "age-keygen failed"
fi
out=$cache_key
while IFS= read -r name; do
  out+=$'\n'"$name ${BW_KEY[$name]}"
done < <(bw_unlocked)

if [[ $out != "$stored" ]] && ! store "$out"; then
  echo "bw-session: could not store the keys -- this terminal is unlocked, the next one asks again" >&2
fi
printf '%s\n' "$out"
