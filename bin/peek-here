#!/bin/bash
#
# SUPER+I: say where SUPER+RETURN and SUPER+SHIFT+F would open, and open
# nothing.
#
# Both keys work out a directory from the focused window -- a tmux pane's cwd,
# a Nautilus window's folder, or whatever Omarchy's own reader makes of it --
# and with a file selected the terminal also comes up with its path pre-typed.
# All of that is invisible until you press the key and get a window. This is
# the same question asked out loud.
#
# It does not work the answer out for itself. term-here and files-here each
# take --print, which reports what they would use and stops before acting, so
# a peek that disagrees with the launch is not possible: same script, same
# branch, same value. Duplicating the resolution here would have been a third
# copy free to drift from the two that matter.
#
# Shaped like msg-otp's toast, and for the same reason -- there is no window to
# put this in, and a keypress that appears to do nothing is worse than no
# keypress.
#
# Over imv the toast leads with the image on screen instead, and that is what
# invoking it copies: the path is the thing you were pointing at, as a
# selected file is in Nautilus. The launch keys know nothing of images -- over
# imv both still open where Omarchy's reader says, which is $HOME -- so the
# toast goes on to say so rather than implying they would follow the image.

set -uo pipefail

# U+F07C, an open folder; U+F03E, a picture, for the imv case.
GLYPH=$'\uf07c'
IMAGE_GLYPH=$'\uf03e'

tilde() { printf '%s' "${1/#"$HOME"/\~}"; }

# The notification daemon renders the body as Pango markup -- verified by
# sending one: <b> and <i> came back bold and italic. These strings are file
# paths, so a name with a < in it would be swallowed as an unclosed tag and
# take the rest of the line with it.
escape() {
  # Each replacement quoted: bare, bash 5.2 reads its & as the text matched.
  local text=${1//&/"&amp;"}
  text=${text//</"&lt;"}
  printf '%s' "${text//>/"&gt;"}"
}

# omarchy-notification-send rather than notify-send, which its own source is
# emphatic about: notify-send parses its argv, so a *filename* like
# `--hint=urgency:byte:2` relayed into a headline stops being text. This talks
# to org.freedesktop.Notifications over busctl, where every value is one typed
# parameter and can never become a flag.
#
# --exec rides along as the toast's default action: clicking it, or pressing
# SUPER+comma ("Dismiss, invoke, or focus last notification"), puts the path
# on the clipboard and dismisses the toast. SUPER+comma invokes rather than
# opening its keyboard picker because this toast has --exec and no buttons;
# SUPER+ALT+comma, which invoked before Omarchy 4.5, now only dismisses.
#
# The shell runs that argv directly, with no shell in between, so a directory
# with a space or a quote in it stays one argument -- which is also why --exec
# has to come last and be written as separate words rather than one quoted
# string.
#
# The clipboard gets the absolute path, not the ~-abbreviated one the toast
# shows: the short form is only meaningful to a shell, and a path is worth
# copying precisely so it can be pasted somewhere that is not one.
toast() { # <headline> <body> [urgency] [path to copy on invoke]
  local -a opts=(-g "$GLYPH") action=()
  [[ -n ${3-} ]] && opts+=(-u "$3")
  # After the two positionals, never before: omarchy-notification-send looks
  # for --exec only once it has taken the headline and description, so an
  # --exec earlier on the line would swallow them as its argv.
  [[ -n ${4-} ]] && action=(--exec wl-copy "$4")
  omarchy-notification-send "${opts[@]}" "$1" "$2" ${action[@]+"${action[@]}"}
}

# The image on screen when the focused window is imv; nothing otherwise.
#
# Read from the window title, whose default -- the one in use: neither
# ~/.config/imv/config nor Omarchy's sets title_text -- is
#   imv - [1/3] [918x1034] [116%] /home/alari/Downloads/image (1).png [scale to fit]
# imv writes the path out absolute even when launched on a relative one, so the
# title alone answers it. The pattern pins the fixed parts at both ends and
# gives the path everything between, greedily, so a name with brackets, a "%]"
# or a double space in it comes through whole -- all three tried, along with
# a literal $HOME and backticks. The trailing label is the scaling mode, one
# of "actual size", "shrink to fit", "scale to fit" or "crop", hence spaces.
#
# The -f test is the backstop: a title_text set some day, an image piped in
# on stdin, or anything else the pattern misreads names no file, and falls
# through to the ordinary peek rather than offering a wrong path.
#
# imv-msg <pid> exec could ask imv for $imv_current_file outright, but the
# command it runs writes nowhere imv-msg can read, so the answer would have to
# come back through a temp file and a wait -- for the string the title
# already carries.
viewed_image() {
  local active class title
  local re='^imv - \[[0-9]+/[0-9]+\] \[[0-9]+x[0-9]+\] \[[0-9]+%\] (/.*) \[[a-z ]+\]$'
  active=$(hyprctl activewindow -j 2>/dev/null) || return 1
  class=$(jq -r '.class // empty' <<<"$active" 2>/dev/null) || return 1
  [[ $class == imv ]] || return 1
  title=$(jq -r '.title // empty' <<<"$active" 2>/dev/null) || return 1
  [[ $title =~ $re && -f ${BASH_REMATCH[1]} ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

image=$(viewed_image) || image=""

printed=$(term-here --print 2>/dev/null) || printed=""
term_dir=${printed%%$'\t'*}
rest=${printed#*$'\t'}
term_line=${rest%%$'\t'*}
selected=${rest#*$'\t'}

files_dir=$(files-here --print 2>/dev/null) || files_dir=""

if [[ -z $image && -z $term_dir && -z $files_dir ]]; then
  toast "Nowhere" "Neither key could read the focused window" critical
  exit 1
fi

# Normally identical. They can differ honestly -- files-here has no Nautilus
# branch, so over a file manager the terminal follows the folder on screen
# while the file manager falls back to Omarchy's answer -- and saying so is
# most of the point of this key.
headline=$term_dir
[[ -n $headline ]] || headline=$files_dir

body=""
# term_line already starts with the space it puts in front of the path, which
# is why there is none after "types".
[[ -n $term_line ]] && body+="Terminal types$(escape "$term_line")"$'\n'
if [[ -n $image ]]; then
  # The headline is a file now, so "here" would point at the wrong thing:
  # both directories get spelled out instead.
  if [[ $files_dir == "$term_dir" ]]; then
    body+="Terminal and Files open $(escape "$(tilde "$term_dir")")"
  else
    body+="Terminal opens $(escape "$(tilde "$term_dir")")"$'\n'
    body+="Files opens $(escape "$(tilde "$files_dir")")"
  fi
elif [[ $files_dir == "$term_dir" ]]; then
  body+="Terminal and Files open here"
else
  body+="Files opens $(escape "$(tilde "$files_dir")")"
fi

# With files selected in Nautilus it is those that get copied, not the folder
# they are in: the toast already names them under "Terminal types", and a file
# is what you were pointing at. Several go one per line. An image in imv is
# the same idea and takes the same place.
copy=$headline
[[ -n $selected ]] && copy=$selected
if [[ -n $image ]]; then
  GLYPH=$IMAGE_GLYPH
  headline=$image
  copy=$image
fi

toast "$(escape "$(tilde "$headline")")" "$body" "" "$copy"
