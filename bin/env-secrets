#!/usr/bin/env bash
#
# env-secrets -- env.yaml, the encrypted file with this machine's accounts.
#
#   env-secrets init          # first time: make the age key, keep it in the
#                             # keyring, create env.yaml and encrypt it
#   env-secrets edit          # open env.yaml decrypted in $EDITOR; saved encrypted
#   env-secrets import-key    # new machine: paste the age key you backed up
#   env-secrets show-key      # print the age key, to keep in a password manager
#   env-secrets check         # encrypted? openable? in step with env.example.yaml?
#   env-secrets get [FILTER]  # the decrypted content as JSON, through jq FILTER
#
# env.yaml lives in the repo root and is gitignored. It is encrypted with sops
# to one age key, so the file can travel anywhere -- another machine, the
# test VM, a backup -- and is useless without the key. The key is one line
# that starts AGE-SECRET-KEY-; keep a copy in your password manager, because
# without it env.yaml cannot be opened again by anyone.
#
# sops encrypts the values and leaves the keys readable, which is what lets
# `check` and the pre-commit hook compare env.yaml's structure with
# env.example.yaml's without decrypting anything.

set -euo pipefail

DOTFILES=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/env.sh
source "$DOTFILES/lib/env.sh"
# shellcheck source=../lib/cloud.sh
source "$DOTFILES/lib/cloud.sh"

usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
  exit "${1:-0}"
}

need() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null || die "$tool is not installed -- setup/install.sh installs it"
  done
}

key_label="omarchy-dotfiles: age key for env.yaml"

store_key() { printf '%s' "$1" | secret-tool store --label="$key_label" "${ENV_KEY_ATTRS[@]}"; }

# The public half, which is what env.yaml is encrypted to.
public_of() { age-keygen -y <<<"$1" 2>/dev/null; }

recipients() { yq -r '.sops.age[].recipient' "$ENV_FILE" 2>/dev/null; }

cmd_init() {
  need age-keygen sops secret-tool yq
  local secret pub
  if env_key_stored; then
    secret=$(secret-tool lookup "${ENV_KEY_ATTRS[@]}")
    cloud_ok "age key already in the keyring -- reusing it"
  else
    secret=$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')
    store_key "$secret"
    cloud_ok "made a new age key and stored it in the keyring"
  fi
  pub=$(public_of "$secret") || die "the stored age key is not a valid key"

  if [[ ! -f $ENV_FILE ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    cloud_ok "created env.yaml from env.example.yaml -- its values are placeholders"
  fi
  chmod 600 "$ENV_FILE"

  if env_is_encrypted; then
    recipients | grep -qxF "$pub" || die "env.yaml is encrypted to a different key -- 'env-secrets import-key' with that one"
    cloud_ok "env.yaml is already encrypted to this key"
  else
    sops --encrypt --age "$pub" --in-place "$ENV_FILE"
    cloud_ok "encrypted env.yaml to $pub"
  fi

  echo
  echo "Next:"
  echo "  env-secrets show-key   # copy the key into your password manager -- do this now"
  echo "  env-secrets edit       # fill in the real accounts"
}

cmd_edit() {
  need sops
  [[ -f $ENV_FILE ]] || die "no env.yaml yet -- 'env-secrets init' first"
  env_is_encrypted || die "env.yaml is not encrypted -- 'env-secrets init' encrypts it"
  env_key_env
  sops "$ENV_FILE"
  # sops rewrote the file, so the next aws-select or az-select regenerates the
  # profiles by itself. What it cannot do is notice the example falling behind.
  local diff
  if ! diff=$(env_structure_diff); then
    echo
    cloud_bad "env.example.yaml no longer matches env.yaml -- update it (with made-up values):"
    sed 's/^/    /' <<<"$diff"
  fi
}

cmd_import_key() {
  need age-keygen secret-tool
  local secret pub
  if [[ -t 0 ]]; then
    read -rsp "Paste the age key (AGE-SECRET-KEY-...): " secret
    echo
  else
    read -r secret
  fi
  [[ $secret == AGE-SECRET-KEY-1* ]] || die "that is not an age secret key -- it starts AGE-SECRET-KEY-1"
  pub=$(public_of "$secret") || die "that key does not parse as an age key"
  if env_is_encrypted && ! recipients | grep -qxF "$pub"; then
    die "this key is not one env.yaml is encrypted to -- nothing stored"
  fi
  store_key "$secret"
  cloud_ok "age key stored in the keyring ($pub)"
  if env_is_encrypted; then
    env_key_env
    sops --decrypt "$ENV_FILE" >/dev/null && cloud_ok "it opens env.yaml"
  fi
}

cmd_show_key() {
  need secret-tool
  [[ -t 1 ]] || die "refusing to print the key anywhere but a terminal"
  env_key_stored || die "no age key in the keyring -- 'env-secrets init' or 'env-secrets import-key'"
  echo "Keep this in your password manager. Anyone with it can read env.yaml."
  echo
  secret-tool lookup "${ENV_KEY_ATTRS[@]}"
  echo
}

# Every way env.yaml can be wrong, each its own line. Exit 1 if any is.
cmd_check() {
  local rc=0 diff errors json
  if [[ ! -f $ENV_FILE ]]; then
    cloud_bad "no env.yaml -- 'env-secrets init' creates one from env.example.yaml"
    exit 1
  fi
  if env_is_encrypted; then
    cloud_ok "env.yaml is encrypted"
  else
    cloud_bad "env.yaml is NOT encrypted -- 'env-secrets init' encrypts it"
    rc=1
  fi
  if json=$(env_json 2>/dev/null); then
    cloud_ok "it can be read with the key available here"
    errors=$(jq -r "$CLOUD_JQ_DEFS $CLOUD_JQ_VALIDATE" <<<"$json")
    if [[ -z $errors ]]; then
      cloud_ok "every AWS and Azure entry has what it needs"
    else
      cloud_bad "some entries are incomplete:"
      sed 's/^/    /' <<<"$errors"
      rc=1
    fi
  else
    cloud_bad "it cannot be read -- no age key here? 'env-secrets import-key'"
    rc=1
  fi
  if diff=$(env_structure_diff); then
    cloud_ok "env.example.yaml has the same structure"
  else
    cloud_bad "env.example.yaml does not match env.yaml:"
    sed 's/^/    /' <<<"$diff"
    rc=1
  fi
  exit $rc
}

cmd_get() {
  need jq
  env_json | jq "${1:-.}"
}

case ${1:-} in
  init)       cmd_init ;;
  edit)       cmd_edit ;;
  import-key) cmd_import_key ;;
  show-key)   cmd_show_key ;;
  check)      cmd_check ;;
  get)        shift; cmd_get "$@" ;;
  -h|--help|help|"") usage 0 ;;
  *)          die "unknown command: $1  (try --help)" ;;
esac
