#!/usr/bin/env bash
#
# aws-env-credentials -- the credential_process behind every AWS profile in
# env.yaml that has access keys.
#
#   aws-env-credentials <profile>
#
# The AWS CLI runs this whenever it needs that profile's keys, and reads the
# JSON it prints. The keys come straight out of the encrypted env.yaml and are
# never written anywhere else -- the alternative, ~/.aws/credentials, is a
# second plaintext copy of every key. Generated into ~/.aws/config by
# lib/cloud.sh; nothing calls it by hand.

set -euo pipefail

DOTFILES=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/env.sh
source "$DOTFILES/lib/env.sh"
# shellcheck source=../lib/cloud.sh
source "$DOTFILES/lib/cloud.sh"

[[ -n ${1:-} ]] || { echo "usage: aws-env-credentials <profile>" >&2; exit 2; }

env_json | jq -e --arg s "$1" "$CLOUD_JQ_DEFS"'
  [.aws[]? | select((.name | slug) == $s)][0]
  | select(.access_key_id and .secret_access_key)
  | {Version: 1, AccessKeyId: .access_key_id, SecretAccessKey: .secret_access_key}' ||
  { echo "aws-env-credentials: no access keys for '$1' in env.yaml" >&2; exit 1; }
