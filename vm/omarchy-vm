#!/usr/bin/env bash
#
# A disposable Omarchy VM, for testing what this repo does to a machine it has
# never touched.
#
# Why this exists: setup/install.sh can be pointed at an empty HOME, and that
# proves the plumbing -- but not the part that matters. The HOOKS lane exists
# to append one managed block to files Omarchy already owns and rewrites, and
# against an empty HOME those files contain nothing but our own block. Whether
# our include still wins below Omarchy's stock content, whether an
# `omarchy update` migration clobbers the block, and whether the post-update
# hook puts it back, are questions only a real Omarchy can answer.
#
# The model is a golden base plus a throwaway overlay:
#
#   install -- boot the ISO and install Omarchy by hand. Slow, done once.
#   reset   -- throw the overlay away and cut a new one off the base. Instant.
#   run     -- boot the overlay.
#
# So "start again from a fresh install" costs a reset, not a reinstall. Nothing
# writes to the base disk after `install`: a qcow2 overlay holds only the
# difference from its backing file, so a reset is one unlink and a ~200KB
# create, and the pristine machine is always exactly one command away.

set -euo pipefail

# Pinned, like the FONTS URL in setup/targets.sh and for the same reason: a
# "latest" that moves under you means two runs of this harness are not the same
# test. Bump it deliberately -- and note that a bump invalidates the base disk,
# since the base IS the installed ISO. `clean base` then `install` re-cuts it.
ISO_VERSION=${OMARCHY_ISO_VERSION:-4.0.2}
ISO_URL=${OMARCHY_ISO_URL:-https://iso.omarchy.org/omarchy-$ISO_VERSION.iso}

# Big files, so not under ~/.config and deliberately not in the repo.
VM_DIR=${OMARCHY_VM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-vm}
ISO="$VM_DIR/omarchy-$ISO_VERSION.iso"
BASE="$VM_DIR/base-$ISO_VERSION.qcow2"
OVERLAY="$VM_DIR/overlay.qcow2"
VARS="$VM_DIR/OVMF_VARS.fd"

# QMP is how this harness talks to a running guest: screenshot its actual
# framebuffer, and ask it to power down properly. Both matter for a machine
# whose whole job is to be booted and thrown away -- SIGTERM on a qcow2 is a
# way to lose the writes you were testing.
QMP_SOCK="$VM_DIR/qmp.sock"
PIDFILE="$VM_DIR/qemu.pid"

# The guest's serial console, as a socket with a logfile alongside: the log
# answers "what happened", the socket answers "and now let me type at it".
#
# A stock Omarchy turns out to run serial-getty@ttyS0 and to put its console
# output here without any kernel cmdline help -- which was worth discovering,
# since it makes the serial console the one way into a guest whose screen is
# black and whose sshd was never enabled.
#
# It was a plain `file` chardev first. That logs but cannot be typed at, which
# is useless precisely when a guest has stopped drawing and the login prompt
# on the other end of it is the only door left.
SERIAL_LOG="$VM_DIR/serial.log"
SERIAL_SOCK="$VM_DIR/serial.sock"

# The LUKS passphrase for the base disk, if it has one.
#
# Omarchy's installer produces an encrypted root, and its unlock prompt goes
# to the SERIAL console at a point where the graphical output is not yet
# active -- so in the QEMU window the machine looks dead, and clicking at it
# does nothing. That is the entire "asks for a password for root access, then
# unable to continue booting and the screen goes blank" symptom: it was always
# a live machine waiting on a prompt nobody could see.
#
# Kept in plaintext, mode 0600, under VM_DIR -- deliberately outside this repo,
# so no .gitignore stands between it and a commit. That is a real trade, and it
# is only defensible because this disk holds a stock Omarchy and a checkout of
# a public dotfiles repo: there is nothing on it worth protecting. Do not put a
# passphrase here that unlocks anything that matters.
LUKS_PASS_FILE="$VM_DIR/luks-passphrase"

# The guest's account name, which is whatever was typed into the installer and
# so is not knowable from here. Remembered in a file rather than demanded as an
# environment variable on every invocation -- and it defaults to $USER only
# because that is the least surprising guess, not because it is likely right.
GUEST_USER_FILE="$VM_DIR/guest-user"

# The guest account's password, for a base `autoinstall` built: generated, so
# nobody has to choose one, and kept beside the disk for logging into the
# guest's desktop by hand. The same plaintext trade as the LUKS passphrase
# above, defensible for the same reason.
GUEST_PASS_FILE="$VM_DIR/guest-password"

# A key of the harness's own, authorized in every base `autoinstall` builds.
# A CI runner has no ~/.ssh to borrow from; locally it sits beside your own
# keys rather than replacing them, so ssh and push work with either.
GUEST_KEY="$VM_DIR/id_ed25519"

# One directory per `test` run: its overlay, firmware vars, serial log and the
# output of every step, so a failure in CI leaves something to read.
TEST_RUNS_DIR="$VM_DIR/test-runs"

# What cryptsetup writes when it wants the passphrase. Matched as a substring,
# because the line accumulates an asterisk per character typed.
LUKS_PROMPT="A password is required to access the root volume"

# Overridable because the display is the first thing to suspect when a guest
# boots but shows nothing: `OMARCHY_VM_DISPLAY=gtk,gl=off` and
# `OMARCHY_VM_DISPLAY=sdl,gl=on` are the two useful comparisons, and having to
# edit this file to make them is friction in exactly the wrong place.
DISPLAY_SPEC=${OMARCHY_VM_DISPLAY:-gtk,gl=on,show-cursor=on,zoom-to-fit=on}

# virtio-vga-gl, and not virtio-gpu-gl, which is the obvious choice and does
# not work here. Both are the same GL-capable virtio-gpu; the -vga- variant
# also exposes a legacy VGA framebuffer. With the pure virtio device this
# guest booted perfectly every time -- a full clean systemd boot with zero
# failures on the serial console -- and displayed nothing at all, because
# accelerated scanout never came up, so Hyprland had no surface to draw on.
#
# What identified it was QMP screendump flipping behaviour: under
# virtio-gpu-gl it returned a readable, uniformly black framebuffer (no GL
# scanout), and under virtio-vga-gl it fails with "no surface" (GL scanout
# live, in a dmabuf QEMU cannot read back). The second is the healthy one.
#
# Symptoms if you ever switch it back: a black screen, and an ACPI power
# button the guest ignores, while `omarchy-vm console` shows a perfectly
# healthy login prompt. The exact failure inside the guest was never
# confirmed -- the machine works, so there was no failed boot left to autopsy.
#
# `virtio-vga` (no GL) is the other fallback worth trying if a host ever
# cannot do GL at all; Hyprland then needs software rendering.
GPU_DEVICE=${OMARCHY_VM_GPU:-virtio-vga-gl}

# Headless: no window, no GL, no audio -- what a CI runner has. Set by
# --headless on autoinstall and test, or OMARCHY_VM_HEADLESS=1, and assumed
# whenever there is no display to open a window on, where the gtk display
# would only fail. The guest then runs on plain virtio-vga, the way Omarchy's
# own ISO tests run in CI, and Hyprland renders in software.
HEADLESS=${OMARCHY_VM_HEADLESS:-0}
headless() { [[ $HEADLESS == 1 || -z ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; }

DISK_SIZE=${OMARCHY_VM_DISK:-60G}
MEM=${OMARCHY_VM_MEM:-8G}
CPUS=${OMARCHY_VM_CPUS:-6}
SSH_PORT=${OMARCHY_VM_SSH_PORT:-2222}

DOTFILES=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
SELF=$(realpath "${BASH_SOURCE[0]}")

# One hash: the last value synced in either direction. See clip_is_echo.
CLIP_STATE="$VM_DIR/clip-last"

die() { echo "omarchy-vm: $*" >&2; exit 1; }
note() { echo "==> $*"; }

# ── Host prerequisites ────────────────────────────────────────────────
#
# Checked rather than installed: this needs sudo, and a tool that reaches for
# root on its own is a tool you cannot read before it runs. The message names
# the exact command instead. setup/install.sh does install its PACKAGES when
# run from a terminal, but setting a machine up is that script's whole job; a
# test harness that finds no QEMU should stop and say so.
require_host() {
  local missing=()
  command -v qemu-system-x86_64 >/dev/null || missing+=(qemu-desktop)
  ovmf_code >/dev/null 2>&1 || missing+=(edk2-ovmf)

  if (( ${#missing[@]} )); then
    echo "omarchy-vm: missing host packages: ${missing[*]}" >&2
    echo "  sudo pacman -S --needed ${missing[*]}" >&2
    echo >&2
    echo "qemu-desktop pulls qemu-hw-display-virtio-gpu-gl, which pulls" >&2
    echo "virglrenderer -- that is what gives the guest real GL, without which" >&2
    echo "Hyprland will not start. edk2-ovmf is the UEFI firmware; Omarchy" >&2
    echo "boots with limine and has no BIOS path." >&2
    exit 1
  fi

  [[ -w /dev/kvm ]] || die "/dev/kvm is not writable -- add yourself to the kvm group and log back in"
}

# OVMF has been renamed more than once (OVMF_CODE.fd, then the 4m variants,
# then a move under x64/). Discover it rather than hardcoding whichever this
# machine happens to have.
ovmf_code() {
  local c
  for c in /usr/share/edk2/x64/OVMF_CODE.4m.fd \
           /usr/share/edk2/x64/OVMF_CODE.fd \
           /usr/share/edk2-ovmf/x64/OVMF_CODE.fd \
           /usr/share/ovmf/x64/OVMF_CODE.fd; do
    [[ -f $c ]] && { echo "$c"; return 0; }
  done
  return 1
}

ovmf_vars_template() {
  local v
  for v in /usr/share/edk2/x64/OVMF_VARS.4m.fd \
           /usr/share/edk2/x64/OVMF_VARS.fd \
           /usr/share/edk2-ovmf/x64/OVMF_VARS.fd \
           /usr/share/ovmf/x64/OVMF_VARS.fd; do
    [[ -f $v ]] && { echo "$v"; return 0; }
  done
  return 1
}

# Per-VM copy, because this is where UEFI keeps its boot entries. Sharing the
# package's read-only template would leave limine's entry nowhere to live, and
# the guest would install fine and then boot to a UEFI shell.
ensure_vars() {
  [[ -f $VARS ]] && return 0
  mkdir -p "$VM_DIR"
  cp "$(ovmf_vars_template)" "$VARS"
  chmod 644 "$VARS"
}

# ── QEMU invocation ───────────────────────────────────────────────────
#
# One function so `install` and `run` cannot drift apart in the ways that
# matter -- same machine type, same firmware, same GPU. A guest that installs
# under one set of hardware and boots under another is a debugging session
# nobody asked for.
qemu_args() {
  local gpu=$GPU_DEVICE display=$DISPLAY_SPEC audio="pipewire,id=snd0"
  if headless; then
    gpu=virtio-vga display=none audio="none,id=snd0"
  fi
  printf '%s\n' \
    -name "omarchy-vm" \
    -machine q35,accel=kvm \
    -cpu host \
    -smp "$CPUS" \
    -m "$MEM" \
    -drive "if=pflash,format=raw,readonly=on,file=$(ovmf_code)" \
    -drive "if=pflash,format=raw,file=$VARS" \
    -device "$gpu" \
    -display "$display" \
    -qmp "unix:$QMP_SOCK,server=on,wait=off" \
    -pidfile "$PIDFILE" \
    -chardev "socket,id=serial0,path=$SERIAL_SOCK,server=on,wait=off,logfile=$SERIAL_LOG,logappend=off" \
    -serial chardev:serial0 \
    -device qemu-xhci,id=usb \
    -device usb-kbd \
    -device usb-tablet \
    -audiodev "$audio" \
    -device intel-hda -device "hda-output,audiodev=snd0" \
    -object "rng-random,filename=/dev/urandom,id=rng0" \
    -device "virtio-rng-pci,rng=rng0" \
    -nic "user,model=virtio-net-pci,hostfwd=tcp::$SSH_PORT-:22"
  # No clipboard channel headless: there is no host clipboard to share.
  headless || printf '%s\n' \
    -device virtio-serial-pci \
    -chardev "qemu-vdagent,id=vdagent,name=vdagent,clipboard=on" \
    -device "virtserialport,chardev=vdagent,name=com.redhat.spice.0"
  # Clipboard sharing, host <-> guest. `qemu-vdagent` is QEMU's own host-side
  # implementation of the SPICE agent protocol, so this needs no SPICE server
  # and no separate viewer -- it works with the plain gtk display above. The
  # guest half is the spice-vdagent package, and without it these three lines
  # are inert rather than harmful.
  #
  # USB HID, not virtio-keyboard-pci/virtio-tablet-pci, which is what this
  # used to be and is why the LUKS prompt could not be answered: virtio input
  # devices need the guest's virtio_input driver, which is not in Omarchy's
  # initramfs, so at the passphrase prompt there is no keyboard at all. Typing
  # into the window produced nothing -- verified from the serial log, where the
  # prompt accumulated exactly zero of the asterisks it prints per keypress.
  #
  # usb-kbd and usb-tablet are driven by generic HID, present at every stage
  # including initramfs. usb-tablet is also absolute-positioned, which is what
  # virtio-tablet was chosen for: the pointer tracks the host's without a grab,
  # where a relative mouse under Wayland drifts away from it.
}

# ── Talking to a running guest ────────────────────────────────────────
#
# QMP is a JSON protocol over a unix socket: greeting, then a mandatory
# qmp_capabilities handshake, then commands. Done in python because the repo
# already declares python3 (setup/targets.sh PACKAGES) and doing it in bash
# would mean hand-rolling framing over socat.

guest_running() {
  local pid
  [[ -f $PIDFILE ]] || return 1
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [[ -n $pid ]] || return 1
  # /proc, not pgrep: `pgrep -f qemu.*omarchy-vm` also matches any shell whose
  # own command line happens to contain that pattern -- including the one
  # asking the question, which made `status` claim a guest was running when
  # none was.
  [[ -d /proc/$pid ]] || return 1
  grep -qa qemu-system "/proc/$pid/cmdline" 2>/dev/null
}

qmp() {
  local cmd=$1 args=${2:-'{}'}
  guest_running || die "no guest running"
  python3 -c '
import json, socket, sys
sock, cmd, args = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(15)
s.connect(sock)
f = s.makefile("rwb")
f.readline()                                    # the greeting
def call(c, a=None):
    f.write((json.dumps({"execute": c, **({"arguments": a} if a else {})}) + "\n").encode())
    f.flush()
    while True:                                 # skip async events
        line = json.loads(f.readline())
        if "return" in line or "error" in line:
            return line
call("qmp_capabilities")
r = call(cmd, args or None)
if "error" in r:
    print(r["error"].get("desc", r["error"]), file=sys.stderr)
    sys.exit(1)
print(json.dumps(r["return"]))
' "$QMP_SOCK" "$cmd" "$args"
}

# The guest's own framebuffer, straight out of QEMU -- which is the point.
# Grabbing the host screen and cropping the QEMU window cannot tell a guest
# that is showing nothing from a host window that has stopped drawing, and
# that was exactly the question when the first boot came up black.
cmd_screenshot() {
  local out=${1:-$VM_DIR/screenshot.png} geo

  # QMP first. It captures the guest rather than the host, which is the whole
  # point -- it cannot confuse "the guest is showing nothing" with "the host
  # window stopped drawing".
  #
  # But it only works while the scanout is a plain surface. A healthy
  # GL-accelerated guest hands QEMU a dmabuf instead, and screendump answers
  # "no surface" -- so on this setup the QMP path succeeds mainly when
  # something is wrong. Hence the fallback rather than a hard failure.
  #
  # QEMU has taken a `format` argument since 7.1; without it this writes PPM,
  # which nothing round here displays.
  if qmp screendump "$(printf '{"filename":"%s","format":"png"}' "$out")" >/dev/null 2>&1; then
    note "wrote $out (guest framebuffer, via QMP)"
    return 0
  fi

  # Falling back to the host window is only reasonable because the host is
  # itself Hyprland -- which this repo already assumes everywhere else.
  command -v grim >/dev/null || die "QMP screendump failed and grim is not installed"
  geo=$(hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
for c in json.load(sys.stdin):
    if c["class"] == "qemu":
        print(f"{c["at"][0]},{c["at"][1]} {c["size"][0]}x{c["size"][1]}")
        break
') || true
  [[ -n ${geo:-} ]] || die "QMP screendump failed and no qemu window found to capture"
  grim -g "$geo" "$out"
  note "wrote $out (host window; QMP said \"no surface\", i.e. GL scanout is live)"
}

# Shut the guest down. Deliberately NOT via QMP system_powerdown, which is
# the obvious call and does nothing on Omarchy: logind ships
# HandlePowerKey=ignore, and Hyprland binds XF86PowerOff to the Omarchy power
# *menu* (default/hypr/bindings/utilities.lua). So an ACPI power button opens
# a dialog nobody is there to click. Verified: the guest sat happily through
# 60s of it, twice, once with a black screen and once with a healthy desktop.
#
# So: ask the guest over ssh, which is a real shutdown. Failing that, say so
# rather than pretending -- `--force` is a separate, explicit decision,
# because it is the equivalent of pulling the plug.
cmd_stop() {
  local force=false
  # Rejected rather than ignored. `stop base-shell` is a natural thing to type
  # when base-shell is what you actually want, and silently treating the extra
  # word as noise answers "no guest running" to a question that was never
  # asked -- which reads like the tool disagreeing with you about the state of
  # the world.
  case ${1:-} in
    --force) force=true ;;
    "")      ;;
    *)       die "unknown argument: $1
  stop takes only --force. Did you mean:  $0 $1" ;;
  esac

  guest_running || { note "no guest running"; return 0; }

  if ! $force; then
    if guest_ssh true 2>/dev/null; then
      # Passwordless first, since it needs no terminal and usually is not
      # available: Omarchy grants the user no NOPASSWD sudo, and plain
      # `systemctl poweroff` over ssh is refused by polkit with "requires
      # interactive authentication". So this used to claim it was asking the
      # guest to shut down while sudo silently waited for a password that
      # could never arrive, and then blamed the guest for still being up.
      note "asking the guest to power off over ssh"
      if ! guest_ssh "sudo -n systemctl poweroff" 2>/dev/null; then
        if [[ -t 0 ]]; then
          # A terminal means sudo can ask. -t gives it one.
          note "the guest needs your password for sudo"
          guest_ssh -t "sudo systemctl poweroff" 2>/dev/null || true
        else
          die "the guest's sudo needs a password and there is no terminal to type it in.
  Run this from a terminal, shut it down from inside the guest, or -- for an
  overlay, where nothing is lost -- '$0 stop --force'."
        fi
      fi
      local i
      for i in $(seq 1 60); do
        guest_running || { note "guest is down"; return 0; }
        sleep 1
      done
      die "still up after 60s -- '$0 stop --force' to pull the plug"
    fi

    die "cannot reach the guest over ssh, and Omarchy ignores the ACPI power
  button by design (logind HandlePowerKey=ignore, and Hyprland binds
  XF86PowerOff to the power menu).

  Either shut it down from inside the guest, enable sshd in it:
    sudo systemctl enable --now sshd
  or discard it outright, which for an overlay costs nothing:
    $0 stop --force && $0 reset"
  fi

  # The honest version of a hard stop. Safe for an overlay by construction --
  # a reset throws it away anyway -- and never something to do to a base disk
  # mid-install.
  note "forcing the guest off (unclean, as though power was cut)"
  qmp quit >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 20); do
    guest_running || { note "guest is down"; return 0; }
    sleep 1
  done
  kill -TERM "$(cat "$PIDFILE")" 2>/dev/null || true
  note "sent SIGTERM as a last resort"
}

# ── Commands ──────────────────────────────────────────────────────────

# Refuse to start a second guest. QEMU already half-enforces this by locking
# the -pidfile, but it does so with "cannot create PID file: Cannot lock pid
# file: Resource temporarily unavailable", which says nothing about why you
# should care -- and the reason is not the pidfile at all. Two guests would
# share this VM_DIR's QMP socket, serial socket and firmware vars, and worse,
# `base-shell` while an overlay is live writes that overlay's backing file
# from underneath it, which is how a qcow2 chain gets corrupted.
# Answer the LUKS prompt on the guest's behalf, once per boot.
#
# Waits for the prompt rather than firing blind: a passphrase typed into
# limine's menu or a getty would be useless at best, and echoed into the serial
# log at worst. One shot on purpose -- if the passphrase is wrong the guest
# asks again, and a watcher that answered every time would sit there feeding a
# bad passphrase to a retry loop.
#
# $1 is how many prompts the log already holds, for re-arming across a
# reboot: QEMU only empties the log when it starts, so after a guest reboots
# the previous boot's prompt is still in it, and matching that would answer a
# prompt that is not there yet -- leaving the real one to wait forever.
# How many unlock prompts this boot's serial log holds so far. Not
# `grep -c ... || echo 0`: grep -c prints 0 AND fails when nothing matches.
luks_prompts_seen() {
  local n
  n=$(grep -ac "$LUKS_PROMPT" "$SERIAL_LOG" 2>/dev/null) || true
  echo "${n:-0}"
}

luks_unlock_watch() {
  local pass i seen=${1:-0} now
  [[ -f $LUKS_PASS_FILE ]] || return 0
  pass=$(< "$LUKS_PASS_FILE")
  [[ -n $pass ]] || return 0
  command -v socat >/dev/null || return 0

  for i in $(seq 1 180); do
    sleep 1
    [[ -S $SERIAL_SOCK ]] || continue
    now=$(grep -ac "$LUKS_PROMPT" "$SERIAL_LOG" 2>/dev/null) || now=0
    (( now > seen )) || continue
    printf '%s\n' "$pass" | socat -u - "unix-connect:$SERIAL_SOCK" 2>/dev/null || true
    return 0
  done
}


# Store the passphrase without it passing through the shell's history or this
# terminal's scrollback -- which is why it is read here rather than taken as an
# argument.
cmd_luks_set() {
  local pass
  mkdir -p "$VM_DIR"
  [[ -t 0 ]] || die "run this from a terminal -- it reads the passphrase interactively"
  read -rsp "  LUKS passphrase for the VM base disk: " pass; echo
  [[ -n $pass ]] || die "empty passphrase, nothing written"
  # umask before the write, so the file is never briefly world-readable.
  ( umask 077; printf '%s\n' "$pass" > "$LUKS_PASS_FILE" )
  note "stored in $LUKS_PASS_FILE (mode $(stat -c%a "$LUKS_PASS_FILE"))"
  note "boots will now answer the unlock prompt themselves"
}

# Answer a prompt that is already waiting, for a guest booted before the
# passphrase was configured.
cmd_unlock() {
  guest_running || die "no guest running"
  [[ -f $LUKS_PASS_FILE ]] || die "no passphrase stored -- run '$0 luks-set' first"
  [[ -S $SERIAL_SOCK ]] || die "no serial socket"
  grep -qa "$LUKS_PROMPT" "$SERIAL_LOG" 2>/dev/null \
    || die "the guest is not asking for a passphrase (nothing matching in $SERIAL_LOG)"
  printf '%s\n' "$(< "$LUKS_PASS_FILE")" | socat -u - "unix-connect:$SERIAL_SOCK"
  note "passphrase sent"
}

require_no_guest() {
  guest_running || return 0
  die "a guest is already running (pid $(cat "$PIDFILE"))

  Shut it down first:
    $0 stop            # over ssh, when sshd is up in the guest
    $0 stop --force    # discard it outright; costs nothing for an overlay"
}

cmd_iso() {
  mkdir -p "$VM_DIR"

  # The stamp records WHICH digest was verified, not merely that something was
  # -- so a bumped ISO_VERSION or a replaced file cannot inherit an older
  # file's blessing. It does not save the re-hash: the check below hashes the
  # ISO and compares, which is the point, since the failure worth catching is
  # a file that was fine when it landed and is not fine now. That costs about
  # 3s warm and under a minute cold on 6GB, against `install` booting from a
  # corrupt image, so it is not a trade worth optimising.
  local stamp="$ISO.verified"

  if [[ -f $ISO && -f $stamp ]] && [[ $(cat "$stamp") == "$(iso_digest)" ]]; then
    note "ISO present and verified: $ISO ($(du -h "$ISO" | cut -f1))"
    return 0
  fi

  if [[ ! -f $ISO ]]; then
    note "fetching $ISO_URL"
  else
    note "resuming $ISO_URL"
  fi
  # --continue-at so a dropped transfer resumes instead of restarting, and
  # --retry so one dropped connection does not end the whole thing. Both earn
  # their place: the first attempt at this ISO died at 51.6% with
  # "curl: (56) Recv failure: Connection timed out", six gigabytes being long
  # enough for that to be the expected case rather than bad luck.
  #
  # --retry-all-errors because plain --retry ignores exactly the class of
  # failure that happened -- a mid-transfer connection drop is not one of the
  # "transient" HTTP statuses curl retries by default.
  #
  # This is also why the checksum below is not optional paranoia: a resumed
  # transfer is precisely the case that can leave a plausible-looking file
  # which is not the ISO.
  curl -fL --continue-at - --progress-bar \
       --retry 5 --retry-delay 3 --retry-all-errors \
       --speed-limit 1024 --speed-time 60 \
       -o "$ISO" "$ISO_URL" \
    || die "download failed -- re-run 'iso' to resume from where it stopped"

  iso_verify "$stamp"
  note "got $(du -h "$ISO" | cut -f1)"
}

iso_digest() { sha256sum "$ISO" | cut -d' ' -f1; }

# Omarchy publishes <iso>.sha256 beside the image. Verify against it, because
# the alternative is discovering a bad download partway through an install.
#
# A missing checksum warns and continues -- it is one more network dependency,
# and the same trade ensure_font makes. A checksum that is present and does NOT
# match is fatal, and takes the file with it: leaving a known-bad 6GB ISO on
# disk only invites the next run to "resume" it into the same place.
iso_verify() {
  local stamp=$1 want got
  want=$(curl -fsSL --max-time 30 "$ISO_URL.sha256" 2>/dev/null | awk 'NR==1{print $1}')

  if [[ -z $want ]]; then
    note "WARNING: no published checksum reachable -- ISO not verified"
    rm -f "$stamp"
    return 0
  fi

  note "verifying against published sha256"
  got=$(iso_digest)
  if [[ $got != "$want" ]]; then
    rm -f "$ISO" "$stamp"
    die "checksum mismatch -- deleted the download
  published $want
  got       $got
  Re-run '$0 iso' to fetch it again."
  fi
  printf '%s\n' "$got" > "$stamp"
  note "checksum ok"
}

cmd_install() {
  require_host
  require_no_guest
  cmd_iso
  ensure_vars

  if [[ -f $BASE ]]; then
    die "base disk already exists: $BASE
  To rebuild it from scratch:  $0 clean base && $0 install
  To get a fresh machine off it (what you usually want):  $0 reset"
  fi

  note "creating base disk ($DISK_SIZE, sparse)"
  qemu-img create -f qcow2 "$BASE" "$DISK_SIZE" >/dev/null

  cat <<'EOF'

  Booting the installer. Do the Omarchy install as you would on metal, then
  shut the guest down -- this disk becomes the golden base and is never
  written to again.

  Three things, because they become part of every fresh machine cut off this
  base and are painful to add later:

    1. Turn disk encryption OFF.
       Omarchy toggles it with Ctrl+C at the "Password>" prompt in the ISO
       configurator. On an encrypted disk every single reset+boot stops dead
       waiting for a passphrase typed by hand, which is the one thing this
       harness exists to avoid. The disk holds a stock Omarchy and a public
       dotfiles repo; there is nothing here to protect.

    2. Install openssh and enable it, in this order:
         omarchy update                     # syncs databases, the Omarchy way
         sudo pacman -S --needed openssh
         sudo systemctl enable --now sshd
         sudo ufw allow 22/tcp              # or nothing gets in
         systemctl is-active sshd           # must print: active

       Every one of these steps earns its place:

       `omarchy update` first, because a freshly installed Omarchy has never
       synced a package database -- plain `pacman -S` fails with "target not
       found: openssh" under a pile of "database file for 'core' does not
       exist". And it rather than `pacman -Syu`, because Omarchy installs a
       pre-transaction hook that refuses direct system upgrades ("Woah
       partner...") and offers OMARCHY_ALLOW_DIRECT_PACMAN=1 as a bypass. Do
       not take the bypass: on a limine+snapper machine it skips the snapshot,
       keyring and migration steps that hook exists to run.

       openssh at all, because Omarchy does not ship it in its package lists;
       it arrives only as a transitive dependency of gcr, with sshd.service
       disabled -- so `systemctl enable sshd` alone can fail with nothing
       obviously wrong. `pacman -Q openssh` first to skip a download.

       And the ufw rule, because Omarchy ships a firewall and turns it on:
       install/config/firewall.sh sets "default deny incoming" and opens only
       LocalSend's 53317 and Docker's DNS. So a perfectly healthy sshd is
       simply unreachable until port 22 is opened. The giveaway is the failure
       mode -- ufw DROPs rather than rejects, so ssh hangs with "Connection
       timed out during banner exchange" instead of "connection refused",
       which is what a port with nothing behind it would say.

       This is what `omarchy-vm push` connects to.

    3. Nothing else. In particular do NOT install this repo: an untouched
       Omarchy is the whole point of the base.

EOF
  # Only pause when there is somebody to pause for. With stdin not a terminal
  # -- run from an agent, a pipe, a CI job -- `read` hits EOF and returns 1,
  # which under `set -e` would abort here rather than boot anything.
  if [[ -t 0 ]]; then
    read -rp "  Press Enter to boot the installer... " _ || true
  else
    note "stdin is not a terminal, booting straight into the installer"
  fi

  local args; mapfile -t args < <(qemu_args)
  qemu-system-x86_64 "${args[@]}" \
    -drive "file=$BASE,if=virtio,format=qcow2,cache=writeback,discard=unmap" \
    -drive "file=$ISO,media=cdrom,readonly=on" \
    -boot order=d

  note "installer exited"
  if [[ ! -f $OVERLAY ]]; then
    note "cutting the first overlay"
    cmd_reset
  fi
}

# Boot the BASE disk read-write, to change what every fresh machine starts
# from. The one command here that can damage something you cannot cheaply
# rebuild, hence the noise.
#
# It exists because the overlay model has a hole: enabling sshd is exactly the
# kind of change that has to live in the base, since `push` needs it and a
# reset would throw it away. Doing it in an overlay means doing it again after
# every reset, which defeats the point.
cmd_base_shell() {
  require_host
  require_no_guest
  [[ -f $BASE ]] || die "no base disk yet -- run '$0 install' first"
  ensure_vars

  cat <<EOF

  This boots the GOLDEN BASE read-write. Changes here become part of every
  machine '$0 reset' hands you from now on.

  What belongs in here:
    sudo systemctl enable --now sshd     # so '$0 push' can reach the guest

  What does not: this repo. An untouched Omarchy is what makes the base
  worth having.

  Shut down from inside the guest when you are done -- Omarchy ignores the
  ACPI power button, so '$0 stop' cannot do it for you unless sshd is up.

EOF
  if [[ -t 0 ]]; then
    read -rp "  Press Enter to boot the base read-write, Ctrl-C to bail... " _ || true
  else
    note "stdin is not a terminal, booting the base read-write"
  fi

  arm_helpers

  local args; mapfile -t args < <(qemu_args)
  qemu-system-x86_64 "${args[@]}" \
    -drive "file=$BASE,if=virtio,format=qcow2,cache=writeback,discard=unmap"

  note "base disk closed -- '$0 reset' to cut a fresh overlay off the new state"
}

# The sudoers drop-in prep-base writes in the guest. A file of its own, so it
# is obvious where it came from and one `rm` undoes it.
GUEST_SUDOERS=/etc/sudoers.d/90-omarchy-vm

# Wait for the guest's sshd by reading its banner and hanging up -- never by
# logging in. Polling with real logins before the guest has our key is a failed
# authentication every few seconds, and sshd's PerSourcePenalties counts them.
# Every connection arrives from QEMU's one NAT address, so it ends up refusing
# all of them with "Not allowed at this time", which is how the first
# unattended run locked itself out.
wait_for_sshd() {
  local i banner
  for i in $(seq 1 60); do
    guest_running || return 1
    banner=$(timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$SSH_PORT && head -c 7 <&3" 2>/dev/null) || true
    [[ $banner == SSH-2.0 ]] && return 0
    sleep 5
  done
  return 1
}

# Can we log in with the key alone? Its own option list rather than
# guest_ssh plus overrides, because ssh keeps the FIRST value it sees for an
# option: appended to ssh_opts, ControlPath=none loses to the shared socket,
# and a master connection opened with a password would answer yes for a key
# that was never installed.
key_login_works() {
  local ids; mapfile -t ids < <(ssh_identity_opts)
  ssh -p "$SSH_PORT" \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
      -o BatchMode=yes -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 \
      "${ids[@]}" "$(guest_user)@localhost" true 2>/dev/null
}

# `sudo -v` too, and not only because a test should be thorough: the 4.0.2
# `omarchy update` calls it, and sudo answers -v with a password prompt unless
# EVERY rule for the user is NOPASSWD -- which the installer's own drop-in
# (`<user> ALL=(ALL) ALL`) never is. So a guest could pass `sudo -n true` and
# still stop an unattended update dead at "[sudo] password for test".
sudo_is_passwordless() {
  guest_ssh 'sudo -k; sudo -n true && sudo -n -v' 2>/dev/null
}

# The root half of passwordless sudo, as one script for `sudo bash -c`: write
# the drop-in, have visudo check it, and only then install it. A drop-in with
# a syntax error breaks sudo outright, in a base with no other way back to
# root. verifypw=any is what makes `sudo -v` count the NOPASSWD rule; see
# sudo_is_passwordless.
guest_sudoers_script() {
  local content="$1 ALL=(ALL:ALL) NOPASSWD: ALL"$'\n'"Defaults:$1 verifypw=any"
  printf '%s' "t=\$(mktemp) && printf '%s\\n' $(printf %q "$content") > \"\$t\" && visudo -c -q -f \"\$t\" && install -m 0440 -o root -g root \"\$t\" $GUEST_SUDOERS; s=\$?; rm -f \"\$t\"; exit \$s"
}

# However prep-base ends, a guest left running is the BASE, open read-write --
# never something to leave unremarked, or to reset an overlay underneath.
prep_base_exit() {
  disarm_helpers
  guest_running || return 0
  echo >&2
  echo "omarchy-vm: the guest is still running on the BASE disk, read-write." >&2
  echo "  Shut it down from inside the guest (or '$0 stop' once sudo is passwordless)," >&2
  echo "  then '$0 reset' so the overlay is cut off the changed base." >&2
}

# Is the running guest the base, open read-write? True for base-shell and for
# a prep-base that stopped partway; false for an overlay, and false for
# throwaway, whose -snapshot would silently discard anything prep-base wrote.
guest_on_base_rw() {
  local cmdline
  guest_running || return 1
  cmdline=$(tr '\0' '\n' < "/proc/$(cat "$PIDFILE")/cmdline" 2>/dev/null) || return 1
  grep -q "file=$BASE," <<< "$cmdline" && ! grep -qx -- -snapshot <<< "$cmdline"
}

# Make the base drivable without a person: your ssh key, and passwordless sudo
# for the guest account. With both, push, install.sh's package installs and
# stop all run unattended on every machine a reset hands back.
#
# Both have to live in the base -- written to an overlay they are gone at the
# next reset -- which makes this the one command besides base-shell that writes
# the base. So it asks first, and touches nothing but the guest account's
# authorized_keys and one sudoers drop-in. Passwordless sudo is fine here only
# because the guest is disposable and holds nothing worth protecting.
cmd_prep_base() {
  local yes=false
  case ${1:-} in
    --yes) yes=true ;;
    "") ;;
    *) die "unknown argument: $1 (prep-base takes only --yes)" ;;
  esac
  require_host
  # A guest already on the base read-write is picked up rather than refused:
  # that is what a run cut short by a mistyped password leaves behind, and
  # making you shut it down by hand just to boot it again helps nobody.
  local attach=false
  if guest_on_base_rw; then
    attach=true
  else
    require_no_guest
  fi
  [[ -f $BASE ]] || die "no base disk yet -- run '$0 install' first"
  $yes || [[ -t 0 ]] || die "run this from a terminal -- it may ask for the guest password (--yes skips the confirmation)"
  command -v ssh-copy-id >/dev/null || die "ssh-copy-id not installed"
  ensure_vars

  local user; user=$(guest_user)
  cat <<EOF

  This $($attach && echo "uses the running" || echo "boots the") GOLDEN BASE read-write and adds two things to it, for the
  guest account '$user':

    ~/.ssh/authorized_keys          your ssh key, so ssh and push need no password
    $GUEST_SUDOERS   passwordless sudo, so install.sh and stop run unattended

  Have the guest's password ready: ssh-copy-id asks for it, then sudo asks
  once more. Afterwards the guest powers off and a fresh overlay is cut.

EOF
  $yes || read -rp "  Press Enter to continue, Ctrl-C to bail... " _

  trap prep_base_exit EXIT
  # Exit on Ctrl-C rather than carry on: a trap that only cleans up leaves bash
  # running the next command, so the wait loops below would shrug it off.
  trap 'exit 130' INT TERM

  local qemu_pid="" i
  if $attach; then
    note "a guest is already running on the base read-write -- continuing with it"
  else
    # The LUKS watcher only, not arm_helpers: the clipboard autostart polls with
    # real ssh logins, which is the penalty problem wait_for_sshd exists to avoid.
    luks_unlock_watch &
    HELPER_PIDS+=($!)

    # setsid, so Ctrl-C at one of the password prompts stops this script and
    # not the guest. Without it QEMU shares our process group, takes the same
    # SIGINT, and the base disk loses power while it is open read-write.
    local args; mapfile -t args < <(qemu_args)
    note "booting the base read-write"
    setsid qemu-system-x86_64 "${args[@]}" \
      -drive "file=$BASE,if=virtio,format=qcow2,cache=writeback,discard=unmap" &
    qemu_pid=$!

    for i in $(seq 1 20); do
      guest_running && break
      sleep 0.5
    done
    guest_running || die "qemu exited before the guest started"
  fi

  note "waiting for the guest's sshd (an encrypted disk unlocks itself if 'luks-set' was run)"
  if ! wait_for_sshd; then
    guest_running || die "the guest exited before its sshd answered"
    die "the guest's sshd never answered on port $SSH_PORT -- look at its window, or '$0 console'"
  fi

  if key_login_works; then
    note "ssh key already authorized"
  else
    [[ -t 0 ]] || die "the guest does not take your key yet, and there is no terminal to type its password in"
    note "installing your ssh key -- enter the guest password for '$user'"
    local opts; mapfile -t opts < <(ssh_opts)
    ssh-copy-id "${opts[@]}" "$user@localhost" || die "ssh-copy-id failed"
    key_login_works || die "the key was copied, but logging in with it still fails"
    note "ssh key works"
  fi

  local root_script; root_script=$(guest_sudoers_script "$user")
  if sudo_is_passwordless; then
    note "passwordless sudo already set up"
  elif guest_ssh 'sudo -k; sudo -n true' 2>/dev/null; then
    # A drop-in from before verifypw: sudo runs without a password already, so
    # the upgrade needs none either.
    note "updating $GUEST_SUDOERS so 'sudo -v' needs no password either"
    guest_ssh "sudo -n bash -c $(printf %q "$root_script")" || die "could not update $GUEST_SUDOERS"
    sudo_is_passwordless || die "$GUEST_SUDOERS is updated, but sudo -v still wants a password"
    note "passwordless sudo works"
  else
    [[ -t 0 ]] || die "sudo in the guest needs the password, and there is no terminal to type it in"
    note "setting up passwordless sudo -- sudo will ask for the guest password"
    guest_ssh -t "sudo bash -c $(printf %q "$root_script")" || die "could not install $GUEST_SUDOERS"
    sudo_is_passwordless || die "$GUEST_SUDOERS is in place, but sudo still wants a password"
    note "passwordless sudo works"
  fi

  note "powering the guest off"
  guest_ssh 'sudo -n systemctl poweroff' >/dev/null 2>&1 || true
  for i in $(seq 1 90); do
    guest_running || break
    sleep 1
  done
  guest_running && die "the guest is still up after 90s"
  [[ -n $qemu_pid ]] && { wait "$qemu_pid" 2>/dev/null || true; }

  cmd_reset
  note "done: every reset now gives a guest that ssh, push, install.sh and stop can drive unattended"
}

# ── Unattended install ────────────────────────────────────────────────
#
# The Omarchy ISO installs itself with no keyboard when a drive labelled
# `cidata` (cloud-init's NoCloud label) carries the configurator's own output
# files: it copies them into /root, skips the wizard, installs, and reboots
# into the new system. With an authorized_keys file on the drive it also
# enables sshd and opens port 22 -- the two steps `install` has to ask for.
# See "Autoinstall" in github.com/omacom-io/omarchy-iso's README; the loader
# is configs/airootfs/usr/local/bin/omarchy-cidata-load.

# The configurator's two required files, plus the optional ones we want.
#
# Field for field what the 4.0.2 configurator writes (configs/airootfs/root/
# configurator at the ISO's build), with the answers filled in. So this is
# pinned to ISO_VERSION like everything else that touches the installer, and a
# bump means comparing it with that release's configurator. Upstream's own
# test template has since moved to the linux-omarchy kernel, which the 4.0.2
# installer does not default to -- it writes plain `linux`, and that is what a
# hand-installed 4.0.2 base runs.
write_cidata() {
  local dir=$1 disk_bytes=$2 user=$3 pass=$4
  local mib=$((1024 * 1024)) gib=$((1024 * 1024 * 1024)) hash
  # The configurator's sizing: 1MiB gap, 2GiB ESP, the rest btrfs minus the
  # GPT backup reserve, on a size rounded down to a whole MiB.
  local boot_start=$mib boot_size=$((2 * gib))
  local main_start=$((boot_start + boot_size))
  local main_size=$((disk_bytes / mib * mib - main_start - mib))

  hash=$(openssl passwd -6 "$pass")
  jq -n --arg hash "$hash" --arg user "$user" '{
    root_enc_password: $hash,
    users: [ { enc_password: $hash, groups: [], sudo: true, username: $user } ]
  }' > "$dir/user_credentials.json"

  jq -n --argjson boot_start "$boot_start" --argjson boot_size "$boot_size" \
        --argjson main_start "$main_start" --argjson main_size "$main_size" '
    def extent($v): { sector_size: { unit: "B", value: 512 }, unit: "B", value: $v };
    {
      app_config: null,
      "archinstall-language": "English",
      auth_config: {},
      audio_config: { audio: "pipewire" },
      bootloader_config: { bootloader: "Limine", uki: false, removable: false },
      custom_commands: [],
      omarchy_install: {
        mode: "full_disk",
        defer_provisioning: false,
        target_mount: "/mnt",
        boot: { esp_mount: "/boot", esp_path: "/EFI/limine", efi_binary: "limine_x64.efi", enable_fallback: true },
        storage: { kernel: "linux" }
      },
      disk_config: {
        config_type: "default_layout",
        device_modifications: [ {
          device: "/dev/vda",
          partitions: [
            { btrfs: [], dev_path: null, flags: [ "boot", "esp" ], fs_type: "fat32",
              mount_options: [], mountpoint: "/boot",
              obj_id: "ea21d3f2-82bb-49cc-ab5d-6f81ae94e18d",
              size: extent($boot_size), start: extent($boot_start),
              status: "create", type: "primary" },
            { btrfs: [ { mountpoint: "/", name: "@" },
                       { mountpoint: "/home", name: "@home" },
                       { mountpoint: "/var/log", name: "@log" },
                       { mountpoint: "/var/cache/pacman/pkg", name: "@pkg" } ],
              dev_path: null, flags: [], fs_type: "btrfs",
              mount_options: [ "compress=zstd" ], mountpoint: null,
              obj_id: "8c2c2b92-1070-455d-b76a-56263bab24aa",
              size: extent($main_size), start: extent($main_start),
              status: "create", type: "primary" }
          ],
          wipe: true
        } ]
      },
      hostname: "omarchy-vm",
      kernels: [ "linux" ],
      network_config: { type: "iso" },
      ntp: true,
      parallel_downloads: 8,
      script: null,
      services: [],
      swap: true,
      timezone: "UTC",
      locale_config: { kb_layout: "us", sys_enc: "UTF-8", sys_lang: "en_US.UTF-8" },
      mirror_config: {
        custom_repositories: [],
        custom_servers: [
          { url: "https://mirror.omarchy.org/$repo/os/$arch" },
          { url: "https://mirror.rackspace.com/archlinux/$repo/os/$arch" },
          { url: "https://geo.mirror.pkgbuild.com/$repo/os/$arch" }
        ],
        mirror_regions: {},
        optional_repositories: []
      },
      packages: [ "base-devel", "git", "omarchy-keyring", "omarchy-settings", "omarchy" ],
      profile_config: { gfx_driver: null, greeter: null, profile: {} },
      version: "3.0.9"
    }' > "$dir/user_configuration.json"

  echo "omarchy-vm" > "$dir/user_full_name.txt"
  echo "omarchy-vm@localhost" > "$dir/user_email_address.txt"
  echo "false" > "$dir/user_encrypt_installation.txt"

  # The harness key always; your own public keys too, so `ssh` works for you
  # as well as for the test.
  cat "$GUEST_KEY.pub" > "$dir/authorized_keys"
  local pub
  for pub in ~/.ssh/id_*.pub; do
    [[ -f $pub ]] && cat "$pub" >> "$dir/authorized_keys"
  done
  return 0
}

# Build the base with nobody at the keyboard: what `install` does by hand,
# plus what `prep-base` adds afterwards. Unencrypted on purpose -- an
# encrypted autoinstall stops at the LUKS prompt on first boot, which is the
# one thing an unattended install cannot have.
#
# The disk is built under a staging name and promoted only after a clean
# shutdown, so a failed or interrupted install can never pass for a base.
cmd_autoinstall() {
  case ${1:-} in
    --headless) HEADLESS=1 ;;
    "") ;;
    *) die "unknown argument: $1 (autoinstall takes only --headless)" ;;
  esac
  require_host
  require_no_guest
  local tool
  for tool in bsdtar openssl jq ssh-keygen; do
    command -v "$tool" >/dev/null || die "$tool not installed -- autoinstall needs it to build the cidata drive"
  done
  [[ -f $BASE ]] && die "base disk already exists: $BASE
  To rebuild it unattended:  $0 clean base && $0 autoinstall"
  cmd_iso

  [[ -f $GUEST_KEY ]] || ssh-keygen -q -t ed25519 -N "" -C "omarchy-vm" -f "$GUEST_KEY"
  # Not $USER: in CI that is often root or a runner name, and a username the
  # installer rejects is a long way to find out. Remembered like `user` would.
  if [[ -z ${OMARCHY_VM_USER:-} && ! -f $GUEST_USER_FILE ]]; then
    printf 'test\n' > "$GUEST_USER_FILE"
  fi
  local user pass
  user=$(guest_user)
  pass=$(openssl rand -hex 12)
  ( umask 077; printf '%s\n' "$pass" > "$GUEST_PASS_FILE" )

  local building="$BASE.building" work cidata="$VM_DIR/cidata.iso"
  rm -f "$building"
  qemu-img create -f qcow2 "$building" "$DISK_SIZE" >/dev/null
  # Fresh firmware vars: the install writes its boot entry into them, and they
  # belong to this base from here on, exactly as after `install`.
  rm -f "$VARS"
  ensure_vars

  work=$(mktemp -d "$VM_DIR/cidata.XXXXXX")
  write_cidata "$work" "$(qemu-img info --output=json "$building" | jq '."virtual-size"')" "$user" "$pass"
  # ISO 9660 from bsdtar, because libarchive is on every Arch machine (pacman
  # links it) where mtools and genisoimage are not. Rock Ridge keeps the long
  # file names; blkid reads the volume id as LABEL=cidata.
  bsdtar --format iso9660 --options 'iso9660:volume-id=cidata,iso9660:rockridge,iso9660:joliet' \
         -cf "$cidata" -C "$work" .
  rm -rf "$work"

  trap autoinstall_exit EXIT
  trap 'exit 130' INT TERM

  # Disk first, ISO second, by bootindex: the empty disk falls through to the
  # installer, and once the install has written a bootloader the reboot comes
  # up from the disk instead of starting the install over.
  local args; mapfile -t args < <(qemu_args)
  note "installing Omarchy $ISO_VERSION unattended$(headless && echo ", headless") -- typically 10-20 minutes"
  setsid qemu-system-x86_64 "${args[@]}" \
    -drive "file=$building,if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap" \
    -device virtio-blk-pci,drive=disk0,bootindex=1 \
    -drive "file=$ISO,if=none,id=cd0,media=cdrom,readonly=on" \
    -device ide-cd,drive=cd0,bootindex=2 \
    -drive "file=$cidata,if=none,id=cd1,media=cdrom,readonly=on" \
    -device ide-cd,drive=cd1 \
    >"$VM_DIR/autoinstall-qemu.log" 2>&1 &
  local qemu_pid=$! i

  for i in $(seq 1 20); do
    guest_running && break
    sleep 0.5
  done
  guest_running || die "qemu exited before the installer started -- see $VM_DIR/autoinstall-qemu.log"

  # Done means the INSTALLED system lets our key in: the live ISO has no such
  # user, so a key login cannot succeed until the install has finished and
  # rebooted. Every 15s keeps well under sshd's penalty threshold.
  local start=$SECONDS timeout=${OMARCHY_VM_INSTALL_TIMEOUT:-2700} last_note=0
  until key_login_works; do
    guest_running || die "the guest exited during the install -- see $SERIAL_LOG"
    (( SECONDS - start < timeout )) \
      || die "the install did not finish within $((timeout / 60)) minutes -- '$0 screenshot' shows where it stopped"
    if (( SECONDS - last_note >= 60 )); then
      note "  ... installing ($(( (SECONDS - start) / 60 ))m)"
      last_note=$SECONDS
    fi
    sleep 15
  done
  note "installed in $(( (SECONDS - start) / 60 ))m -- the new system is up and takes the key"

  # What prep-base does by hand, without the hand: the password is ours, so
  # sudo -S takes it on stdin. One root shell, so it is asked for once.
  printf '%s\n' "$pass" | guest_ssh "sudo -S -p '' bash -c $(printf %q "$(guest_sudoers_script "$user")")" \
    || die "could not install $GUEST_SUDOERS in the new system"
  sudo_is_passwordless || die "$GUEST_SUDOERS is in place, but sudo still wants a password"
  note "passwordless sudo set up"

  note "powering the guest off"
  guest_ssh 'sudo -n systemctl poweroff' >/dev/null 2>&1 || true
  for i in $(seq 1 90); do
    guest_running || break
    sleep 1
  done
  guest_running && die "the guest is still up after 90s"
  wait "$qemu_pid" 2>/dev/null || true

  mv "$building" "$BASE"
  # The drive carries the password hash; nothing needs it once installed.
  rm -f "$cidata"
  trap - EXIT INT TERM
  note "base ready: $BASE"
  cmd_reset
}

# A failed autoinstall leaves a half-installed disk under its staging name and
# an installer that would otherwise run on. Neither is worth keeping running:
# the next attempt starts over from an empty disk.
autoinstall_exit() {
  if guest_running; then
    note "stopping the unfinished install"
    qmp quit >/dev/null 2>&1 || kill -TERM "$(cat "$PIDFILE")" 2>/dev/null || true
  fi
  rm -f "$VM_DIR/cidata.iso"
}

# ── End-to-end test ───────────────────────────────────────────────────
#
# Everything from nothing, unattended, with a verdict: what a CI job runs.
# Host prerequisites, the ISO, the base (built by autoinstall if there is
# none), then a throwaway machine off that base that gets `omarchy update`,
# this working tree, install.sh twice and doctor.sh, and has to show the
# post-update hook repairing a clobbered block.
#
# Output is TAP -- "ok N - ..." / "not ok N - ..." -- which CI systems read
# natively. Exit 0 when every check passed, 1 when one failed, 2 when the
# test could not get far enough to judge anything.
#
# Each run gets its own directory under TEST_RUNS_DIR with its own overlay,
# firmware vars, serial log and QMP socket, so it never touches the overlay
# `run` uses. It still needs the ssh port, so it refuses to start beside a
# running guest.

T_N=0
T_FAILED=0
t_ok()   { T_N=$((T_N + 1)); echo "ok $T_N - $*"; }
t_fail() {
  local what=$1 line; shift
  T_N=$((T_N + 1)); T_FAILED=$((T_FAILED + 1))
  echo "not ok $T_N - $what"
  for line in "$@"; do echo "  # $line"; done
}
# TAP's own word for "cannot continue".
t_bail() { echo "Bail out! $*"; exit 2; }
t_elapsed() { printf '%dm%02ds' $(( (SECONDS - $1) / 60 )) $(( (SECONDS - $1) % 60 )); }

# The last lines of a step's log, as TAP diagnostics.
t_tail() { tail -n "${2:-15}" "$1" 2>/dev/null | tr -d '\r'; }

cmd_test() {
  local keep=false
  while (( $# )); do
    case $1 in
      --headless) HEADLESS=1 ;;
      --keep)     keep=true ;;
      *) die "unknown argument: $1 (test takes --headless and --keep)" ;;
    esac
    shift
  done

  local run_dir; run_dir="$TEST_RUNS_DIR/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$run_dir"
  exec > >(tee -a "$run_dir/test.log") 2>&1

  echo "TAP version 13"
  echo "# omarchy-vm test -- $DOTFILES"
  echo "# run directory: $run_dir"

  local t0=$SECONDS
  ( require_host ) >"$run_dir/host.log" 2>&1 \
    || { cat "$run_dir/host.log"; t_bail "the host cannot run the VM"; }
  guest_running && t_bail "a guest is already running -- '$0 stop' it first; the test needs port $SSH_PORT"
  t_ok "host can run the VM (qemu, OVMF, writable /dev/kvm)"

  t0=$SECONDS
  ( cmd_iso ) >"$run_dir/iso.log" 2>&1 \
    || { t_tail "$run_dir/iso.log"; t_bail "could not get a verified Omarchy $ISO_VERSION ISO"; }
  t_ok "Omarchy $ISO_VERSION ISO present and verified ($(t_elapsed $t0))"

  if [[ -f $BASE ]]; then
    t_ok "base disk exists ($(basename "$BASE"))"
  else
    t0=$SECONDS
    echo "# no base disk -- building one unattended, this takes a while"
    # pipefail carries the install's status through tee and sed.
    if ! ( cmd_autoinstall ) 2>&1 | tee "$run_dir/autoinstall.log" | sed -u 's/^/# /' || [[ ! -f $BASE ]]; then
      t_bail "the unattended install failed -- see $run_dir/autoinstall.log"
    fi
    t_ok "base installed unattended ($(t_elapsed $t0))"
  fi

  # From here on this run's own files: nothing below touches `run`'s overlay.
  [[ -f $VARS ]] || t_bail "no firmware vars beside the base ($VARS) -- '$0 clean base' and let the test rebuild it"
  local overlay="$run_dir/disk.qcow2"
  qemu-img create -f qcow2 -b "$BASE" -F qcow2 "$overlay" >/dev/null
  cp "$VARS" "$run_dir/OVMF_VARS.fd"
  VARS="$run_dir/OVMF_VARS.fd"
  QMP_SOCK="$run_dir/qmp.sock"
  PIDFILE="$run_dir/qemu.pid"
  SERIAL_LOG="$run_dir/serial.log"
  SERIAL_SOCK="$run_dir/serial.sock"
  TEST_KEEP=$keep TEST_OVERLAY=$overlay
  trap test_exit EXIT
  trap 'exit 130' INT TERM

  # A hand-installed base may be encrypted; answer its prompt if we can.
  luks_unlock_watch &
  HELPER_PIDS+=($!)

  t0=$SECONDS
  local args; mapfile -t args < <(qemu_args)
  setsid qemu-system-x86_64 "${args[@]}" \
    -drive "file=$overlay,if=none,id=disk0,format=qcow2,cache=writeback,discard=unmap" \
    -device virtio-blk-pci,drive=disk0,bootindex=1 \
    >"$run_dir/qemu.log" 2>&1 &
  local i
  for i in $(seq 1 20); do guest_running && break; sleep 0.5; done
  guest_running || { t_tail "$run_dir/qemu.log"; t_bail "qemu did not start"; }
  wait_for_sshd || { t_tail "$SERIAL_LOG" 20; t_bail "the guest's sshd never answered"; }
  for i in $(seq 1 12); do key_login_works && break; sleep 5; done
  key_login_works || t_bail "the guest does not accept the key -- a hand-installed base needs '$0 prep-base'"
  t_ok "fresh machine boots and accepts the ssh key ($(t_elapsed $t0))"

  sudo_is_passwordless || t_bail "sudo in the guest wants a password -- a hand-installed base needs '$0 prep-base'"
  t_ok "passwordless sudo in the guest"

  # The first thing anyone does on a fresh Omarchy, and not optional here: a
  # fresh install has never synced a package database, so install.sh could
  # not install a single package without it. -y is omarchy-update's promise
  # not to ask anything.
  t0=$SECONDS
  # Through a login shell, like everything the test runs as you: Omarchy's
  # environment (OMARCHY_PATH, its bin on PATH) comes from ~/.bashrc, which a
  # bare ssh command never reads -- and omarchy-update-dev dies on the unset
  # variable.
  #
  # OMARCHY_UPDATE_LOGGED=1 skips omarchy-update's `script` wrapper, which is
  # what makes -y actually unattended. The wrapper gives the update a pty, and
  # omarchy-update-orphan-pkgs decides whether to ask by checking for a
  # terminal -- not for -y -- so with orphans present it sat at a gum confirm
  # for good (Omarchy 4.0.4 still does). Without the pty it reports them and
  # moves on. The wrapper only keeps a log, and this keeps its own.
  if guest_ssh "bash -lc 'OMARCHY_UPDATE_LOGGED=1 timeout 2700 omarchy update -y </dev/null'" >"$run_dir/omarchy-update.log" 2>&1; then
    t_ok "omarchy update -y ($(t_elapsed $t0))"
  else
    t_fail "omarchy update -y" "$(t_tail "$run_dir/omarchy-update.log")"
  fi
  # A new kernel has no modules for the one still running; boot into it the
  # way the person on the other end of an update would.
  #
  # The kernel image, not the modules directory: the directory can outlive an
  # upgrade, and did, so the test carried on under the old kernel. This is the
  # check omarchy-update-restart makes.
  if ! guest_ssh 'test -f "/usr/lib/modules/$(uname -r)/vmlinuz"' 2>/dev/null; then
    t0=$SECONDS
    # One answer per boot: arm another for this one, past the prompts the log
    # already holds.
    luks_unlock_watch "$(luks_prompts_seen)" &
    HELPER_PIDS+=($!)
    guest_ssh 'sudo -n systemctl reboot' >/dev/null 2>&1 || true
    sleep 20
    wait_for_sshd && for i in $(seq 1 12); do key_login_works && break; sleep 5; done
    key_login_works || t_bail "the guest did not come back after rebooting into the new kernel"
    t_ok "rebooted into the updated kernel ($(t_elapsed $t0))"
  fi

  # The machine this repo was written on had AWS CLI v1 from pacman, and v2
  # cannot be installed over it with --noconfirm. Put v1 in the guest, so the
  # replacement install.sh does is tested rather than assumed.
  if guest_ssh 'sudo -n pacman -S --noconfirm --needed aws-cli' >"$run_dir/aws-v1.log" 2>&1; then
    t_ok "AWS CLI v1 installed in the guest, as a machine upgrading from it would have"
  else
    t_fail "could not install AWS CLI v1 to test the upgrade" "$(t_tail "$run_dir/aws-v1.log")"
  fi

  ( cmd_push ) >"$run_dir/push.log" 2>&1 \
    || { t_tail "$run_dir/push.log"; t_bail "could not push the working tree into the guest"; }
  t_ok "working tree pushed into the guest"

  local repo='~/projects/omarchy-dotfiles' status

  # Your env.yaml, when there is one here and its key with it: copied in, so
  # install.sh generates the real profiles and the cloud checks below switch
  # to the real accounts. The key travels on stdin for each command that
  # needs it and is never written to the guest's disk. OMARCHY_ENV_AGE_KEY
  # supplies it where there is no keyring, as in CI.
  local age_key=""
  if [[ -f $DOTFILES/env.yaml ]]; then
    age_key=${OMARCHY_ENV_AGE_KEY:-$(secret-tool lookup service omarchy-dotfiles key sops-age 2>/dev/null || true)}
    if [[ -n $age_key ]]; then
      local ropts; mapfile -t ropts < <(ssh_opts)
      rsync -a -e "ssh ${ropts[*]}" "$DOTFILES/env.yaml" "$(guest_user)@localhost:projects/omarchy-dotfiles/env.yaml" \
        || t_bail "could not copy env.yaml into the guest"
      t_ok "env.yaml copied into the guest, its key passed per command"
    else
      echo "# env.yaml is here but its key is not -- testing the cloud plumbing only"
    fi
  fi

  # DOTFILES_ATTENDED, so install.sh installs packages as it would for a
  # person at the keyboard -- passwordless sudo stands in for the password --
  # while stdin stays free to carry the key.
  t0=$SECONDS
  # `|| status=$?`, not a bare pipeline: under set -e a failing install.sh
  # would end the test right here instead of being reported as a failure.
  status=0
  guest_keyed "$age_key" "cd $repo && DOTFILES_ATTENDED=1 ./setup/install.sh" 2>&1 | tr -d '\r' >"$run_dir/install-1.log" || status=$?
  if (( status == 0 )); then
    t_ok "install.sh on a fresh machine ($(t_elapsed $t0))"
  else
    t_fail "install.sh on a fresh machine exited $status" "$(t_tail "$run_dir/install-1.log")"
  fi
  local problems_re='^  (CONFLICT|FAILED|no pkg|no font|no icon|replace|old ver|no env|no sync|plain|example) |MISSING payload'
  if grep -qE "$problems_re" "$run_dir/install-1.log"; then
    t_fail "install.sh reported problems" "$(grep -E "$problems_re" -A1 "$run_dir/install-1.log")"
  else
    t_ok "install.sh reported no conflicts, failures or missing pieces"
  fi

  local missing
  missing=$(guest_ssh "cd $repo && source setup/targets.sh && for e in \"\${PACKAGES[@]}\"; do c=\${e%%|*}; command -v \"\$c\" >/dev/null || echo \"\$c\"; done" 2>&1 || echo "(could not ask the guest)")
  if [[ -z $missing ]]; then
    t_ok "every PACKAGES command resolves in the guest"
  else
    t_fail "PACKAGES commands missing after install.sh" "$missing"
  fi

  local aws_state
  aws_state=$(guest_ssh 'aws --version 2>&1 | head -n 1; [ "$(pacman -Qq aws-cli 2>/dev/null)" = aws-cli ] && echo "aws-cli: still installed" || echo "aws-cli: not installed"' 2>&1 || true)
  if grep -q '^aws-cli/2\.' <<<"$aws_state" && grep -q 'aws-cli: not installed' <<<"$aws_state"; then
    t_ok "AWS CLI v1 was replaced by v2"
  else
    t_fail "AWS CLI v1 was not replaced by v2" "$aws_state"
  fi

  # Safe to re-run is the whole contract: a second run must change nothing.
  guest_keyed "$age_key" "cd $repo && DOTFILES_ATTENDED=1 ./setup/install.sh" 2>&1 | tr -d '\r' >"$run_dir/install-2.log" || true
  local changes
  changes=$(grep -E '^  (hooked|linked|seeded|built|added|removed|synced|font|icon|webapp|reloaded) |^Applied ' "$run_dir/install-2.log" || true)
  if [[ -z $changes ]]; then
    t_ok "a second install.sh changes nothing"
  else
    t_fail "a second install.sh still changed things" "$changes"
  fi

  # doctor.sh reports and always exits 0, so read what it says. Mail is left
  # out on purpose: its passwords live in a keyring a test machine never has.
  guest_keyed "$age_key" "cd $repo && ./setup/doctor.sh" 2>&1 | tr -d '\r' >"$run_dir/doctor.log" || true
  local problems
  problems=$(awk '/^== /{ mail = ($0 == "== Mail ==") } !mail && /^  (MISSING|STALE|FOREIGN|BROKEN|BEHIND) |file\(s\) drifted/' "$run_dir/doctor.log")
  if [[ -z $problems ]]; then
    t_ok "doctor.sh finds nothing missing, stale, broken or drifted"
  else
    t_fail "doctor.sh found problems" "$problems"
  fi

  if [[ -n $age_key ]]; then
    test_cloud_accounts "$run_dir" "$repo" "$age_key"
  else
    test_cloud_plumbing "$run_dir" "$repo"
  fi

  # The reason the VM exists: an Omarchy migration `mv`s a fresh file over a
  # hooked one and drops our block; the post-update hook must put it back.
  # Simulated on ~/.bashrc the way a migration would do it.
  if guest_ssh 'f=~/.bashrc; t=$(mktemp); awk "/^# >>> omarchy-dotfiles >>>/{s=1;next} /^# <<< omarchy-dotfiles <<</{s=0;next} !s" "$f" > "$t" && mv "$t" "$f" && ! grep -q "omarchy-dotfiles" "$f" && ~/.config/omarchy/hooks/post-update.d/reapply-dotfiles.hook && grep -q "^# >>> omarchy-dotfiles >>>" "$f"' >"$run_dir/hook.log" 2>&1; then
    t_ok "the post-update hook restores a block a migration clobbered"
  else
    t_fail "the post-update hook did not restore ~/.bashrc's block" "$(t_tail "$run_dir/hook.log")"
  fi

  echo "1..$T_N"
  if (( T_FAILED == 0 )); then
    echo "# all $T_N checks passed in $(t_elapsed 0) -- logs in $run_dir"
    exit 0
  fi
  echo "# $T_FAILED of $T_N checks failed -- logs in $run_dir"
  exit 1
}

# Run a command in the guest with env.yaml's age key on stdin, exported as
# SOPS_AGE_KEY for that command alone. An empty key means none.
guest_keyed() {
  guest_ssh "read -r k; [ -n \"\$k\" ] && export SOPS_AGE_KEY=\"\$k\"; unset k; exec bash -lc $(printf %q "$2")" <<<"$1"
}

# The real accounts: every one in the guest's index, switched to the way you
# would, each its own check -- plus one through an interactive shell, to show
# the shell function really leaves AWS_PROFILE set in the calling terminal.
test_cloud_accounts() {
  local run_dir=$1 repo=$2 key=$3 cloud slug name out first=""
  local index='~/.local/state/omarchy-dotfiles/cloud/profiles.tsv'
  while IFS=$'\t' read -r cloud slug name _; do
    [[ -n $slug ]] || continue
    local cmd=aws-select
    [[ $cloud == azure ]] && cmd=az-select
    [[ $cloud == aws && -z $first ]] && first=$slug
    if out=$(guest_keyed "$key" "~/.local/bin/$cmd --profile $slug --yes" 2>&1); then
      t_ok "$cmd $slug signs in ($name)"
    else
      t_fail "$cmd $slug does not sign in ($name)" "$(tr -d '\r' <<<"$out")"
    fi
  done < <(guest_ssh "cat $index" 2>/dev/null)
  test_add_needs_login "$key"
  test_whoami
  [[ -n $first ]] || return 0
  if out=$(guest_keyed "$key" "bash -ic 'aws-select --profile $first --yes >/dev/null && echo AWS_PROFILE=\$AWS_PROFILE' 2>/dev/null" 2>&1) &&
     grep -qx "AWS_PROFILE=$first" <<<"$(tr -d '\r' <<<"$out")"; then
    t_ok "aws-select leaves AWS_PROFILE=$first in the shell that ran it"
  else
    t_fail "aws-select did not set AWS_PROFILE in the calling shell" "$(tr -d '\r' <<<"$out")"
  fi
  # ... and in no other: a terminal opened after it starts on no account.
  if out=$(guest_ssh "bash -ic 'echo AWS_PROFILE=\${AWS_PROFILE:-none}' 2>/dev/null" 2>&1) &&
     grep -qx "AWS_PROFILE=none" <<<"$(tr -d '\r' <<<"$out")"; then
    t_ok "a new terminal after that starts on no account"
  else
    t_fail "a new terminal started on an account another one picked" "$(tr -d '\r' <<<"$out")"
  fi
}

# No real accounts to hand: the plumbing alone, on env.example.yaml encrypted
# to a key made up for the purpose. Its credentials are placeholders, so a
# switch that works would be the bug -- each must fail cleanly, with a ✗ and
# exit 1, and the production guard must refuse without --yes.
test_cloud_plumbing() {
  local run_dir=$1 repo=$2 key out
  echo "# no env.yaml here -- checking the cloud plumbing on the example, encrypted to a throwaway key"
  if ! key=$(guest_ssh "cd $repo && k=\$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-') && cp env.example.yaml env.yaml && SOPS_AGE_KEY=\$k sops --encrypt --age \$(age-keygen -y <<<\"\$k\") --in-place env.yaml && echo \"\$k\"" 2>"$run_dir/cloud-setup.log"); then
    t_fail "could not encrypt env.example.yaml in the guest" "$(t_tail "$run_dir/cloud-setup.log")"
    return 0
  fi

  if out=$(guest_keyed "$key" "~/.local/bin/env-secrets check" 2>&1); then
    t_ok "env-secrets check passes on the encrypted example"
  else
    t_fail "env-secrets check fails on the encrypted example" "$(tr -d '\r' <<<"$out")"
  fi

  if out=$(guest_keyed "$key" "~/.local/bin/aws-select --list >/dev/null && aws configure list-profiles" 2>&1) &&
     grep -qx acme-prod <<<"$out" && grep -qx acme-staging <<<"$out"; then
    t_ok "the AWS profiles are generated into ~/.aws/config"
  else
    t_fail "~/.aws/config lacks the generated profiles" "$(tr -d '\r' <<<"$out")"
  fi

  if out=$(guest_keyed "$key" "~/.local/bin/aws-select --profile acme-prod </dev/null" 2>&1); then
    t_fail "aws-select switched to a production account without --yes or a terminal"
  elif grep -q 'production account' <<<"$out"; then
    t_ok "the production guard refuses without --yes"
  else
    t_fail "aws-select failed without --yes, but not at the production guard" "$(tr -d '\r' <<<"$out")"
  fi

  if out=$(guest_keyed "$key" "~/.local/bin/aws-select --profile acme-prod --yes" 2>&1); then
    t_fail "aws-select accepted placeholder credentials" "$(tr -d '\r' <<<"$out")"
  elif grep -q '✗' <<<"$out" && grep -qi 'credentials did not work' <<<"$out"; then
    t_ok "aws-select reports bad credentials with ✗ and exit 1"
  else
    t_fail "aws-select failed, but not with a clear ✗" "$(tr -d '\r' <<<"$out")"
  fi

  if out=$(guest_keyed "$key" "~/.local/bin/az-select --profile example-corp --yes" 2>&1); then
    t_fail "az-select accepted a placeholder service principal" "$(tr -d '\r' <<<"$out")"
  elif grep -q '✗' <<<"$out"; then
    t_ok "az-select reports a bad service principal with ✗ and exit 1"
  else
    t_fail "az-select failed, but not with a clear ✗" "$(tr -d '\r' <<<"$out")"
  fi

  test_add_needs_login "$key"
  test_whoami
  guest_ssh "rm -f $repo/env.yaml" 2>/dev/null || true
}

# aws-whoami and az-whoami, in a real interactive shell, where .bashrc's hook
# defines them: none in a new terminal -- even after the switches above, since
# a pick belongs to the terminal that made it -- and the account's name on one
# that picked it. They read only the account list, so no key is needed.
test_whoami() {
  local slug name out
  IFS=$'\t' read -r slug name < <(guest_ssh "grep -m1 '^aws' ~/.local/state/omarchy-dotfiles/cloud/profiles.tsv | cut -f2,3" 2>/dev/null)
  out=$(guest_ssh "bash -ic 'aws-whoami; az-whoami; AWS_PROFILE=$slug aws-whoami' 2>/dev/null" 2>&1 | tr -d '\r')
  if grep -q '^AWS: none selected' <<<"$out" && grep -q '^Azure: none selected' <<<"$out" &&
     [[ -n $name ]] && grep -qF "AWS: $name" <<<"$out"; then
    t_ok "aws-whoami and az-whoami name the account, or say there is none"
  else
    t_fail "aws-whoami and az-whoami did not answer as expected" "$out"
  fi
}

# The guest has no az or aws login of anyone's, so az-add and aws-add must stop
# at that, before they create anything -- having got as far as opening the
# encrypted env.yaml. Safe with the real one too: nothing is written before
# the login is checked.
test_add_needs_login() {
  local key=$1 cmd cli out
  for cmd in az-add aws-add; do
    cli=${cmd%-add}
    if out=$(guest_keyed "$key" "~/.local/bin/$cmd --yes" 2>&1); then
      t_fail "$cmd ran without an $cli login" "$(tr -d '\r' <<<"$out")"
    elif grep -q "$cli login" <<<"$out"; then
      t_ok "$cmd without an $cli login says to run $cli login"
    else
      t_fail "$cmd failed, but not at the missing login" "$(tr -d '\r' <<<"$out")"
    fi
  done
}

# However the test ends, its guest goes away and its disk with it, unless
# --keep asked to leave the machine up to look at. The logs always stay.
test_exit() {
  disarm_helpers
  if [[ $TEST_KEEP == true ]] && guest_running; then
    echo "# --keep: guest left running (pid $(cat "$PIDFILE"), ssh localhost:$SSH_PORT)"
    echo "#   stop it with: OMARCHY_VM_DIR=$VM_DIR $0 stop --force  (or kill $(cat "$PIDFILE"))"
    return 0
  fi
  if guest_running; then
    guest_ssh 'sudo -n systemctl poweroff' >/dev/null 2>&1 || true
    local i
    for i in $(seq 1 60); do guest_running || break; sleep 1; done
    guest_running && { qmp quit >/dev/null 2>&1 || kill -TERM "$(cat "$PIDFILE")" 2>/dev/null || true; }
  fi
  rm -f "$TEST_OVERLAY"
}

cmd_reset() {
  require_host
  [[ -f $BASE ]] || die "no base disk yet -- run '$0 install' first"

  rm -f "$OVERLAY"
  # -b with -F: qcow2 refuses to guess a backing file's format, and a wrong
  # guess here would be a silently corrupt overlay rather than an error.
  qemu-img create -f qcow2 -b "$BASE" -F qcow2 "$OVERLAY" >/dev/null
  note "fresh overlay off $(basename "$BASE") -- $(du -h "$OVERLAY" | cut -f1)"

  # The firmware vars carry the boot entry the install wrote, so they are part
  # of the installed state and must NOT be reset with the disk. Left alone on
  # purpose; `clean all` is what discards them.
}

# Bring the clipboard bridge up on its own, once the guest can answer.
#
# Started alongside the LUKS watcher rather than by hand, because a clipboard
# you have to remember to enable is one you will not have when you want it.
#
# It has to wait: ssh is not answering for the first minute of a boot, and the
# bridge needs wl-clipboard reachable at both ends before it can do anything.
# So this polls, gives up quietly after five minutes, and returns without a
# word if the guest went away in the meantime -- a background helper that
# complains about a machine nobody asked it to watch is worse than no helper.
#
# `exec` on success, so the bridge replaces this waiter and there is one pid to
# signal on the way out rather than a chain of them.
#
# OMARCHY_VM_CLIPBOARD=0 turns it off, for the case where the sync is in the
# way -- copying inside the guest while wanting the host clipboard left alone.
clip_autostart() {
  if [[ ${OMARCHY_VM_CLIPBOARD:-1} == 0 ]]; then
    return 0
  fi
  command -v wl-paste >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1 || return 0

  local i
  for i in $(seq 1 60); do
    sleep 5
    guest_running || return 0
    if guest_ssh 'command -v wl-copy >/dev/null && command -v wl-paste >/dev/null' 2>/dev/null; then
      note "clipboard bridge attached"
      exec "$SELF" clipboard >/dev/null 2>&1
    fi
  done
  return 0
}

# Everything that has to be running beside a booting guest, and the one trap
# that takes it all down again. Shared by run/throwaway/base-shell so they
# cannot drift: a guest booted by one and a guest booted by another should
# behave the same.
arm_helpers() {
  # Armed before qemu starts, since the LUKS prompt arrives seconds into boot.
  luks_unlock_watch &
  HELPER_PIDS+=($!)
  clip_autostart &
  HELPER_PIDS+=($!)

  # TERM, not KILL: the clipboard bridge has its own cleanup to run, which
  # removes the watcher it left in the guest.
  trap disarm_helpers EXIT INT TERM
}

HELPER_PIDS=()
disarm_helpers() {
  local pid
  for pid in "${HELPER_PIDS[@]:-}"; do
    [[ -n $pid ]] || continue
    kill -TERM "$pid" 2>/dev/null || true
  done
}

cmd_run() {
  require_host
  require_no_guest
  [[ -f $OVERLAY ]] || die "no overlay yet -- run '$0 install', or '$0 reset' if the base exists"
  ensure_vars

  arm_helpers

  local args; mapfile -t args < <(qemu_args)
  note "booting overlay (ssh on localhost:$SSH_PORT) -- changes persist until '$0 reset'"
  qemu-system-x86_64 "${args[@]}" \
    -drive "file=$OVERLAY,if=virtio,format=qcow2,cache=writeback,discard=unmap"
}

# Boot the base directly with -snapshot: every write goes to a temp file QEMU
# discards on exit. Nothing to reset afterwards, and the base cannot be
# damaged even by a guest that tries.
cmd_throwaway() {
  require_host
  require_no_guest
  [[ -f $BASE ]] || die "no base disk yet -- run '$0 install' first"
  ensure_vars

  arm_helpers

  local args; mapfile -t args < <(qemu_args)
  note "booting base read-only -- every change is discarded on shutdown"
  qemu-system-x86_64 "${args[@]}" \
    -drive "file=$BASE,if=virtio,format=qcow2,cache=writeback" \
    -snapshot
}

guest_user() {
  if [[ -n ${OMARCHY_VM_USER:-} ]]; then
    printf '%s\n' "$OMARCHY_VM_USER"
  elif [[ -f $GUEST_USER_FILE ]]; then
    < "$GUEST_USER_FILE" tr -d '[:space:]'
  else
    printf '%s\n' "$USER"
  fi
}

cmd_user() {
  [[ -n ${1:-} ]] || die "usage: $0 user <name>   (currently: $(guest_user))"
  mkdir -p "$VM_DIR"
  printf '%s\n' "$1" > "$GUEST_USER_FILE"
  note "guest account set to '$1'"
}

# Shared ssh options. StrictHostKeyChecking is off and known_hosts is
# /dev/null because a reset hands back a machine with the same address and a
# different host key every time -- the warning would be right and useless.
#
# ControlMaster matters more than it looks: without it `push` authenticates
# twice, once for its reachability check and again for rsync, so a
# password-authenticated push asks for the password twice in a row. With it
# the first connection is reused, and a run of pushes costs one prompt.
#
# ControlPersist is 10 minutes rather than seconds because the useful unit of
# work here is a whole session -- push, run install.sh, read doctor.sh, poke at
# what it did -- and a password prompt in the middle of that is friction for no
# security: the socket is mode 0600 in VM_DIR, and the machine on the far end
# is one `reset` away from not existing.
ssh_opts() {
  printf '%s\n' \
    -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    -o ControlMaster=auto \
    -o "ControlPath=$VM_DIR/ssh-%C" \
    -o ControlPersist=600
  ssh_identity_opts
}

# The harness key, when autoinstall made one. As -o rather than -i, because
# ssh_opts also feeds ssh-copy-id, where -i means "the key to install". And
# with the defaults spelled out, because naming any IdentityFile makes ssh
# stop trying its default ones -- which would lock your own key out of a base
# that was set up by hand.
ssh_identity_opts() {
  [[ -f $GUEST_KEY ]] || return 0
  local f
  printf '%s\n' -o "IdentityFile=$GUEST_KEY"
  for f in ~/.ssh/id_ed25519 ~/.ssh/id_ecdsa ~/.ssh/id_rsa; do
    [[ -f $f ]] && printf '%s\n' -o "IdentityFile=$f"
  done
  return 0
}

guest_ssh() {
  local user opts; user=$(guest_user); mapfile -t opts < <(ssh_opts)
  ssh "${opts[@]}" "$user@localhost" "$@"
}

# Install the host's public key in the guest, so ssh and push stop asking for
# a password. Only worth doing against `base-shell`, since anything written to
# an overlay dies at the next reset -- which is why this says so rather than
# quietly succeeding into a machine that is about to be discarded.
cmd_authorize() {
  local user opts; user=$(guest_user); mapfile -t opts < <(ssh_opts)
  guest_running || die "no guest running"
  command -v ssh-copy-id >/dev/null || die "ssh-copy-id not installed"

  if ! tr '\0' '\n' < "/proc/$(cat "$PIDFILE")/cmdline" 2>/dev/null | grep -q "$(basename "$BASE")"; then
    note "WARNING: this guest is running the overlay, not the base."
    note "         An authorized key written here is gone at the next reset."
    note "         Use '$0 base-shell' if you want it to persist."
  fi

  ssh-copy-id "${opts[@]}" "$user@localhost"
  note "key installed; ssh and push should no longer ask for a password"
}



cmd_ssh() { guest_ssh "$@"; }

# Push the working tree, uncommitted changes and all. The point is to test the
# repo as it is right now, not as it was at the last push to GitHub -- a clone
# in the guest can only ever see what has been committed.
cmd_push() {
  local user; user=$(guest_user)
  local dest="/home/$user/projects/omarchy-dotfiles"

  command -v rsync >/dev/null || die "rsync not installed on the host"
  guest_ssh true 2>/dev/null \
    || die "cannot ssh to the guest on port $SSH_PORT
  Is it running ('$0 run'), and was sshd enabled inside it?
    sudo systemctl enable --now sshd"

  note "pushing $DOTFILES -> $user@guest:$dest"
  guest_ssh "mkdir -p $(dirname "$dest")"
  # --delete so a file removed here disappears there too; the guest copy is a
  # mirror of the working tree, not an accumulation of every version of it.
  # .git goes along, because setup/doctor.sh and the hooks are happier in a
  # real checkout, and it costs little.
  # env.yaml stays behind even though it is encrypted: the guest is a machine
  # you hand things to by choice, and `test` copies it in on purpose when it
  # is wanted. --delete leaves the guest's own env.yaml alone for the same
  # reason -- excluded files are protected from deletion too.
  local opts; mapfile -t opts < <(ssh_opts)
  rsync -a --delete --info=stats1 --exclude=/env.yaml \
        -e "ssh ${opts[*]}" \
        "$DOTFILES/" "$user@localhost:$dest/"
  echo
  note "now, in the guest:  cd ${dest/#\/home\/$user/\~} && ./setup/install.sh"
}

# Attach to the guest's serial console. This is the door that stays open when
# the screen is black and sshd was never enabled -- a stock Omarchy runs
# serial-getty@ttyS0, so there is a login prompt waiting on the other side.
#
# Ctrl-] to detach, chosen because socat's raw mode passes Ctrl-C straight
# through to the guest, where it belongs.
cmd_console() {
  guest_running || die "no guest running -- '$0 run' first"
  [[ -S $SERIAL_SOCK ]] || die "no serial socket at $SERIAL_SOCK"
  command -v socat >/dev/null || die "socat not installed (pacman -S socat)"
  echo "==> attaching to the guest serial console; Ctrl-] to detach"
  echo
  socat -,raw,echo=0,escape=0x1d "unix-connect:$SERIAL_SOCK"
  echo
  note "detached"
}

# Everything the guest said this boot, without attaching. Escape sequences
# stripped, because a systemd boot log is more colour codes than text.
cmd_log() {
  [[ -f $SERIAL_LOG ]] || die "no serial log yet"
  sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g; s/\r//g' "$SERIAL_LOG"
}

# ── Clipboard ─────────────────────────────────────────────────────────
#
# Bridged with wl-clipboard on both ends rather than through spice-vdagent,
# which is the conventional answer and a worse fit here. vdagent needs a
# package installed in the guest -- so a base-shell trip, or it dies at the
# next reset -- plus a session agent Hyprland does not autostart, and its
# clipboard support is historically X11-based, which on a wlroots compositor
# means depending on XWayland to bridge selections. wl-clipboard is already
# present on a stock Omarchy at both ends and is native on both.
#
# The qemu-vdagent channel in qemu_args stays regardless: it costs nothing,
# and it leaves the conventional path available to anyone who does install the
# guest package.

# wl-clipboard has to find the compositor, and an ssh shell has neither
# XDG_RUNTIME_DIR nor WAYLAND_DISPLAY -- so `guest_ssh wl-copy` silently did
# nothing at all. Discovered rather than hardcoded: this guest happens to land
# on wayland-1, which is not a promise.
#
# Single-quoted on purpose. The $(...) inside must run in the guest.
GUEST_WL_ENV='export XDG_RUNTIME_DIR=/run/user/$(id -u); export WAYLAND_DISPLAY=$(ls -1 "$XDG_RUNTIME_DIR" | grep -E "^wayland-[0-9]+$" | head -1);'

# True when this content is the echo of something just synced the other way.
#
# Without it the two watchers feed each other forever: a host copy sets the
# guest clipboard, the guest's watcher sees a new selection and sends it back,
# that sets the host clipboard, the host's watcher sees a new selection... One
# hash is enough, because a round trip is the only thing that produces the
# same value twice in a row.
clip_is_echo() {
  local file=$1 h
  h=$(sha256sum < "$file" | cut -d' ' -f1)
  if [[ -f $CLIP_STATE ]] && [[ $(cat "$CLIP_STATE" 2>/dev/null) == "$h" ]]; then
    return 0
  fi
  mkdir -p "$VM_DIR"
  printf '%s\n' "$h" > "$CLIP_STATE"
  return 1
}

# Invoked by `wl-paste --watch` on the host, with the new clipboard on stdin.
# A separate entry point because --watch takes a command, not a shell snippet.
clip_to_guest() {
  local tmp; tmp=$(mktemp)
  cat > "$tmp"
  if ! clip_is_echo "$tmp"; then
    # The content lands in a file in the guest before wl-copy is launched, and
    # wl-copy is detached from the ssh session.
    #
    # Both halves are needed. wl-copy does not exit -- it stays alive to serve
    # the selection it now owns -- so running it in the foreground wedges the
    # ssh channel until something replaces the clipboard. And backgrounding it
    # alone does not work either: ssh tears the channel down when the
    # foreground command returns, so a detached wl-copy reading ssh's stdin
    # gets nothing. Verified both failures before settling on this.
    #
    # A fixed path rather than mktemp, so nothing accumulates. Overwriting it
    # under a live wl-copy is harmless: it has already read the content.
    guest_ssh "$GUEST_WL_ENV"' f="$XDG_RUNTIME_DIR/omarchy-vm-clip"; cat > "$f"; (setsid wl-copy < "$f" >/dev/null 2>&1 &)' \
      < "$tmp" 2>/dev/null || true
  fi
  rm -f "$tmp"
}

# Tidy up after the bridge. At top level, with globals and :- guards, because
# nested inside cmd_clipboard it read that function's locals -- and a trap can
# fire in a context where they are unset, which under `set -u` turned a clean
# shutdown into "host_watch: unbound variable" after the work was already done.
CLIP_HOST_PID=""
CLIP_GUEST_PID=""
CLIP_CLEANED=""
clip_cleanup() {
  # Once only. The trap is on INT and TERM as well as EXIT, and a Ctrl-C fires
  # both -- which printed "clipboard bridge stopped" twice and re-ran the
  # remote pkill for no reason.
  #
  # An `if`, not `[[ -n $CLIP_CLEANED ]] && return 0`: with the flag unset that
  # AND-list evaluates to false, and under `set -e` a failing list as the last
  # thing a trap handler runs takes the handler down with it. The first version
  # of this guard silently skipped the entire cleanup -- same trap the comment
  # at the end of setup/install.sh describes.
  if [[ -n $CLIP_CLEANED ]]; then
    return 0
  fi
  CLIP_CLEANED=1

  kill "${CLIP_HOST_PID:-}" "${CLIP_GUEST_PID:-}" 2>/dev/null || true

  # The guest-side `wl-paste --watch` outlives its ssh channel, so killing the
  # local end is not enough -- without this, every run leaks another watcher
  # into the guest.
  #
  # Matched on the emitter path, NOT on "wl-paste --watch". Omarchy runs two
  # watchers of its own for the shell's clipboard-history plugin
  # (shell/plugins/clipboard/capture.sh, one for text and one for images), and
  # the broader pattern killed those too -- quietly breaking a guest feature on
  # the way out of a command whose whole job at that point is to tidy up.
  guest_ssh "pkill -f omarchy-vm-clip-emit >/dev/null 2>&1" 2>/dev/null || true
  note "clipboard bridge stopped"
}

cmd_clipboard() {
  local tmp
  guest_running || die "no guest running"
  command -v wl-paste >/dev/null && command -v wl-copy >/dev/null \
    || die "wl-clipboard is not installed on the host"
  guest_ssh 'command -v wl-copy >/dev/null && command -v wl-paste >/dev/null' 2>/dev/null \
    || die "cannot reach the guest over ssh, or wl-clipboard is missing there"

  # Start clean: a hash left over from a previous run would swallow the first
  # copy of this one.
  rm -f "$CLIP_STATE"
  note "clipboard bridged both ways -- Ctrl-C to stop"

  wl-paste --watch "$SELF" _clip-to-guest &
  CLIP_HOST_PID=$!

  # NUL-terminated, so the reader can tell one value from the next.
  # `wl-paste --watch cat` alone concatenates them into a stream nothing can
  # split again.
  #
  # The emitter is a file in the guest rather than an inline `sh -c`, because
  # inline lost the escaping: the command crosses ssh's login shell and then
  # the inner sh, and `printf \\000` arrived as `printf 000` -- which
  # dutifully wrote the three characters 0, 0, 0 between values instead of a
  # NUL byte, so the reader below blocked forever waiting for a delimiter that
  # never came. A file has no quoting to get wrong.
  guest_ssh "$GUEST_WL_ENV"' cat > "$XDG_RUNTIME_DIR/omarchy-vm-clip-emit"; chmod +x "$XDG_RUNTIME_DIR/omarchy-vm-clip-emit"' <<'EMITTER' 2>/dev/null || die "could not install the clipboard emitter in the guest"
#!/bin/sh
# Print one clipboard value, NUL-terminated. Called by wl-paste --watch.
cat
printf '\000'
EMITTER

  guest_ssh "$GUEST_WL_ENV"' wl-paste --watch "$XDG_RUNTIME_DIR/omarchy-vm-clip-emit"' 2>/dev/null |
    while IFS= read -r -d '' value; do
      tmp=$(mktemp)
      printf '%s' "$value" > "$tmp"
      clip_is_echo "$tmp" || wl-copy < "$tmp"
      rm -f "$tmp"
    done &
  CLIP_GUEST_PID=$!

  trap clip_cleanup EXIT INT TERM
  wait
}

cmd_status() {
  echo "iso version   $ISO_VERSION"
  echo "vm dir        $VM_DIR"
  local f
  for f in "$ISO" "$BASE" "$OVERLAY" "$VARS"; do
    if [[ -f $f ]]; then
      printf '  %-14s %s\n' "$(basename "$f")" "$(du -h "$f" | cut -f1)"
    else
      printf '  %-14s -\n' "$(basename "$f")"
    fi
  done
  echo
  if command -v qemu-system-x86_64 >/dev/null; then
    echo "qemu          $(qemu-system-x86_64 --version | head -1)"
  else
    echo "qemu          not installed"
  fi
  echo "ovmf          $(ovmf_code 2>/dev/null || echo 'not found')"
  echo "kvm           $([[ -w /dev/kvm ]] && echo writable || echo 'NOT writable')"
  if guest_running; then
    echo "guest         running, pid $(cat "$PIDFILE") (ssh localhost:$SSH_PORT)"
  else
    echo "guest         not running"
  fi
  echo "display       $DISPLAY_SPEC"
  echo "guest user    $(guest_user)"
  if [[ ${OMARCHY_VM_CLIPBOARD:-1} == 0 ]]; then
    echo "clipboard     disabled (OMARCHY_VM_CLIPBOARD=0)"
  elif pgrep -f "$SELF clipboard" >/dev/null 2>&1; then
    echo "clipboard     bridged"
  else
    echo "clipboard     armed on boot ('$0 clipboard' to attach to a running guest)"
  fi
  if [[ -f $LUKS_PASS_FILE ]]; then
    echo "luks          passphrase stored, boots self-unlock"
  else
    echo "luks          no passphrase stored ('$0 luks-set' if the disk is encrypted)"
  fi
}

cmd_clean() {
  case ${1:-} in
    overlay) rm -f "$OVERLAY"; note "overlay removed -- '$0 reset' cuts a new one" ;;
    base)    rm -f "$BASE" "$OVERLAY" "$VARS"; note "base, overlay and firmware vars removed (ISO kept)" ;;
    iso)     rm -f "$ISO" "$ISO.verified"; note "ISO and its checksum stamp removed" ;;
    all)     rm -rf "$VM_DIR"; note "$VM_DIR removed" ;;
    *)       die "clean what? one of: overlay, base, iso, all" ;;
  esac
}

usage() {
  cat <<EOF
omarchy-vm -- a disposable Omarchy for testing this repo from nothing

  iso                 download the pinned Omarchy ISO ($ISO_VERSION), resumable
  install             create the base disk and boot the installer (once, slow)
  autoinstall         create the base disk with nobody at the keyboard (cidata)
  test [--keep]       the whole thing unattended: ISO, base, fresh machine, update,
                      install.sh twice, doctor.sh, hook repair -- TAP, exit 0/1/2
  reset               discard the overlay, cut a fresh one off the base (instant)
  base-shell          boot the BASE read-write, to change what every reset gives you
  prep-base [--yes]   put your ssh key and passwordless sudo in the base (once)
  run                 boot the overlay; changes persist until the next reset
  throwaway           boot the base read-only; changes discarded on shutdown
  push                rsync this working tree into the guest over ssh
  ssh [cmd...]        ssh into the guest
  luks-set            store the base disk's LUKS passphrase, so boots self-unlock
  unlock              answer an unlock prompt a running guest is already waiting on
  clipboard           bridge the host and guest clipboards both ways
                      (run/throwaway/base-shell start this for you)
  console             attach to the guest serial console (Ctrl-] detaches)
  log                 print this boot's serial output, escape codes stripped
  screenshot [path]   capture the GUEST framebuffer via QMP (not the host screen)
  stop [--force]      shut the guest down over ssh; --force pulls the plug
  user <name>         remember the guest's account name, used by ssh and push
  authorize           install your ssh key in the guest (do it in base-shell)
  status              what exists, and whether the host can run any of it
  clean <what>        overlay | base | iso | all

Typical loop:

  ./vm/omarchy-vm install          # once
  ./vm/omarchy-vm reset            # fresh machine, instant
  ./vm/omarchy-vm run &            # boot it
  ./vm/omarchy-vm push             # this working tree, uncommitted and all
  ./vm/omarchy-vm ssh              # then: cd projects/omarchy-dotfiles && ./setup/install.sh

Overrides: OMARCHY_VM_MEM=$MEM OMARCHY_VM_CPUS=$CPUS OMARCHY_VM_DISK=$DISK_SIZE
           OMARCHY_VM_SSH_PORT=$SSH_PORT OMARCHY_VM_USER=\$USER
           OMARCHY_ISO_VERSION=$ISO_VERSION OMARCHY_VM_DIR=...
           OMARCHY_VM_CLIPBOARD=0 to stop boots bridging the clipboard
EOF
}

case ${1:-} in
  iso)       shift; cmd_iso "$@" ;;
  install)   shift; cmd_install "$@" ;;
  autoinstall) shift; cmd_autoinstall "$@" ;;
  test)      shift; cmd_test "$@" ;;
  reset)     shift; cmd_reset "$@" ;;
  base-shell) shift; cmd_base_shell "$@" ;;
  prep-base) shift; cmd_prep_base "$@" ;;
  run)       shift; cmd_run "$@" ;;
  throwaway) shift; cmd_throwaway "$@" ;;
  push)      shift; cmd_push "$@" ;;
  ssh)       shift; cmd_ssh "$@" ;;
  console)   shift; cmd_console "$@" ;;
  luks-set)  shift; cmd_luks_set "$@" ;;
  unlock)    shift; cmd_unlock "$@" ;;
  log)       shift; cmd_log "$@" ;;
  screenshot) shift; cmd_screenshot "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  user)      shift; cmd_user "$@" ;;
  clipboard) shift; cmd_clipboard "$@" ;;
  # Internal: the handler `wl-paste --watch` calls, not for humans.
  _clip-to-guest) shift; clip_to_guest "$@" ;;
  authorize) shift; cmd_authorize "$@" ;;
  status)    shift; cmd_status "$@" ;;
  clean)     shift; cmd_clean "$@" ;;
  ""|-h|--help|help) usage ;;
  *)         usage; exit 1 ;;
esac
