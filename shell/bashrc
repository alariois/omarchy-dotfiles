# Personal bash configuration.
#
# Sourced from ~/.bashrc by a managed block that setup/install.sh maintains.
# Omarchy owns ~/.bashrc itself; everything of ours lives here so that an
# `omarchy update` can never overwrite more than the one-line hook.

# Vi keybindings at the prompt.
set -o vi

# The standalone config in nvim-chad/, linked to ~/.config/nvim-chad. Plain
# `nvim` stays on Omarchy's LazyVim.
alias nv="NVIM_APPNAME='nvim-chad' nvim"

# Pre-typed command line, for the terminals bin/term-here opens.
#
# SUPER+RETURN over a file manager with a file selected should come up with
# ` ./env.yaml` already on the prompt and the cursor at the start of the line,
# so the command goes in front of it. bash takes no argument for that: the only
# way to set the line is READLINE_LINE, and the only way to reach READLINE_LINE
# is from inside a `bind -x` command -- which means a key has to be pressed.
#
# So we have the terminal press it. `\e[5n` is a status request (DSR); the
# terminal answers `\e[0n` on this shell's *input*, exactly as if it had been
# typed, and readline dispatches it like any other key sequence.
#
# The reply lands in the gap between here and the first prompt, while the tty
# is still echoing, so it arrives on screen as a literal `^[[0n` -- and that is
# what `\e7` here and `\e8\e[J` in the handler are for: save the cursor before
# asking, then put it back and erase forward, which wipes the echo and the
# prompt readline drew under it and leaves anything printed *above* alone. The
# redisplay after the handler then draws the prompt where it should have been.
# Only the reply that beats readline needs this; once readline is running, echo
# is off and a later reply would not show at all.
#
# Bound in vi-insert because `set -o vi` above puts readline there for a fresh
# line, and in emacs so this does not quietly stop working if that ever goes.
# READLINE_POINT=0 is the cursor-at-the-start half; the leading space in the
# line is bin/term-here's, and is what the cursor lands on. Vi insert mode is
# already where a new line starts, so nothing has to switch modes.
#
# The binding removes itself once it has fired. Leaving it would mean any later
# program that asks this terminal for its status gets its reply turned into an
# overwritten command line.
if [[ -n ${TERM_HERE_LINE-} ]]; then
  __term_here_prefill() {
    printf '\e8\e[J'
    READLINE_LINE=$TERM_HERE_LINE
    READLINE_POINT=0
    local keymap
    for keymap in vi-insert emacs; do
      bind -m "$keymap" -r '"\e[0n"' 2>/dev/null
    done
    unset -v TERM_HERE_LINE
  }

  for __term_here_keymap in vi-insert emacs; do
    bind -m "$__term_here_keymap" -x '"\e[0n": __term_here_prefill'
  done
  unset -v __term_here_keymap

  printf '\e7\e[5n'
fi

# Cloud accounts: aws-select and az-select (bin/) switch THIS terminal to an
# account from env.yaml, and only this one: every other terminal keeps its
# own, and a new one starts on no account. aws-whoami and az-whoami say which
# one a terminal is on; the prompt does not.
#
# A script cannot change its parent shell's environment, so each is wrapped in
# a function. It gives the script a file of its own to write the account it
# picked to, and exports that here: AWS_PROFILE for AWS, AZURE_CONFIG_DIR --
# one directory per account, each with its own login -- for Azure.
__cloud_state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-dotfiles/cloud

# sops reads env.yaml's age key from the keyring through this; see lib/env.sh.
[[ -n ${SOPS_AGE_KEY-}${SOPS_AGE_KEY_CMD-} ]] ||
  export SOPS_AGE_KEY_CMD="secret-tool lookup service omarchy-dotfiles key sops-age"

# What the script writes (lib/cloud.sh, cloud_hand_over): the account's line
# in the index, "-" after --clear, or nothing at all for --list, --current
# and the rest, which change nothing.
__cloud_run() {
  local cmd=$1 pick line slug rc=0
  shift
  pick=$(mktemp) || return 1
  CLOUD_PICK=$pick command "$cmd" "$@" || rc=$?
  line=$(<"$pick")
  rm -f -- "$pick"
  (( rc == 0 )) || return "$rc"
  [[ -n $line ]] || return 0
  IFS=$'\t' read -r _ slug _ <<<"$line"
  case $cmd:$line in
    aws-select:-) unset AWS_PROFILE ;;
    aws-select:*) export AWS_PROFILE=$slug ;;
    az-select:-)  unset AZURE_CONFIG_DIR ;;
    az-select:*)  export AZURE_CONFIG_DIR=$__cloud_state/azure/$slug ;;
  esac
}
aws-select() { __cloud_run aws-select "$@"; }
az-select()  { __cloud_run az-select "$@"; }

# Which account this terminal is on: the variable the switch set, looked up in
# the account list the scripts keep for its name and details. Nothing is
# decrypted and nothing asks the cloud, so it answers at once -- whether the
# account still signs in is for aws-select and az-select to prove.
__cloud_whoami() {
  local cloud=$1 label=$2 slug=$3 line name prod d1 d2 tag=""
  line=$(awk -F'\t' -v c="$cloud" -v s="$slug" '$1 == c && $2 == s' "$__cloud_state/profiles.tsv" 2>/dev/null)
  if [[ -z $line ]]; then
    echo "$label: $slug -- not an account in env.yaml"
    return 0
  fi
  IFS=$'\t' read -r _ _ name prod d1 d2 <<<"$line"
  if [[ $prod == true ]]; then
    tag=" PROD"
    [[ -t 1 ]] && tag=$' \e[1;41;97m PROD \e[0m'
  fi
  case $cloud in
    aws)   echo "$label: $name$tag -- account $d1, $d2" ;;
    azure) echo "$label: $name$tag -- subscription $d1, tenant $d2" ;;
  esac
}
aws-whoami() {
  if [[ -z ${AWS_PROFILE-} ]]; then
    echo "AWS: none selected in this terminal -- aws uses its default profile"
  else
    __cloud_whoami aws AWS "$AWS_PROFILE"
  fi
}
az-whoami() {
  if [[ -z ${AZURE_CONFIG_DIR-} ]]; then
    echo "Azure: none selected in this terminal -- az uses your own az login"
  elif [[ $AZURE_CONFIG_DIR != "$__cloud_state/azure/"* ]]; then
    echo "Azure: AZURE_CONFIG_DIR is $AZURE_CONFIG_DIR -- not an account in env.yaml"
  else
    __cloud_whoami azure Azure "${AZURE_CONFIG_DIR#"$__cloud_state/azure/"}"
  fi
}

# Tab completion: options, and after --profile the profile names, read from
# the index the scripts keep -- which holds no secrets, so completing never
# decrypts env.yaml.
__cloud_complete() {
  local cloud=$1 cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
  if [[ $prev == --profile ]]; then
    mapfile -t COMPREPLY < <(compgen -W "$(awk -F'\t' -v c="$cloud" '$1 == c { print $2 }' \
      "$__cloud_state/profiles.tsv" 2>/dev/null)" -- "$cur")
  else
    mapfile -t COMPREPLY < <(compgen -W "--profile --yes --console --current --list --clear --help" -- "$cur")
  fi
}
__cloud_complete_aws() { __cloud_complete aws; }
__cloud_complete_az()  { __cloud_complete azure; }
complete -F __cloud_complete_aws aws-select
complete -F __cloud_complete_az az-select

# Bitwarden: bwu unlocks every account in this terminal -- each master password
# the first time, and after that a fingerprint, through sudo, for each terminal
# (bin/bw-session). `bwu get` picks an item with fzf from an encrypted cache of
# every account's vault and prints or copies its secret; `bwu put -f` replaces
# an item's attached file and `bwu add -f` attaches new ones; `bwu move` moves
# an item, or a whole collection, to another account (bin/bw-move); `bwu
# update` syncs and caches the vaults anew (bin/bw-vault; bwu --help); `bwu
# login` adds an account. The session keys and the cache's key are a plain
# shell variable, never exported: these functions hand it to bw-vault and
# bw-move, and the one key to bw, for their run alone, so no other program run
# here inherits them. `bwu lock` locks every account for every terminal, `bw
# lock` the one in bw's own directory, and either deletes the cache.
bwu() {
  local update=false sub
  if [[ ${1-} == --update ]]; then
    update=true
    shift
  fi
  sub=${1-}
  case $sub in
    "")
      if $update; then __bwu_run bw-vault update; else __bwu_unlock; fi ;;
    get|put|add|update|move)
      shift
      # Help needs no vault.
      if [[ " $* " == *" -h "* || " $* " == *" --help "* ]]; then
        if [[ $sub == move ]]; then command bw-move --help; else command bw-vault "$sub" --help; fi
        return
      fi
      if $update && [[ $sub != update ]]; then
        set -- --update "$@"
      fi
      if [[ $sub == move ]]; then __bwu_run bw-move "$@"; else __bwu_run bw-vault "$sub" "$@"; fi ;;
    login)
      shift
      command bw-vault login "$@" || return
      # The next bwu unlocks the new account too.
      unset __bw_keys ;;
    lock)
      command bw-vault lock
      unset __bw_keys ;;
    -h|--help)
      command bw-vault --help ;;
    *)
      echo "bwu: unknown command '$sub' -- bwu, bwu get, put, add, move, update, login or lock (bwu --help)" >&2
      return 2 ;;
  esac
}
__bwu_unlock() {
  local out line names=""
  if [[ -n ${__bw_keys-} ]] && BW_KEYS=$__bw_keys command bw-vault check; then
    echo "Bitwarden: already unlocked in this terminal" >&2
    return 0
  fi
  out=$(command bw-session) || return 1
  __bw_keys=$out
  # The first line is the cache's key; each after it an account's name and key.
  while IFS= read -r line; do
    names+="${names:+, }${line%% *}"
  done <<<"${out#*$'\n'}"
  echo "Bitwarden: $names unlocked in this terminal" >&2
}
__bwu_run() {
  local rc=0
  [[ -n ${__bw_keys-} ]] || __bwu_unlock || return
  BW_KEYS=$__bw_keys command "$@" || rc=$?
  # 3: a key stopped working -- an account was locked, or unlocked somewhere
  # else since. Unlock again, and try once more.
  if (( rc == 3 )); then
    unset __bw_keys
    __bwu_unlock || return
    rc=0
    BW_KEYS=$__bw_keys command "$@" || rc=$?
  fi
  return "$rc"
}
# Tab for bwu: the commands, then each one's options, the accounts' names
# after -a, --from and --to, and after -f what goes there -- the vaults' file
# names for get -f's first name and put -f's second, from the cache (bw-vault
# files; nothing until bwu has unlocked this terminal), and files here for the
# rest: what put and add upload, and where get saves.
__bwu_complete() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} sub="" word name i after=-1 ended=false
  COMPREPLY=()
  # The command, and how many names already follow -f: that count says which
  # of -f's names the word under the cursor is.
  for (( i = 1; i < COMP_CWORD; i++ )); do
    word=${COMP_WORDS[i]}
    if [[ -z $sub ]]; then
      [[ $word == --update ]] || sub=$word
    elif (( after >= 0 )); then
      if ! $ended && [[ $word == -- ]]; then ended=true; else (( after++ )); fi
    elif [[ $word == -f || $word == --file ]]; then
      after=0
    fi
  done
  if [[ -z $sub ]]; then
    mapfile -t COMPREPLY < <(compgen -W 'get put add move update login lock --update --help' -- "$cur")
    return
  fi
  if (( after < 0 )); then
    case $prev in
      -a|--account|--from|--to)
        mapfile -t COMPREPLY < <(compgen -W "$(command bw-vault accounts 2>/dev/null)" -- "$cur")
        return ;;
    esac
    case $sub in
      get)  word='-a --account -f --file -u --username -p --password -c --copy --force --update --help' ;;
      put)  word='-a --account -f --file --update --help' ;;
      add)  word='-a --account -f --file --force --update --help' ;;
      move) word='--to --from --collection -y --yes --update --help' ;;
      *)    return ;;
    esac
    mapfile -t COMPREPLY < <(compgen -W "$word" -- "$cur")
    return
  fi
  case $sub:$after in
    get:0|put:1)
      while IFS= read -r name; do
        [[ $name == "$cur"* ]] && COMPREPLY+=("$(printf '%q' "$name")")
      done < <(BW_KEYS=${__bw_keys-} command bw-vault files 2>/dev/null) ;;
    get:1|put:0|add:*)
      # Nothing in COMPREPLY, and readline completes the file names itself.
      compopt -o default ;;
  esac
}
complete -F __bwu_complete bwu
# bw itself, unlocked as the account that lives in bw's own data directory
# (lib/bw.sh), when this terminal has its key.
bw() {
  local rc=0 name line key="" own=${XDG_CONFIG_HOME:-$HOME/.config}/"Bitwarden CLI"
  local accounts=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-dotfiles/bw-accounts
  if [[ -n ${__bw_keys-} && -z ${BITWARDENCLI_APPDATA_DIR-} ]]; then
    while read -r name line; do
      [[ ! $accounts/$name -ef $own ]] || key=$line
    done <<<"${__bw_keys#*$'\n'}"
  fi
  if [[ -n $key ]]; then
    BW_SESSION=$key command bw "$@" || rc=$?
  else
    command bw "$@" || rc=$?
  fi
  # The account's key is worthless after either, and the cache goes with it;
  # the next bwu fetches the others' keys again.
  if [[ ${1-} == lock || ${1-} == logout ]]; then
    unset __bw_keys
    command bw-vault forget
  fi
  return "$rc"
}
